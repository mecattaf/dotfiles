# U-D19 DF-SWITCH (dotfiles#322) — the pre-switch baseline, captured on the
# coordinator BEFORE `sudo nixos-rebuild switch --flake .#coordinator` was ever
# run for this unit, and committed so the mechanical evaluator's re-run compares
# against the same numbers this author did.
#
# The card's clause is "llama-swap.service still active and never restarted
# (systemctl show -p ActiveEnterTimestamp unchanged)". A baseline the oracle
# captured at its own start would be worthless — it would be captured AFTER any
# restart the previous run caused. So it is a FILE, written once, read by
# tools/u-d19-switch-oracle.sh clause F, and never rewritten by it.
#
# Captured 2026-09-07T02:55:14Z on coordinator, at dotfiles main bc105180,
# generation 188 (system-188-link), by the U-D19 implementer.
#
# The manifest's own runtime row records the same instant independently:
# "llama-swap.service ActiveEnterTimestamp Sat 2026-09-05 10:50:00 CEST (must be
# unchanged after)" — ~/sept7/plan/UNITS-2026-09-06.json, U-D19.runtime.baseline.
U_D19_LLAMA_SWAP_ACTIVE_ENTER='Sat 2026-09-05 10:50:00 CEST'
U_D19_LLAMA_SWAP_MAIN_PID='4003635'
U_D19_LLAMA_SWAP_NRESTARTS='0'
# The generation the switch started from, and the repo commit it was taken at.
U_D19_BEFORE_GENERATION='/nix/store/bac6sd11k29zpqy24mb1mgqhi64w4a1m-nixos-system-coordinator-26.11.20260723.e2587ca'
U_D19_BEFORE_PROFILE='system-188-link'
U_D19_BEFORE_HEAD='bc1051804f32a274f6e962dac1d43c90fd93babf'
# The pre-switch state of the three units the switch installs, so "it was already
# like that" is not available as an explanation afterwards.
U_D19_BEFORE_TALLY_KERNEL='inactive'
U_D19_BEFORE_TALLY_UPLINK='inactive'
U_D19_BEFORE_LEDGER_BYTES='absent'
# D-B98: one user unit was ALREADY failed before this switch — util-row.service
# (UTIL-01, dotfiles#329), failed at 00:05 CEST on its own closed-day idempotence
# guard. It is not this suite's, it writes branch (a)'s state dir which this run
# never touches, and `reset-failed` would only clear the evidence. The oracle's
# clause on --failed is therefore "the switch ADDED no failed unit", measured
# against this name.
U_D19_BEFORE_USER_FAILED='util-row.service'
U_D19_BEFORE_SYSTEM_FAILED=''
