# vim: ft=swayconfig
# Managed as a raw Home Manager out-of-store symlink (~/.config/scroll ->
# ~/mecattaf/dotfiles/home/dot_config/scroll), like niri/ before it. Edit here,
# then `scrollmsg reload` (reload validates first and keeps the old config on
# a parse failure, but it resets inputs and modesets: never loop it).
#
# The niri truth kernel (home/dot_config/niri/*.kdl) ported to scroll master,
# 2026-10-01, branch scroll/transition. Plain config + IPC; no Lua anywhere in
# core (Tom's rule). Bind-by-bind map: notes4/scroll-transition.md and the
# scoping note notes2/scroll-port-nix.md §3.
#
# INCLUDE ORDER IS A DECISION. scroll's `include` expands ~ and globs and
# silently skips a missing file (sway/config.c), so every slot below is
# empty-safe. A later bindsym overrides an earlier one, so:
#   1. /etc/scroll/config.d/*      system session plumbing (modules/scroll.nix):
#                                  SCROLLSOCK-only env export, scroll-session.target
#   2. input, layout, misc         settings
#   3. cubs.d/*.conf               CUBS shell modules' generated fragments
#                                  (plugins: binds -> `nop cubs <verb>`, rules,
#                                  colours). BEFORE binds.conf so Tom's
#                                  hand-written binds win (scoping D5).
#   4. binds, rules, startup       the hand-written truth kernel
#   5. ~/.config/scroll-local.conf per-host slot generated by home/home.nix
#                                  (client: touch per device, lid, F10, XF86)
#   6. ~/.config/theme/scroll.conf client.* colours, LAST (home/theme.nix)

include /etc/scroll/config.d/*

include ~/.config/scroll/input.conf
include ~/.config/scroll/layout.conf
include ~/.config/scroll/misc.conf

include ~/.config/scroll/cubs.d/*.conf

include ~/.config/scroll/binds.conf
include ~/.config/scroll/rules.conf
include ~/.config/scroll/startup.conf

include ~/.config/scroll-local.conf
include ~/.config/theme/scroll.conf
