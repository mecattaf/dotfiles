# Two independent physical seats. Keep the Zenbook profiles unchanged.
# Coordinator: two upright LG 5K displays, side by side, 2x scaling.
# Connector assignments retain the previously proven desktop wiring. One-output
# fallbacks keep the first boot usable while either cable is disconnected.
profile Desktop {
    output DP-4 mode 5120x2880@60Hz scale 2 position 0,0 transform normal
    output DP-1 mode 5120x2880@60Hz scale 2 position 2560,0 transform normal
    exec busctl --user set-property rs.wl-gammarelay /outputs/DP_4 rs.wl.gammarelay Temperature q 4000
    exec busctl --user set-property rs.wl-gammarelay /outputs/DP_1 rs.wl.gammarelay Temperature q 4000
}

profile DesktopLeft {
    output DP-4 mode 5120x2880@60Hz scale 2 position 0,0 transform normal
}

profile DesktopRight {
    output DP-1 mode 5120x2880@60Hz scale 2 position 0,0 transform normal
}

profile Duo {
    output eDP-1 scale 2 position 0,0   adaptive_sync on
    output eDP-2 scale 2 position 0,900 adaptive_sync on
    exec busctl --user set-property rs.wl-gammarelay /outputs/eDP_1 rs.wl.gammarelay Temperature q 3850
    exec busctl --user set-property rs.wl-gammarelay /outputs/eDP_2 rs.wl.gammarelay Temperature q 3350
}

profile DuoDocked {
    output eDP-1 scale 2 position 0,0 adaptive_sync on
    exec busctl --user set-property rs.wl-gammarelay /outputs/eDP_1 rs.wl.gammarelay Temperature q 3850
}
