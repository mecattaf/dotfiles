# kanshi — output geometry. Every profile below is the CLIENT's (the ASUS
# Zenbook Duo UX8406MA, the fleet's only seat since 2026-09-11). The file is a
# fleet-wide raw symlink (home/home.nix configDirs), so it is deployed
# everywhere, but no other host matches a profile in it and none is wanted:
# the coordinator goes headless right after the seat is proven, and giving its
# single DP-1 a profile would move live geometry for the few hours before the
# flip deletes it again. Until then niri's own defaults govern DP-1 there.
#
# ORDER MATTERS. kanshi applies the FIRST profile whose output set matches the
# connected set exactly (kanshi(5); head count and criteria both have to
# agree), so the profiles run most-specific first: dock+both panels, then
# dock+one panel, then both panels, then one panel.
#
# The two axes are INDEPENDENT, which is why there are four:
#
#   • the keyboard. modules/zenbook-duo-daemon.nix forces eDP-2's DRM status to
#     `off` when the physical keyboard is snapped over the bottom panel, and
#     back `on` when it is lifted. kanshi sees a real hotplug either way, so
#     "…Docked" here means KEYBOARD-docked — one eDP — not dock-station-docked.
#   • the Thunderbolt dock, which carries the ASUS PA27JCV 5K panel (moved off
#     the coordinator's DP-1 on 2026-09-11; the fleet's second PA27JCV is
#     retired with the dual-5K desktop, plan R-4).
#
# Outputs are matched by CONNECTOR name for the built-in panels (stable: the
# Duo's own eDP-1/eDP-2) and by DESCRIPTION for the external one, because the
# connector the dock presents it on is not known until the dock is first
# plugged in (plan Q-3/Q-14, step 7).

profile DuoDock {
    output eDP-1 scale 2 position 0,0   adaptive_sync on
    output eDP-2 scale 2 position 0,900 adaptive_sync on
    # No `mode` clause on purpose: whether this dock drives the PA27JCV at
    # 5120x2880@60 is UNPROVEN (plan Q-3 — the Duo's port, its DP version and
    # the dock's own output are all unmeasured). A wrong mode makes the whole
    # profile fail to apply; the preferred mode always applies. Add
    # `mode 5120x2880@60.000Hz` here once step 7 measures it.
    output "ASUSTek COMPUTER INC PA27JCV T4LMSB008958" scale 2 position 0,1800
    exec busctl --user set-property rs.wl-gammarelay /outputs/eDP_1 rs.wl.gammarelay Temperature q 3850
    exec busctl --user set-property rs.wl-gammarelay /outputs/eDP_2 rs.wl.gammarelay Temperature q 3350
    # No gammarelay exec for the PA27JCV: wl-gammarelay-rs addresses outputs by
    # CONNECTOR path (/outputs/DP_1 and friends), and the dock's connector name
    # is unknown. Add the line, not a guess, after step 7.
}

profile DuoDockDocked {
    output eDP-1 scale 2 position 0,0 adaptive_sync on
    output "ASUSTek COMPUTER INC PA27JCV T4LMSB008958" scale 2 position 0,1800
    exec busctl --user set-property rs.wl-gammarelay /outputs/eDP_1 rs.wl.gammarelay Temperature q 3850
}

profile Duo {
    output eDP-1 scale 2 position 0,0   adaptive_sync on
    output eDP-2 scale 2 position 0,900 adaptive_sync on
    exec busctl --user set-property rs.wl-gammarelay /outputs/eDP_1 rs.wl.gammarelay Temperature q 3850
    exec busctl --user set-property rs.wl-gammarelay /outputs/eDP_2 rs.wl.gammarelay Temperature q 3350
}

profile DuoDocked {
    output eDP-1 scale 2 position 0,0 adaptive_sync on
    exec busctl --user set-property rs.wl-gammarelay /outputs/eDP_1 rs.wl.gammarelay Temperature q 3850
}
