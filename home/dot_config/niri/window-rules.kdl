// Managed as a raw Home Manager out-of-store symlink so niri can hot-reload it.

// Global rounded corners
window-rule {
    geometry-corner-radius 4
    clip-to-geometry true
}

// scroll: for_window [app_id="^chrome-.*"] shortcuts_inhibitor disable
// ^ NO NIRI EQUIVALENT: use Mod+Escape to toggle keyboard-shortcuts-inhibit

// scroll: for_window [app_id="io.bassi.Amberol"] border pixel 0, floating enable
window-rule {
    match app-id="io.bassi.Amberol"
    open-floating true
}

// F10 sleep-monitors prompt: small floating kitty popup, focused on open.
// Spawned by niri/binds.kdl F10 binding running niri/scripts/sleep-monitors.
// Orange border = starship's local ❯ color (#DA7756).
window-rule {
    match app-id="sleep-monitors-prompt"
    open-floating true
    open-focused true
    default-column-width { fixed 640; }
    default-window-height { fixed 200; }
    border {
        width 2
        active-color "#DA7756"
        inactive-color "#DA7756"
    }
}

// Shift+F9 paired output/input picker: the same compact floating prompt as F10.
window-rule {
    match app-id="audio-route-prompt"
    open-floating true
    open-focused true
    default-column-width { fixed 640; }
    default-window-height { fixed 200; }
    border {
        width 2
        active-color "#DA7756"
        inactive-color "#DA7756"
    }
}

// Shift+F10 call recorder: the same compact floating prompt as F10.
window-rule {
    match app-id="call-record-prompt"
    open-floating true
    open-focused true
    default-column-width { fixed 640; }
    default-window-height { fixed 200; }
    border {
        width 2
        active-color "#DA7756"
        inactive-color "#DA7756"
    }
}

// ── fzf-in-kitty picker tier (2026-09-11) ───────────────────────────────────
// The launcher/clipboard/emoji tier used to be three separate popup programs,
// none of which were installed on any host. Their two floating rules sat in this
// slot and are deleted, not commented out. The replacements are all the same
// shape as the sleep-monitors prompt above: a `kitty --class <name>-prompt`
// running an fzf script from ~/.local/bin, floated here at a size that suits the
// list, in the same #DA7756 border.

// Mod+D launcher: the widest of the three — .desktop names plus their Exec line.
window-rule {
    match app-id="launcher-prompt"
    open-floating true
    open-focused true
    default-column-width { fixed 800; }
    default-window-height { fixed 500; }
    border {
        width 2
        active-color "#DA7756"
        inactive-color "#DA7756"
    }
}

// Mod+V cliphist history: taller than the F-key prompts, it is a scroll-back.
window-rule {
    match app-id="clipboard-prompt"
    open-floating true
    open-focused true
    default-column-width { fixed 640; }
    default-window-height { fixed 400; }
    border {
        width 2
        active-color "#DA7756"
        inactive-color "#DA7756"
    }
}

// F9 pomodoro: three options and a countdown in the prompt line.
window-rule {
    match app-id="pomodoro-prompt"
    open-floating true
    open-focused true
    default-column-width { fixed 640; }
    default-window-height { fixed 300; }
    border {
        width 2
        active-color "#DA7756"
        inactive-color "#DA7756"
    }
}

// scroll: for_window [app_id="blueman-manager"] border pixel 0, floating enable, resize 35% 35%, move 63% 60%
window-rule {
    match app-id="blueman-manager"
    open-floating true
    // ^ niri can't set floating size/position via rules
}

// scroll: for_window [app_id="pavucontrol"] border pixel 0, floating enable, resize 35% 35%, move 63% 60%
window-rule {
    match app-id="pavucontrol"
    open-floating true
}

// Firefox Picture-in-Picture
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// Wezterm: no default column width
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

// Frosted kitty: kitty's background_opacity (0.9) makes the bg translucent;
// niri blur frosts the wallpaper behind it while text stays crisp.
// Enabled in niri 26.04 (Nixpkgs) — blur was not in 25.11.
window-rule {
    match app-id="kitty"
    background-effect {
        blur true
    }
}

// Frosted Nautilus: MacTahoe's "normal" (non -solid) gtk-4.0 variant already
// ships semi-transparent headerbar/sidebar surfaces meant for compositor blur
// behind them (home.nix links MacTahoe-Dark-grey's gtk-4.0 CSS) — this rule
// supplies that blur. Same app-id also matches the GTK file-chooser portal
// dialog (confirmed via `niri msg windows`: a Chrome PWA's "Open Files" picker
// reports App ID "org.gnome.Nautilus" too), so this covers both for free.
window-rule {
    match app-id="org.gnome.Nautilus"
    background-effect {
        blur true
    }
}
