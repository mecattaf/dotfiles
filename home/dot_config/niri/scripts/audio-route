#!/usr/bin/env bash
# Shift+F9 -> paired audio route picker. The DOCK era (2026-09-11): the Sound
# Blaster GS3, the iContact webcam mic and the INZONE dongle hang off the
# client's Thunderbolt dock, not off the coordinator, and hosts/client/audio.nix
# pins the iContact as the default source at boot. This script is what moves off
# that default for a call and back again.
#
# The four USB node names below are serial-based and therefore HOST-independent:
# the same dock plugged into any box produces the same names, so this file needs
# no host gate and keeps working if a device is moved. Node IDS are ephemeral,
# so the stable names are resolved from the live graph on every invocation.
set -euo pipefail

readonly SPEAKER_SINK='alsa_output.usb-Creative_Technology_Ltd_Sound_Blaster_GS3_1120050704030604-01.analog-stereo'
readonly WEBCAM_SOURCE='alsa_input.usb-DCX-241206-FAY_iContact_Camera_Pro_01.00.00-02.analog-stereo'
readonly INZONE_SINK='alsa_output.usb-Sony_INZONE_Buds-00.analog-stereo'
readonly INZONE_SOURCE='alsa_input.usb-Sony_INZONE_Buds-00.mono-fallback'

# The laptop's OWN card — the route that needs no dock at all: undock, or take
# one call on the couch. Matched by REGEX, not by an exact name. The Zenbook
# Duo's internal card is `sof-hda-dsp` (card0, metal facts 2026-09-11), and the
# PipeWire node built on it carries the PCI address plus whatever UCM profile
# wireplumber picked — "...pci-0000_xx_yy.z.analog-stereo" on one profile,
# "...HiFi__hw_sofhdadsp__sink" on another — so the node NAME is not something
# to hard-code. The pattern therefore tests node.name and the ALSA card name
# together: a PCI node belonging to a card that calls itself sof-hda-dsp.
#
# Never read off a live pw-dump on the laptop, so it is written to MISS
# SILENTLY: no match means no `internal` row, and the two dock rows are
# untouched. On the coordinator, whose internal card announces itself as
# "HD-Audio Generic", the row is correctly absent.
readonly INTERNAL_SINK_PREFIX='^alsa_output\.pci-'
readonly INTERNAL_SOURCE_PREFIX='^alsa_input\.pci-'
readonly INTERNAL_CARD_RE='sof[-_]?hda[-_]?dsp'

if ! graph=$(timeout 5 pw-dump); then
    printf '%s\n' 'PipeWire is not responding.' >&2
    printf '%s\n' 'Reconnect the last USB audio device and try again.' >&2
    read -r -t 3 || true
    exit 1
fi

node_id() {
    local media_class=$1
    local node_name=$2

    jq -er --arg media_class "$media_class" --arg node_name "$node_name" '
        [
          .[]
          | select(
              .type == "PipeWire:Interface:Node"
              and .info.props["media.class"] == $media_class
              and .info.props["node.name"] == $node_name
            )
          | .id
        ]
        | select(length == 1)
        | .[0]
    ' <<< "$graph"
}

# Glob sibling of node_id. node_id insists on EXACTLY one match because an exact
# name that appears twice means the graph is confused; a pattern is expected to
# be ambiguous (a laptop card publishes speaker and headphone sinks), so this one
# takes the lowest-numbered match and prints nothing at all when there is none.
node_id_match() {
    local media_class=$1
    local name_re=$2
    local card_re=$3

    jq -er \
        --arg media_class "$media_class" \
        --arg name_re "$name_re" \
        --arg card_re "$card_re" '
        [
          .[]
          | select(
              .type == "PipeWire:Interface:Node"
              and .info.props["media.class"] == $media_class
              and ((.info.props["node.name"] // "") | test($name_re))
              and (
                ((.info.props["node.name"] // "") | test($card_re))
                or ((.info.props["alsa.card_name"] // "") | test($card_re; "i"))
                or ((.info.props["api.alsa.card.name"] // "") | test($card_re; "i"))
              )
            )
          | .id
        ]
        | sort
        | .[0]
        | values
    ' <<< "$graph"
}

default_id() {
    wpctl inspect "$1" 2>/dev/null \
        | sed -n '1s/^id \([0-9][0-9]*\),.*/\1/p'
}

speaker_sink_id=$(node_id Audio/Sink "$SPEAKER_SINK" 2>/dev/null || true)
webcam_source_id=$(node_id Audio/Source "$WEBCAM_SOURCE" 2>/dev/null || true)
inzone_sink_id=$(node_id Audio/Sink "$INZONE_SINK" 2>/dev/null || true)
inzone_source_id=$(node_id Audio/Source "$INZONE_SOURCE" 2>/dev/null || true)
internal_sink_id=$(node_id_match Audio/Sink "$INTERNAL_SINK_PREFIX" "$INTERNAL_CARD_RE" 2>/dev/null || true)
internal_source_id=$(node_id_match Audio/Source "$INTERNAL_SOURCE_PREFIX" "$INTERNAL_CARD_RE" 2>/dev/null || true)
current_sink_id=$(default_id @DEFAULT_AUDIO_SINK@ || true)
current_source_id=$(default_id @DEFAULT_AUDIO_SOURCE@ || true)

marker() {
    if [[ "$1" == "$current_sink_id" && "$2" == "$current_source_id" ]]; then
        printf '●'
    else
        printf ' '
    fi
}

menu=()
if [[ -n "$speaker_sink_id" && -n "$webcam_source_id" ]]; then
    menu+=("speaker"$'\t'"  $(marker "$speaker_sink_id" "$webcam_source_id")  Sound Blaster GS3  ·  webcam mic")
fi
if [[ -n "$inzone_sink_id" && -n "$inzone_source_id" ]]; then
    menu+=("inzone"$'\t'"  $(marker "$inzone_sink_id" "$inzone_source_id")  Sony INZONE  ·  INZONE mic")
fi
if [[ -n "$internal_sink_id" && -n "$internal_source_id" ]]; then
    menu+=("internal"$'\t'"  $(marker "$internal_sink_id" "$internal_source_id")  Laptop speakers  ·  laptop mic")
fi

if ((${#menu[@]} == 0)); then
    printf '%s\n' 'Neither complete audio route is available.' >&2
    printf '%s\n' 'Check the USB-C speaker, webcam, and INZONE dongle.' >&2
    read -r -t 3 || true
    exit 1
fi

case "${1:-menu}" in
speaker|inzone|internal)
    choice=$1
    ;;
menu)
    choice=$(printf '%s\n' "${menu[@]}" \
        | fzf \
            --delimiter=$'\t' \
            --with-nth='2..' \
            --prompt='> ' \
            --header='Output + microphone' \
            --height=100% \
            --reverse \
            --no-info \
            --pointer='›' \
            --color='prompt:bold:8,header:italic:7,pointer:5') || exit 0
    choice=${choice%%$'\t'*}
    ;;
*)
    printf 'Usage: %s [speaker|inzone|internal|menu]\n' "${0##*/}" >&2
    exit 2
    ;;
esac

case "$choice" in
speaker)
    sink_id=$speaker_sink_id
    source_id=$webcam_source_id
    label='Sound Blaster GS3 + webcam mic'
    ;;
inzone)
    sink_id=$inzone_sink_id
    source_id=$inzone_source_id
    label='Sony INZONE + INZONE mic'
    ;;
internal)
    sink_id=$internal_sink_id
    source_id=$internal_source_id
    label='Laptop speakers + laptop mic'
    ;;
esac

if [[ -z "$sink_id" || -z "$source_id" ]]; then
    printf '%s is not fully available.\n' "$label" >&2
    read -r -t 3 || true
    exit 1
fi

# Preserve each device's stored volume, but never route into a retained mute.
# WirePlumber moves existing streams when the configured default changes, so
# an already-playing browser follows the selection immediately.
wpctl set-mute "$sink_id" 0
wpctl set-mute "$source_id" 0
wpctl set-default "$sink_id"
wpctl set-default "$source_id"

printf '\n✓ %s\n' "$label"
read -r -t 1.2 || true
