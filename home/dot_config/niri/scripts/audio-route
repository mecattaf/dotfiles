#!/usr/bin/env bash
# Shift+F9 -> paired coordinator audio route picker. Node ids are ephemeral, so
# resolve the stable PipeWire names from the live graph on every invocation.
set -euo pipefail

readonly WEBCAM_SOURCE='alsa_input.usb-DCX-241206-FAY_iContact_Camera_Pro_01.00.00-02.analog-stereo'
readonly INZONE_SINK='alsa_output.usb-Sony_INZONE_Buds-00.analog-stereo'
readonly INZONE_SOURCE='alsa_input.usb-Sony_INZONE_Buds-00.mono-fallback'

if ! graph=$(timeout 5 pw-dump); then
    printf '%s\n' 'PipeWire is not responding.' >&2
    printf '%s\n' 'Reconnect the last USB audio device and try again.' >&2
    read -r -t 3 || true
    exit 1
fi

node_id() {
    local media_class=$1
    local node_name=$2

    jq -er --arg media_class "$media_class" --arg node_name "$node_name" '
        [
          .[]
          | select(
              .type == "PipeWire:Interface:Node"
              and .info.props["media.class"] == $media_class
              and .info.props["node.name"] == $node_name
            )
          | .id
        ]
        | select(length == 1)
        | .[0]
    ' <<< "$graph"
}

default_id() {
    wpctl inspect "$1" 2>/dev/null \
        | sed -n '1s/^id \([0-9][0-9]*\),.*/\1/p'
}

aux_sink_row=$(jq -er --arg inzone_sink "$INZONE_SINK" '
    [
      .[]
      | select(
          .type == "PipeWire:Interface:Node"
          and .info.props["media.class"] == "Audio/Sink"
          and .info.props["device.bus"] == "usb"
          and .info.props["node.name"] != $inzone_sink
        )
      | [
          (.id | tostring),
          (
            .info.props["node.description"]
            // .info.props["node.nick"]
            // .info.props["node.name"]
          )
        ]
    ]
    | select(length == 1)
    | .[0]
    | @tsv
' <<< "$graph" 2>/dev/null || true)
aux_sink_id=''
aux_sink_description='USB-C adapter'
if [[ -n "$aux_sink_row" ]]; then
    IFS=$'\t' read -r aux_sink_id aux_sink_description <<< "$aux_sink_row"
fi
webcam_source_id=$(node_id Audio/Source "$WEBCAM_SOURCE" 2>/dev/null || true)
inzone_sink_id=$(node_id Audio/Sink "$INZONE_SINK" 2>/dev/null || true)
inzone_source_id=$(node_id Audio/Source "$INZONE_SOURCE" 2>/dev/null || true)
current_sink_id=$(default_id @DEFAULT_AUDIO_SINK@ || true)
current_source_id=$(default_id @DEFAULT_AUDIO_SOURCE@ || true)

marker() {
    if [[ "$1" == "$current_sink_id" && "$2" == "$current_source_id" ]]; then
        printf '●'
    else
        printf ' '
    fi
}

menu=()
if [[ -n "$aux_sink_id" && -n "$webcam_source_id" ]]; then
    menu+=("aux"$'\t'"  $(marker "$aux_sink_id" "$webcam_source_id")  AUX via ${aux_sink_description}  ·  webcam mic")
fi
if [[ -n "$inzone_sink_id" && -n "$inzone_source_id" ]]; then
    menu+=("inzone"$'\t'"  $(marker "$inzone_sink_id" "$inzone_source_id")  Sony INZONE  ·  INZONE mic")
fi

if ((${#menu[@]} == 0)); then
    printf '%s\n' 'Neither complete audio route is available.' >&2
    printf '%s\n' 'Check the USB-C adapter, webcam, and INZONE dongle.' >&2
    read -r -t 3 || true
    exit 1
fi

case "${1:-menu}" in
aux|inzone)
    choice=$1
    ;;
menu)
    choice=$(printf '%s\n' "${menu[@]}" \
        | fzf \
            --delimiter=$'\t' \
            --with-nth='2..' \
            --prompt='> ' \
            --header='Output + microphone' \
            --height=100% \
            --reverse \
            --no-info \
            --pointer='›' \
            --color='prompt:bold:8,header:italic:7,pointer:5') || exit 0
    choice=${choice%%$'\t'*}
    ;;
*)
    printf 'Usage: %s [aux|inzone|menu]\n' "${0##*/}" >&2
    exit 2
    ;;
esac

case "$choice" in
aux)
    sink_id=$aux_sink_id
    source_id=$webcam_source_id
    label="AUX via ${aux_sink_description} + webcam mic"
    ;;
inzone)
    sink_id=$inzone_sink_id
    source_id=$inzone_source_id
    label='Sony INZONE + INZONE mic'
    ;;
esac

if [[ -z "$sink_id" || -z "$source_id" ]]; then
    printf '%s is not fully available.\n' "$label" >&2
    read -r -t 3 || true
    exit 1
fi

# Preserve each device's stored volume, but never route into a retained mute.
# WirePlumber moves existing streams when the configured default changes, so
# an already-playing browser follows the selection immediately.
wpctl set-mute "$sink_id" 0
wpctl set-mute "$source_id" 0
wpctl set-default "$sink_id"
wpctl set-default "$source_id"

printf '\n✓ %s\n' "$label"
read -r -t 1.2 || true
