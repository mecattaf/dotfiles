#!/usr/bin/env python3
"""util-sampler — UTIL-01 §signal.instrument. ONE sample per invocation.

Reads: sysfs (gfx1151 amdgpu), `tally query pools` (coordinator only), the
worker's halogen liveness and model-list endpoints, Halogen's journal since the
previous sample (worker only; the token window), the box's drain ledger.
Writes: exactly one JSON line to $UTIL_METERS/util-sampler/<box>-<date>.jsonl.

It never POSTs, never touches /v1/chat/completions or /completion, never holds a
GPU, never starts or stops anything, and opens every input 'r'.  The only path it
creates or writes is $UTIL_METERS/util-sampler/.

Token window (util-sample/3, dotfiles#312, 2026-09-13).  Halogen has no /metrics,
but it logs one `serve_api:` line per completed request carrying the request's
completion tokens, prompt tokens, cached prompt tokens and prefill/decode
seconds.  Each sample reads the lines logged since the previous sample's journal
cursor (read back from the tail of this box's own sampler log, so there is no
state file) and records their sums as `probes[].tokens`.  A window that could
not be read carries `error` and no counts — the row writer then says UNKNOWN,
never zero; a window with no request in it is a measured zero.

Invoked by a 60 s systemd user timer; it takes one sample and exits.  There is no
loop in this file.

Time budget (no threads, no signals): the whole invocation is capped at 12 s and
each probe (health + arms) at 4 s, enforced by checking the elapsed
time between requests and skipping the remaining fetches.  A probe that lost the
budget is recorded with `skipped: true`, never as `alive: false` — a probe that
was not asked is not a dead probe.

Write discipline (T6 / abort_on).  `--box` is not a free string: it is looked up
in the card's declared boxes and an undeclared one is refused with exit 2 before
anything is read.  The append then goes through guard_meters_write(), the same
guard util-row uses, so no argument — `--box ../../ESCAPED` included — can put a
byte outside <meters>/util-*.  Both checks are present: the whitelist is the
specification, the guard is the belt.

Every sample records the box's IANA zone (`tz`) beside the offset-bearing `ts`.
The offset alone cannot say how long the local day is: a sampler that stops
before a fall-back transition writes only `+02:00`, and a row computed from those
offsets calls a 25-hour day 24 hours long.  The zone key is the fact that fixes
it, so the sampler — the only program on the box at sample time — records it.
"""

import argparse
import hashlib
import json
import os
import re
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.request
from datetime import datetime, timedelta, timezone
from zoneinfo import ZoneInfo, ZoneInfoNotFoundError

SCHEMA = "util-sample/3"   # /2 adds `tz` and `tz_source`; /3 adds probes[].tokens
PROBE_TIMEOUT_S = 2.0            # one HTTP request
POOLS_TIMEOUT_S = 5.0            # `tally query pools`
PROBE_BUDGET_S = 4.0             # health + arms for ONE probe
INVOCATION_BUDGET_S = 12.0       # the whole sample, against the card's 15 s timer

# --- the card's `definition` block, transcribed, not reinterpreted -----------

SYSFS_DIR = "/sys/class/drm/card1/device"
SYSFS_FIELDS = {
    "gpu_busy_percent": "gpu_busy_percent",
    "vram_used": "mem_info_vram_used",
    "gtt_used": "mem_info_gtt_used",
}

# The fleet's one inference server: Halogen Flash on the worker
# (modules/halogen.nix), OpenAI-compatible on :8731 with GET /health as its
# liveness probe and GET /v1/models as the list of what it serves.  The base
# URL is the *_INFERENCE_URL convention; the override exists for a hand-run
# llama-server, not for a second declared server.
INFERENCE_URL = (os.environ.get("UTIL_SAMPLER_INFERENCE_URL") or "http://worker:8731").rstrip("/")

# Halogen serves no prometheus /metrics (GET /metrics is a 404), so every probe's
# `metrics` is None and `metrics_reason` says why in the sample itself.  Its
# token counts come from the journal instead: see read_token_window().
NO_METRICS = "no /metrics; tokens come from the journal window"

# The journal units a Halogen server logs under: the Flash primary and the one
# declared alternate (modules/halogen.nix unitOf; hosts/worker's
# services.halogen.alternates).  Only one is resident at a time, and journalctl
# with a -u that matches nothing still succeeds, so naming both is harmless.
HALOGEN_UNITS = ("podman-halogen.service", "podman-halogen-qwen38-27b.service")
JOURNAL_TIMEOUT_S = 3.0
# A cursor older than this is not chained: the lines behind it belong to a gap
# the row already reports, and summing them into this one sample would put a
# gap's tokens on the wrong minute (or the wrong day).  Same cap as the row's.
CURSOR_MAX_AGE_S = 300.0
LOG_TAIL_BYTES = 1 << 16

# One completed request, as Halogen 0.7.0 logs it (worker journal, 2026-09-13):
#   serve_api: mtp 160 tok in 3.14s = 50.89 t/s | 88 rounds, commit 1.82/round |
#   prompt 330 (325 cached), prefill 0.05s | detok 11us/tok | pld 6 rounds, ...
# Calibrated the same evening against the API's own answer for that request:
#   `N tok`        == usage.completion_tokens == timings.predicted_n (reasoning included)
#   `prompt P`     == timings.prompt_n, and it INCLUDES the cached tokens
#   `(K cached)`   == timings.cache_n == usage.prompt_tokens_details.cached_tokens
#   `prefill Xs`   == timings.prompt_ms / 1000 (the uncached prefill's time)
#   `tok in Ys`    == timings.predicted_ms / 1000
# `(K cached)` is absent when nothing was cached, `rounds, commit` is absent under
# concurrency, and the detok/pld tail varies, so all three are optional and the
# pattern is not anchored at the end.
LINE_RE = re.compile(
    r"serve_api: (?P<mode>\w+) (?P<out>\d+) tok in (?P<dec_s>[\d.]+)s = [\d.]+ t/s"
    r"(?: \| (?P<rounds>\d+) rounds, commit (?P<commit>[\d.]+)/round)?"
    r" \| prompt (?P<prompt>\d+)(?: \((?P<cached>\d+) cached\))?, prefill (?P<prefill_s>[\d.]+)s")

# The coordinator serves nothing declaratively — the small GGUF artifacts loaned
# there are run by hand, and a hand-run llama-server is not a declared probe —
# so its probe list is empty and its sample carries sysfs, pools and the ledger.
# The client — the Zenbook Duo, a full member of the fleet from 2026-09-13 —
# serves nothing and holds no GPU pool: its sample is the clock, the zone and
# an all-None sysfs block, which is what "this box ran nothing" looks like.
SERVE_PROBES = {
    "client": [],
    "coordinator": [],
    "worker": [
        {"name": "halogen",
         "health": INFERENCE_URL + "/health",
         "arms": INFERENCE_URL + "/v1/models",
         "journal_units": HALOGEN_UNITS},
    ],
}

LEDGERS = {
    "client": None,
    "coordinator": "/home/tom/.local/state/academic-ocr/drain/completed.jsonl",
    "worker": None,
}

VRAM_POOL_BY_BOX = {"coordinator": "coordinator-gpu", "worker": "worker-gpu"}

# Three declared boxes: the two Strix twins and the client.  A sample from
# anything else is not a sample of this estate, and its name must never reach
# a filesystem path.
KNOWN_BOXES = tuple(sorted(set(SERVE_PROBES) | set(VRAM_POOL_BY_BOX) | set(LEDGERS)))

ZONEINFO_MARK = os.sep + "zoneinfo" + os.sep

# --- helpers ----------------------------------------------------------------


def meters_root():
    root = os.environ.get("UTIL_METERS") or "~/.local/state/tally/meters"
    return os.path.abspath(os.path.expanduser(root))


def guard_meters_write(meters, path):
    """T6: util-sampler writes nothing outside <meters>/util-*.

    The same guard as util-row's, in the same words, for the same reason.
    realpath, not abspath: a symlink out of the meters root is a write outside
    the meters root.
    """
    root = os.path.realpath(meters)
    target = os.path.realpath(path)
    rel = os.path.relpath(target, root)
    first = rel.split(os.sep)[0]
    if first == os.pardir or os.path.isabs(rel):
        raise SystemExit("util-sampler: refusing to write outside %s: %s" % (root, target))
    if not first.startswith("util-"):
        raise SystemExit("util-sampler: refusing to write %s — only <meters>/util-* is writable"
                         % target)
    return target


def detect_box(explicit):
    """The box name, checked against the card's declared boxes.

    It becomes a filename, so it is a whitelist and not a string: `--box
    ../../ESCAPED` is refused here, before any path is built.  An undeclared
    hostname is refused too — the sampler does not invent a box.
    """
    box = explicit or socket.gethostname().split(".")[0]
    if box not in KNOWN_BOXES:
        raise ValueError(box)
    return box


def local_tz():
    """(IANA key, where it came from) for the box's local zone.

    $TZ first, then the /etc/localtime symlink.  The key is validated by loading
    it, so an unloadable name is recorded as unknown rather than written into the
    sample as a fact.  Both are null when neither answers; the row writer then
    falls back to the replaying box's own zone and says so.
    """
    candidate = os.environ.get("TZ") or None
    if candidate:
        candidate = candidate.lstrip(":")
    source = "TZ" if candidate else None
    if not candidate:
        try:
            real = os.path.realpath("/etc/localtime")
        except OSError:
            real = ""
        idx = real.rfind(ZONEINFO_MARK)
        if idx >= 0:
            candidate = real[idx + len(ZONEINFO_MARK):]
            source = "/etc/localtime"
    if not candidate:
        return None, None
    try:
        ZoneInfo(candidate)
    except (ZoneInfoNotFoundError, ValueError, OSError):
        return None, None
    return candidate, source


class Clock:
    """The invocation budget.  `remaining()` is what is left of INVOCATION_BUDGET_S.

    Nothing is interrupted mid-request: every request is given a timeout no
    larger than what is left, and a request whose budget has run out is not
    issued at all.
    """

    def __init__(self, budget=INVOCATION_BUDGET_S):
        self.t0 = time.monotonic()
        self.budget = budget

    def elapsed(self):
        return time.monotonic() - self.t0

    def remaining(self):
        return self.budget - self.elapsed()


def read_sysfs():
    out = {}
    for key, fname in SYSFS_FIELDS.items():
        try:
            with open(os.path.join(SYSFS_DIR, fname), "r") as fh:
                out[key] = int(fh.read().strip())
        except Exception:
            out[key] = None
    return out


def http_get(url, timeout=PROBE_TIMEOUT_S):
    """Returns (status:int|None, body:str|None, ms:int, error:str|None).

    A refused connection or a timeout is a value, never an exception.
    Only GET; the sampler has no other verb.
    """
    t0 = time.monotonic()
    req = urllib.request.Request(url, method="GET")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            body = resp.read(1 << 20).decode("utf-8", "replace")
            return resp.status, body, int(round((time.monotonic() - t0) * 1000)), None
    except urllib.error.HTTPError as exc:
        try:
            body = exc.read(1 << 20).decode("utf-8", "replace")
        except Exception:
            body = None
        return exc.code, body, int(round((time.monotonic() - t0) * 1000)), None
    except Exception as exc:
        return None, None, int(round((time.monotonic() - t0) * 1000)), "%s: %s" % (type(exc).__name__, exc)


def parse_arms(body):
    """Model ids from a /v1/models answer.  [] is 'nothing served';
    None is 'the answer could not be read'."""
    if body is None:
        return None
    try:
        doc = json.loads(body)
    except Exception:
        return None
    if not isinstance(doc, dict):
        return None
    ids = []
    for key in ("data", "running", "models"):
        seq = doc.get(key)
        if not isinstance(seq, list):
            continue
        for item in seq:
            if isinstance(item, str):
                ids.append(item)
            elif isinstance(item, dict):
                for field in ("id", "model", "name"):
                    val = item.get(field)
                    if isinstance(val, str) and val:
                        ids.append(val)
                        break
        break
    return sorted(set(ids))


def probe_one(spec, clock):
    """health, then arms — each only while budget remains.

    Worst case for this function is PROBE_BUDGET_S (4 s), and it never exceeds
    what `clock` has left, so the probe plus the pools call cannot run past
    INVOCATION_BUDGET_S.  `metrics` is always None: the server has no /metrics,
    and the sample says so beside it.  The token window is read by
    build_sample() after every HTTP probe, not here.
    """
    p0 = time.monotonic()
    probe = {"name": spec["name"], "alive": False, "http": None, "ms": None,
             "arms": None, "metrics": None, "metrics_reason": NO_METRICS,
             "skipped": False, "elapsed_ms": 0}

    def left():
        return min(PROBE_BUDGET_S - (time.monotonic() - p0), clock.remaining())

    def done():
        probe["elapsed_ms"] = int(round((time.monotonic() - p0) * 1000))
        return probe

    budget = left()
    if budget <= 0:
        probe["skipped"] = True
        return done()
    status, _body, ms, _err = http_get(spec["health"], timeout=min(PROBE_TIMEOUT_S, budget))
    probe["http"] = status
    probe["ms"] = ms
    probe["alive"] = status == 200
    if not probe["alive"]:
        return done()

    budget = left()
    if budget <= 0:
        probe["skipped"] = True
        return done()
    a_status, a_body, _a_ms, _a_err = http_get(spec["arms"], timeout=min(PROBE_TIMEOUT_S, budget))
    if a_status == 200:
        probe["arms"] = parse_arms(a_body)
    return done()


def parse_serve_lines(lines):
    """Sums over Halogen `serve_api:` request lines.  Pure; the fixture test's seam.

    Lines that are not request lines (uvicorn access lines, load messages) are
    skipped before the pattern is tried.  A request line the pattern cannot read
    is counted in `unparsed`, never guessed at, so a format change shows up as a
    number in the sample rather than as silently missing tokens.
    """
    acc = {"requests": 0, "prompt_tokens": 0, "cached_tokens": 0,
           "completion_tokens": 0, "prefill_s": 0.0, "decode_s": 0.0, "unparsed": 0}
    for line in lines:
        if "serve_api: " not in line or " tok in " not in line:
            continue
        m = LINE_RE.search(line)
        if m is None:
            acc["unparsed"] += 1
            continue
        acc["requests"] += 1
        acc["prompt_tokens"] += int(m.group("prompt"))
        acc["cached_tokens"] += int(m.group("cached") or 0)
        acc["completion_tokens"] += int(m.group("out"))
        acc["prefill_s"] += float(m.group("prefill_s"))
        acc["decode_s"] += float(m.group("dec_s"))
    acc["prefill_s"] = round(acc["prefill_s"], 6)
    acc["decode_s"] = round(acc["decode_s"], 6)
    return acc


def previous_cursor(meters, box, probe_name, now_epoch):
    """(cursor, age_s) of this probe's last token window, read from the tail of
    this box's own sampler log (today's, else yesterday's).  (None, None) if none.

    Read-only and bounded to the last LOG_TAIL_BYTES of the file.  A window that
    errored carries no cursor; the search goes back past it to the last good one,
    so one failed read does not break the chain.
    """
    today = datetime.fromtimestamp(now_epoch).astimezone()
    for day in (today, today - timedelta(days=1)):
        path = os.path.join(meters, "util-sampler", "%s-%s.jsonl" % (box, day.strftime("%Y-%m-%d")))
        try:
            with open(path, "rb") as fh:
                fh.seek(0, os.SEEK_END)
                size = fh.tell()
                fh.seek(max(0, size - LOG_TAIL_BYTES))
                tail = fh.read().decode("utf-8", "replace").splitlines()
        except OSError:
            continue
        for line in reversed(tail):
            try:
                doc = json.loads(line)
            except Exception:
                continue
            for probe in doc.get("probes") or []:
                if probe.get("name") != probe_name:
                    continue
                tokens = probe.get("tokens")
                if isinstance(tokens, dict) and isinstance(tokens.get("cursor"), str):
                    try:
                        age = now_epoch - float(doc["ts_epoch"])
                    except Exception:
                        age = None
                    return tokens["cursor"], age
    return None, None


def read_token_window(spec, prev_cursor, clock):
    """Halogen's request lines since `prev_cursor`, summed.  Never raises.

    With a cursor the window is exact and chained (`window_complete: true`);
    without one it is the last 60 s and flagged incomplete.  Any failure — no
    budget, journalctl missing, a non-zero exit, a timeout, no cursor printed —
    returns `error` and no counts: the row reads that as UNKNOWN, never as zero.
    With no new line journalctl still prints the cursor, so an idle window is a
    measured zero.
    """
    base = {"source": "journal", "units": list(spec["journal_units"]),
            "since_cursor": prev_cursor, "cursor": None}
    budget = min(JOURNAL_TIMEOUT_S, clock.remaining())
    if budget <= 0:
        base["error"] = "invocation budget exhausted before journalctl"
        return base
    argv = ["journalctl", "-q", "--no-pager", "-o", "cat", "--show-cursor"]
    for unit in spec["journal_units"]:
        argv += ["-u", unit]
    argv += ["--after-cursor=%s" % prev_cursor] if prev_cursor else ["--since=-60s"]
    try:
        proc = subprocess.run(argv, capture_output=True, text=True, timeout=budget)
    except Exception as exc:
        base["error"] = "%s: %s" % (type(exc).__name__, exc)
        return base
    if proc.returncode != 0:
        base["error"] = "journalctl exit %d: %s" % (proc.returncode, (proc.stderr or "").strip()[:200])
        return base
    cursor = None
    body = []
    for line in proc.stdout.splitlines():
        if line.startswith("-- cursor: "):
            cursor = line[len("-- cursor: "):].strip()
        else:
            body.append(line)
    if not cursor and not prev_cursor:
        # `--since` over a quiet minute prints no entry and therefore no cursor
        # (measured on the worker 2026-09-13; --after-cursor prints one even when
        # empty).  The minute had no request line in it, so the chain is started
        # from the units' last entry, which is older than the window and not
        # counted.  Without this a server that logs nothing could never chain.
        budget = min(JOURNAL_TIMEOUT_S, clock.remaining())
        if budget > 0:
            try:
                last = subprocess.run(argv[:-1] + ["-n", "1"], capture_output=True,
                                      text=True, timeout=budget)
                if last.returncode == 0:
                    for line in last.stdout.splitlines():
                        if line.startswith("-- cursor: "):
                            cursor = line[len("-- cursor: "):].strip()
            except Exception:
                pass
    if not cursor:
        base["error"] = "journalctl printed no cursor (no journal entry for %s)" % ", ".join(
            spec["journal_units"])
        return base
    base["cursor"] = cursor
    base["window_complete"] = prev_cursor is not None
    base.update(parse_serve_lines(body))
    return base


def read_pools(box, clock):
    """`tally query pools` reduced to {pool: held}.  Coordinator only.

    Bounded by whatever is left of the invocation budget; an exhausted budget is
    recorded as a failure with its reason, never as held 0 (R-04)."""
    if box != "coordinator":
        return None
    budget = min(POOLS_TIMEOUT_S, clock.remaining())
    if budget <= 0:
        return {"ok": False, "held": None, "elapsed_ms": 0, "skipped": True,
                "error": "invocation budget exhausted before `tally query pools`"}
    t0 = time.monotonic()
    try:
        proc = subprocess.run(
            ["tally", "query", "pools"],
            capture_output=True, timeout=budget, text=True,
        )
    except Exception as exc:
        return {"ok": False, "held": None, "skipped": False,
                "elapsed_ms": int(round((time.monotonic() - t0) * 1000)),
                "error": "%s: %s" % (type(exc).__name__, exc)}
    elapsed = int(round((time.monotonic() - t0) * 1000))
    if proc.returncode != 0:
        return {"ok": False, "held": None, "elapsed_ms": elapsed, "skipped": False,
                "error": "exit %d: %s" % (proc.returncode, (proc.stderr or "")[:200])}
    try:
        doc = json.loads(proc.stdout)
        held = {}
        for pool in doc.get("pools", []):
            held[str(pool["pool"])] = int(pool["held"])
    except Exception as exc:
        return {"ok": False, "held": None, "elapsed_ms": elapsed, "skipped": False,
                "error": "%s: %s" % (type(exc).__name__, exc)}
    return {"ok": True, "held": held, "elapsed_ms": elapsed, "skipped": False, "error": None}


def sha256_and_lines(path):
    h = hashlib.sha256()
    lines = 0
    with open(path, "rb") as fh:
        while True:
            chunk = fh.read(1 << 20)
            if not chunk:
                break
            h.update(chunk)
            lines += chunk.count(b"\n")
    return h.hexdigest(), lines


def read_ledger(box):
    path = LEDGERS.get(box)
    if path is None:
        return {"path": None, "exists": False, "bytes": None,
                "lines": None, "sha256": None, "mtime": None}
    try:
        st = os.stat(path)
    except Exception:
        return {"path": path, "exists": False, "bytes": None,
                "lines": None, "sha256": None, "mtime": None}
    try:
        digest, lines = sha256_and_lines(path)
    except Exception:
        digest, lines = None, None
    return {"path": path, "exists": True, "bytes": st.st_size,
            "lines": lines, "sha256": digest, "mtime": st.st_mtime}


def self_sha256():
    """sha256 of this program's own file.

    When the program is piped over ssh (`python3 - < util-sampler`) the source is
    not a file and cannot be re-read; the value is null and the grade says so.
    No CLAIMED value is ever written here (R-03/abort_on).
    """
    path = globals().get("__file__")
    if isinstance(path, str) and os.path.isfile(path):
        try:
            with open(path, "rb") as fh:
                return hashlib.sha256(fh.read()).hexdigest(), "MEASURED"
        except Exception:
            pass
    return None, "UNKNOWN"


def build_sample(box, meters=None):
    clock = Clock()
    now = datetime.now().astimezone()
    version, version_grade = self_sha256()
    tz_key, tz_source = local_tz()
    sysfs = read_sysfs()
    pools = read_pools(box, clock)
    specs = SERVE_PROBES.get(box, [])
    probes = [probe_one(spec, clock) for spec in specs]
    # The token window is read AFTER every HTTP probe, so a slow journal can only
    # cost the window (recorded as an error), never a liveness answer.  It is
    # read whether or not the probe is alive: a request can finish just before
    # the server dies, and its line is still in the journal.
    for spec, probe in zip(specs, probes):
        if not spec.get("journal_units"):
            continue
        cursor, age = previous_cursor(meters or meters_root(), box, spec["name"], now.timestamp())
        if cursor is not None and (age is None or age > CURSOR_MAX_AGE_S or age < 0):
            cursor = None
        probe["tokens"] = read_token_window(spec, cursor, clock)
    return {
        "schema": SCHEMA,
        "ts": now.isoformat(),
        "ts_epoch": now.timestamp(),
        "tz": tz_key,
        "tz_source": tz_source,
        "box": box,
        "lease_pool": VRAM_POOL_BY_BOX.get(box),
        "sysfs": sysfs,
        "pools": pools,
        "probes": probes,
        "ledger": read_ledger(box),
        "budget": {"invocation_s": INVOCATION_BUDGET_S, "probe_s": PROBE_BUDGET_S,
                   "exhausted": clock.remaining() <= 0},
        "sampler_version": version,
        "sampler_version_grade": version_grade,
    }


def main(argv=None):
    ap = argparse.ArgumentParser(description="UTIL-01 sampler: one sample, then exit.")
    ap.add_argument("--box", default=None,
                    help="one of %s (default: hostname)" % " | ".join(KNOWN_BOXES))
    ap.add_argument("--meters", default=None, help="meters root (default: $UTIL_METERS)")
    ap.add_argument("--stdout", action="store_true",
                    help="print the sample instead of appending it (writes nothing)")
    args = ap.parse_args(argv)

    try:
        box = detect_box(args.box)
    except ValueError as exc:
        sys.stderr.write("util-sampler: unknown box %r; declared boxes are %s; nothing written\n"
                         % (str(exc), ", ".join(KNOWN_BOXES)))
        return 2
    root = os.path.abspath(os.path.expanduser(args.meters)) if args.meters else meters_root()
    sample = build_sample(box, root)
    line = json.dumps(sample, sort_keys=True) + "\n"

    if args.stdout:
        sys.stdout.write(line)
        return 0

    outdir = guard_meters_write(root, os.path.join(root, "util-sampler"))
    os.makedirs(outdir, exist_ok=True)
    day = datetime.fromisoformat(sample["ts"]).strftime("%Y-%m-%d")
    outpath = guard_meters_write(root, os.path.join(outdir, "%s-%s.jsonl" % (box, day)))
    with open(outpath, "a") as fh:
        fh.write(line)
    sys.stdout.write(outpath + "\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
