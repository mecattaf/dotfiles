#!/usr/bin/env bash
# media -- MPRIS playback control (bound to F3-F5 in niri/binds.kdl)
#
# Acts on playerctl's default player. (Until 2026-09-17 this preferred cliamp
# when it was running; cliamp was removed, unused.)
case "$1" in
    play|toggle)  playerctl play-pause ;;
    next)         playerctl next ;;
    prev)         playerctl previous ;;
    *)            echo "Usage: $0 {play|next|prev}"; exit 1 ;;
esac
