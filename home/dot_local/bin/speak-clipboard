#!/usr/bin/env bash
# speak-clipboard -- queue the clipboard's text for reading aloud
# Queue one atomic Markdown drop on the NAS. The queue owns rendering,
# quiet hours, playback, and receipts.
set -euo pipefail

text="$(wl-paste --no-newline --type text 2>/dev/null)" || exit 0
[ -n "${text//[[:space:]]/}" ] || exit 0

name="$(hostname)--clipboard-$(date +%Y%m%dT%H%M%S)-$RANDOM$RANDOM"
root=$(ssh -o BatchMode=yes nas utility-path speech)
[[ "$root" == /* && "$root" != *$'\n'* ]] || exit 1
printf -v intake '%q' "$root/intake"
printf '%s\n' "$text" | ssh -o BatchMode=yes nas \
    "mkdir -p -- $intake && cat > $intake/.$name.md.tmp && mv -- $intake/.$name.md.tmp $intake/$name.md"
