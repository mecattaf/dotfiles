#!/usr/bin/env bash
# One-shot status of the worker twin, over the house LAN.
#
# The worker is wired into the BE550 in another room and 10.42.0.5 is its only
# address. There is no tailnet fallback: the worker left the tailnet and
# 100.66.206.54 has been dead since.
W=${WORKER_ADDR:-10.42.0.5}
exec ssh -o ConnectTimeout=5 -o BatchMode=yes tom@"$W" "bash -s" <<'REMOTE'
echo "== worker $(hostname) up $(uptime | sed "s/.*up //;s/,.*//") =="
echo "-- box --"
t=$(cat /sys/class/drm/card*/device/hwmon/hwmon*/temp1_input 2>/dev/null | head -1)
echo "gpu edge: $((t/1000))C   disk free: $(df -h --output=avail / | tail -1 | tr -d ' ')"
echo "-- halogen --"
systemctl is-active podman-halogen.service | sed 's|^|unit: |'
curl -fsS -m 5 http://127.0.0.1:8731/health 2>/dev/null | head -c 300 || echo "health: no answer on :8731"
echo
REMOTE
