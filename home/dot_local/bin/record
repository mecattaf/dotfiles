#!/usr/bin/env bash
# Screen recording on Sway/Hyprland. Failed/cancelled selection never records
# a different region. Keep recorder errors visible for diagnosis.
set -euo pipefail

start() {
    local output geometry=""
    output="$(desktop-control focused-output)"
    if [[ $1 == select ]]; then
        geometry="$(slurp)" || return 0
        [[ -n $geometry ]] || return 0
    fi
    mkdir -p "$HOME/Videos"
    local -a args=(-a -o "$output")
    [[ -z $geometry ]] || args+=(-g "$geometry")
    args+=(-f "$HOME/Videos/scrn-$(date +'%Y-%m-%d-%H:%M:%S').mp4")
    notify-send -u critical "Screen Recording Started" -t 0 || true
    wf-recorder "${args[@]}"
}

stop() {
    pkill -u "$(id -u)" -x -SIGINT wf-recorder
    notify-send -u low "Screen Recording Stopped" -t 0 || true
}

case "${1:-}" in
    start|select) start "$1" ;;
    stop) stop ;;
    toggle)
        if pgrep -u "$(id -u)" -x wf-recorder >/dev/null; then stop; else start start; fi
        ;;
    *) echo "Usage: $0 {start|select|stop|toggle}" >&2; exit 2 ;;
esac
