#!/usr/bin/env bash
# Run tests with private user-runtime sockets. This is runtime isolation, not
# a filesystem sandbox: the checkout, home, /tmp and network remain available.
#
# --allow-kvm (#453) adds exactly one device node, /dev/kvm, to the otherwise
# minimal /dev, so a KVM guest (a microvm.nix declaredRunner) can start. It
# widens nothing else: /run/user stays private, the PID and IPC namespaces and
# every --unsetenv below are unchanged, and the checkout, $HOME, /tmp and the
# network stay as accessible as they already are. --render-node exposes one
# validated DRM render node for nested GPU compositor tests. It never exposes
# a modesetting/card or input device. There is no general device passthrough.
set -euo pipefail
if [ "${1:-}" = --help ] || [ "$#" -eq 0 ]; then
  echo 'usage: runtime-test [--allow-kvm] [--render-node /dev/dri/renderD<number>] [--] command [args...]'
  echo 'Private /run/user and PID/IPC namespaces; source files remain writable.'
  echo '--allow-kvm also binds /dev/kvm (and nothing else) for KVM guests.'
  echo '--render-node binds one GPU render node, never a display/card or input device.'
  exit 0
fi
devices=()
while [ "${1:-}" = --allow-kvm ] || [ "${1:-}" = --render-node ]; do
if [ "$1" = --allow-kvm ]; then
  shift
  # Fail loudly rather than run the guest without the device it asked for.
  if [ ! -c /dev/kvm ] || [ ! -r /dev/kvm ] || [ ! -w /dev/kvm ]; then
    echo 'runtime-test: --allow-kvm given but /dev/kvm is absent or not read-write for this user' >&2
    exit 1
  fi
  devices+=(--dev-bind /dev/kvm /dev/kvm)
else
  shift
  render_node="${1:-}"
  [[ "$render_node" =~ ^/dev/dri/renderD[0-9]+$ ]] \
    || { echo 'runtime-test: --render-node requires /dev/dri/renderD<number>' >&2; exit 2; }
  # Validate type, identity and access before binding. Reject symlinks and
  # disguised card nodes even if their filename resembles a render node.
  if [[ -L "$render_node" || ! -c "$render_node" || ! -r "$render_node" || ! -w "$render_node" ]] \
    || [[ "$(stat -c %t "$render_node")" != e2 ]] \
    || (( 16#$(stat -c %T "$render_node") < 128 )); then
    echo "runtime-test: --render-node requires an accessible DRM render device: $render_node" >&2
    exit 1
  fi
  devices+=(--dev-bind "$render_node" "$render_node")
  shift
fi
done
[ "${1:-}" != -- ] || shift
[ "$#" -gt 0 ] || { echo 'runtime-test: missing command' >&2; exit 2; }
command -v bwrap >/dev/null || { echo 'runtime-test: bubblewrap is required' >&2; exit 1; }

# Mask the real PATH as well as changing the environment: tests sometimes
# hardcode /run/user/<uid>. A fresh procfs also hides host /proc/<pid>/root.
# Never derive a cleanup target from the inherited XDG_RUNTIME_DIR.
runtime="/run/user/$(id -u)"
exec bwrap --die-with-parent --unshare-user --unshare-pid --unshare-ipc \
  --bind / / --proc /proc --dev /dev "${devices[@]}" --tmpfs /run/user --dir "$runtime" \
  --chmod 0700 "$runtime" --setenv XDG_RUNTIME_DIR "$runtime" \
  --unsetenv DBUS_SESSION_BUS_ADDRESS --unsetenv DBUS_SESSION_BUS_PID \
  --unsetenv NOTIFY_SOCKET --unsetenv WATCHDOG_PID --unsetenv WATCHDOG_USEC \
  --unsetenv WAYLAND_DISPLAY --unsetenv DISPLAY --unsetenv SWAYSOCK \
  --unsetenv I3SOCK --unsetenv HYPRLAND_INSTANCE_SIGNATURE --unsetenv HYPRLAND_CMD \
  --unsetenv SSH_AUTH_SOCK --unsetenv PULSE_SERVER \
  -- "$@"
