#!/usr/bin/env bash
# Run tests with private user-runtime sockets. This is runtime isolation, not
# a filesystem sandbox: the checkout, home, /tmp and network remain available.
#
# --allow-kvm adds only /dev/kvm for KVM guests. --allow-gpu adds only /dev/kfd
# and one explicitly selected /dev/dri/renderD<number> character device. Both
# require read-write access and leave the rest of /dev private. /run/user,
# PID/IPC namespaces and every --unsetenv below stay unchanged. There is no
# general device passthrough.
set -euo pipefail
usage() {
  echo 'usage: runtime-test [--allow-kvm] [--allow-gpu /dev/dri/renderD<number>] [--] command [args...]'
  echo 'Private /run/user and PID/IPC namespaces; source files remain writable.'
  echo '--allow-kvm binds only /dev/kvm for KVM guests.'
  echo '--allow-gpu binds only /dev/kfd and the selected render node for GPU tests.'
}
if [ "$#" -eq 0 ]; then
  usage
  exit 0
fi
allow_kvm=0
gpu_node=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --help) usage; exit 0 ;;
    --allow-kvm) allow_kvm=1; shift ;;
    --allow-gpu)
      if [ "$#" -lt 2 ] || [[ ! "$2" =~ ^/dev/dri/renderD[0-9]+$ ]]; then
        echo 'runtime-test: --allow-gpu requires /dev/dri/renderD<number>' >&2
        exit 2
      fi
      if [ -n "$gpu_node" ]; then
        echo 'runtime-test: --allow-gpu may select only one render node' >&2
        exit 2
      fi
      gpu_node="$2"
      shift 2
      ;;
    --) shift; break ;;
    *) break ;;
  esac
done
[ "$#" -gt 0 ] || { echo 'runtime-test: missing command' >&2; exit 2; }
devices=()
if [ "$allow_kvm" -eq 1 ]; then
  # Fail loudly rather than run the guest without the device it asked for.
  if [ ! -c /dev/kvm ] || [ ! -r /dev/kvm ] || [ ! -w /dev/kvm ]; then
    echo 'runtime-test: --allow-kvm given but /dev/kvm is absent or not read-write for this user' >&2
    exit 1
  fi
  devices+=(--dev-bind /dev/kvm /dev/kvm)
fi
if [ -n "$gpu_node" ]; then
  for device in /dev/kfd "$gpu_node"; do
    if [ ! -c "$device" ] || [ ! -r "$device" ] || [ ! -w "$device" ] \
      || [ "$(readlink -f -- "$device")" != "$device" ]; then
      echo "runtime-test: --allow-gpu requires a read-write character device at $device (no symlinks)" >&2
      exit 1
    fi
  done
  devices+=(--dev-bind /dev/kfd /dev/kfd --dir /dev/dri --dev-bind "$gpu_node" "$gpu_node")
fi
command -v bwrap >/dev/null || { echo 'runtime-test: bubblewrap is required' >&2; exit 1; }

# Mask the real PATH as well as changing the environment: tests sometimes
# hardcode /run/user/<uid>. A fresh procfs also hides host /proc/<pid>/root.
# Never derive a cleanup target from the inherited XDG_RUNTIME_DIR.
runtime="/run/user/$(id -u)"
exec bwrap --die-with-parent --unshare-user --unshare-pid --unshare-ipc \
  --bind / / --proc /proc --dev /dev "${devices[@]}" --tmpfs /run/user --dir "$runtime" \
  --chmod 0700 "$runtime" --setenv XDG_RUNTIME_DIR "$runtime" \
  --unsetenv DBUS_SESSION_BUS_ADDRESS --unsetenv DBUS_SESSION_BUS_PID \
  --unsetenv NOTIFY_SOCKET --unsetenv WATCHDOG_PID --unsetenv WATCHDOG_USEC \
  --unsetenv WAYLAND_DISPLAY --unsetenv DISPLAY --unsetenv SWAYSOCK \
  --unsetenv I3SOCK \
  --unsetenv SSH_AUTH_SOCK --unsetenv PULSE_SERVER \
  -- "$@"
