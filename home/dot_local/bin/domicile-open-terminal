#!/usr/bin/env python3
"""NAS-side fixed Kitty launch for a DSH workflow; no terminal/session attachment."""
import argparse
import ipaddress
import json
from pathlib import Path
import re
import shlex
import subprocess
import sys


def command(registry, desktop, cwd):
    if not re.fullmatch(r"[a-z][a-z0-9-]{0,63}", desktop):
        raise ValueError("invalid desktop identity")
    record = registry["desktops"][desktop]
    peer = ipaddress.ip_address(record["tailnetIp"])
    if peer not in ipaddress.ip_network("100.64.0.0/10"):
        raise ValueError("explicit Tailnet address required")
    for key in ("sshAlias", "hostKeyAlias"):
        if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]*", record[key]):
            raise ValueError("invalid trusted SSH alias")
    helper = record["terminalLauncher"]
    if not isinstance(helper, str) or not helper.startswith("/") or any(c in helper for c in "\r\n\0"):
        raise ValueError("explicit installed terminal launcher required")
    if not Path(cwd).is_absolute() or any(ord(c) < 32 or ord(c) == 127 for c in cwd):
        raise ValueError("absolute NAS project path without control characters required")
    prefix = ["ssh"]
    if "sshConfig" in record:
        config = Path(record["sshConfig"])
        import os, stat
        info = config.lstat()
        if not config.is_absolute() or not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o600:
            raise ValueError("owned regular mode0600 SSH config required")
        prefix += ["-F", str(config)]
    return prefix + ["-T", "-oBatchMode=yes", "-oStrictHostKeyChecking=yes", "-oConnectTimeout=5",
        "-oConnectionAttempts=1", "-oClearAllForwardings=yes", "-oForwardAgent=no",
        "-oControlMaster=no", "-oControlPath=none", "-oControlPersist=no",
        f"-oHostName={peer}", f"-oHostKeyAlias={record['hostKeyAlias']}", record["sshAlias"],
        shlex.join([helper, desktop, "--cwd", cwd])]


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--registry", required=True, type=Path)
    parser.add_argument("--desktop", required=True)
    parser.add_argument("--cwd", required=True)
    args = parser.parse_args()
    try:
        argv = command(json.loads(args.registry.read_text()), args.desktop, args.cwd)
        result = subprocess.run(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, timeout=10, check=False)
        if result.returncode:
            sys.stderr.buffer.write(result.stderr)
            raise ValueError("launch refused or outcome unknown; inspect desktop before retrying")
        if len(result.stdout) > 4096:
            raise ValueError("oversized launch reply")
        reply = json.loads(result.stdout)
        if reply != {"ok": True, "desktop": args.desktop, "status": "launch-queued", "dshOwnedPty": False, "observedWindow": None}:
            raise ValueError("invalid launch acknowledgement")
        print(json.dumps(reply))
        return 0
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
        print(json.dumps({"ok": False, "desktop": args.desktop, "status": "unavailable-or-unknown",
                          "error": str(error), "retryAutomatically": False}))
        return 2


if __name__ == "__main__":
    sys.exit(main())
