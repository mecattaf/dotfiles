#!/usr/bin/env bash
# wallpaper -- set desktop wallpaper
# Uses swaybg. Home Manager deploys the default repository wallpaper to
# ~/.local/share/wallpapers; this script re-points it at runtime.
DEFAULT="$HOME/.local/share/wallpapers/wallpaper.jpg"
path="${1:-$DEFAULT}"

if [[ ! -f "$path" ]]; then
    echo "File not found: $path" >&2
    exit 1
fi

pkill -x swaybg
setsid -f swaybg -i "$path" -m fill
