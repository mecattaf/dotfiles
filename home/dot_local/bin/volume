#!/usr/bin/env bash
# volume -- PipeWire volume control via wpctl
# Uses PipeWire directly.
case "$1" in
    up)    wpctl set-volume @DEFAULT_AUDIO_SINK@ 3%+ ;;
    down)  wpctl set-volume @DEFAULT_AUDIO_SINK@ 3%- ;;
    mute)  wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
    # The Duo's own XF86AudioMicMute key (niri binds it on the client) has one
    # script to call, same as the three sink verbs above.
    micmute) wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle ;;
    *)     echo "Usage: $0 {up|down|mute|micmute}"; exit 1 ;;
esac
