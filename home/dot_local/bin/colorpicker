#!/usr/bin/env bash
# colorpicker -- pick a color from screen, copy its hex to the clipboard (Mod+C)
#
# scroll: the grim + slurp picker of the Hyprland/sway/scroll eras (adi1090x,
# bound to $mod+C until 2026-09-11), minus its ImageMagick step, swatch and
# notification (no convert, notify-send or notification daemon on the fleet).
# slurp -p picks a point; grim captures it at the output's NATIVE scale (no -s:
# downscaling at scale 2 would Lanczos-blend neighbouring pixels) in binary PPM,
# whose header grim always writes as "P6\nW H\n255\n" (write_ppm.c). The first
# three bytes after it are the exact pixel's R, G, B. On niri (the rollback,
# NIRI_SOCKET set and SCROLLSOCK not) it stays `niri msg pick-color`.
set -euo pipefail

if [ -n "${SCROLLSOCK:-}" ] || [ -z "${NIRI_SOCKET:-}" ]; then
    point="$(slurp -p)" || exit 0
    hex="#$(grim -g "$point" -t ppm - | { read -r _; read -r _; read -r _; head -c 3; } | od -An -tx1 | tr -d ' \n')"
else
    output=$(niri msg pick-color) || exit 1
    hex=$(echo "$output" | grep -oP '#[0-9a-f]{6}')
fi
[[ "$hex" =~ ^#[0-9a-f]{6}$ ]] || { echo "colorpicker: could not read a colour" >&2; exit 1; }
# The clipboard is the whole job.
printf '%s' "$hex" | wl-copy
