#!/usr/bin/env python3
"""Native Imagine menus over the original paired-route and call-record commands.

One request on stdin, one bounded JSON reply. Device facts and recording state
stay on the audio seat; no terminal, menu program, timer or resident service.
"""
import datetime
import json
import subprocess
import sys
import time
from collections import Counter
from pathlib import Path


def run(*command, timeout=None):
    sibling = Path(__file__).resolve().parent / command[0]
    if sibling.is_file():
        command = (str(sibling), *command[1:])
    result = subprocess.run(command, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=timeout)
    if result.returncode:
        raise RuntimeError((result.stderr.strip() or result.stdout.strip())[-3000:]
                           or f"{command[0]} exited with status {result.returncode}")
    return result.stdout


def audio_routes():
    return json.loads(run("audio-route", "list", timeout=7))["choices"]


def battery_readings():
    routes = [route for route in audio_routes() if route["id"].startswith("airpods:")
              and route.get("connected", True)]
    models = Counter(route.get("modelId") for route in routes)
    readings = []
    for route in routes[:4]:
        entry = {"id": route["id"], "label": route["label"].split(" + ")[0]}
        if models[route.get("modelId")] > 1:
            entry["detail"] = "Battery unknown: more than one connected pair of this model."
        else:
            try:
                command = ["podpower"]
                if route.get("modelId"):
                    command += ["--model-id", route["modelId"]]
                result = json.loads(run(*command, timeout=7))
                components = {item["name"]: item for item in result["components"]}
                names = ("headphones",) if result["type"] == "over_ear" else ("left", "right", "case")
                parts = []
                for name in names:
                    item = components.get(name, {})
                    percent = item.get("battery")
                    value = f"≈{percent}%" if type(percent) is int and 0 <= percent <= 100 else "unknown"
                    parts.append(f"{name.capitalize()} {value}" + (" charging" if item.get("charging") else ""))
                entry.update(detail=" · ".join(parts), sampledAt=time.time(), approximate=True)
            except (OSError, ValueError, KeyError, TypeError, RuntimeError, subprocess.SubprocessError):
                entry["detail"] = "Battery unavailable. Open the case nearby, then refresh."
        readings.append(entry)
    return readings


def handle(request):
    action = request.get("action")
    if action == "audio-menu":
        choices = audio_routes()
        return {"choices": choices, "detail": "Choose an output and microphone together." if choices
                else "No complete audio pair is connected. Check the camera or laptop microphone."}
    if action == "audio-battery":
        return {"readings": battery_readings()}
    if action == "audio-select":
        route = request.get("route")
        if route not in [entry["id"] for entry in audio_routes()]:
            raise ValueError("Unknown audio pair")
        return {"message": run("audio-route", route).strip()}
    if action == "recording-menu":
        status = json.loads(run("call-record", "status", "--json"))
        recording = status["state"] in ("recording", "interrupted")
        choices = ([{"id": "stop", "label": "Stop and save", "detail": status["session"]}] if recording
                   else [{"id": "start", "label": "Start recording", "detail": "Capture the current output and microphone"}]
                   if status["state"] == "idle" else [])
        return {"choices": choices, "detail": status["detail"]}
    if action == "recording-start":
        # Match the old Shift+F9 controller, with enough precision to avoid
        # overwriting a stopped session started in the same second.
        slug = "call-" + datetime.datetime.now().strftime("%H%M%S-%f")
        run("call-record", "start", slug)
        return {"message": "Recording started. Shift+F9 opens Stop and save."}
    if action == "recording-stop":
        output = run("call-record", "stop")
        # Includes the actual NAS handoff or retained-local-copy result, never
        # infer a successful upload merely from the recorder having stopped.
        return {"message": output.strip()[-3000:] or "Recording stopped."}
    raise ValueError("Unknown audio control action")


def main():
    try:
        data = sys.stdin.buffer.read(4097)
        if len(data) > 4096:
            raise ValueError("Audio control request is too large")
        request = json.loads(data)
        if not isinstance(request, dict):
            raise ValueError("Expected an audio control request")
        reply = {"ok": True, **handle(request)}
    except (OSError, ValueError, KeyError, TypeError, RuntimeError, subprocess.SubprocessError) as error:
        reply = {"ok": False, "message": str(error)[:3000]}
    print(json.dumps(reply))


if __name__ == "__main__":
    main()
