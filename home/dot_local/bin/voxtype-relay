#!/usr/bin/env bash
# voxtype-relay [--cancel] -- the COORDINATOR half of client dictation (#376,
# route b'). The client's `dictate-hold` runs this as ONE ssh command per press:
#
#   pw-record ... - | ssh coordinator voxtype-relay      (stdout = transcript)
#
# stdin   raw s16le, 16 kHz, mono, from the client's PipeWire default source
#         (whatever the Shift+F9 Audio Route picker selected), until EOF.
# stdout  the transcript, exactly once, no trailing newline; empty when nothing
#         was recognised.
# stderr  one-line reasons; exit 3 = voxtype daemon down, 4 = another dictation
#         is in flight, 5 = transcript timeout.
#
# HOW. `voxtype record start --file=PATH` arms the running daemon (SIGUSR1
# plus an output_mode_override file, voxtype src/app/record.rs:22-40), the audio
# is played into the `client-mic` loopback sink declared in home/voxtype.nix,
# whose source side is the daemon's input (PIPEWIRE_NODE on the unit), and on
# EOF `voxtype record stop` makes the daemon transcribe and write PATH
# (src/daemon.rs:2095-2130). Batch TDT, not streaming: the streaming chain
# never reads the --file override (daemon.rs:915 builds its chain from
# config.output) and every output driver needs a display or uinput the
# headless coordinator does not have (DECISIONS 2026-09-13, #376).
#
# ONE ssh session per press, no ControlMaster: home/ssh.nix records option (B),
# no fleet-wide master; a single connection costs one ~200 ms handshake.
#
# If the ssh link drops mid-press, sshd hangs up this script: the trap cancels
# the recording so the daemon is never left armed.
set -euo pipefail

runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
sink="${VOXTYPE_RELAY_SINK:-client-mic}"
state_file="$runtime/voxtype/state"
timeout_s="${VOXTYPE_RELAY_TIMEOUT:-30}"
vt=(voxtype)
[ -n "${VOXTYPE_RELAY_CONFIG:-}" ] && vt+=(-c "$VOXTYPE_RELAY_CONFIG")

if [ "${1:-}" = "--cancel" ]; then
  "${vt[@]}" record cancel
  exit $?
fi

if [ -z "${VOXTYPE_RELAY_CONFIG:-}" ] && ! systemctl --user is-active --quiet voxtype; then
  echo "voxtype-relay: the voxtype daemon is not running on $(hostname)" >&2
  exit 3
fi

mkdir -p "$runtime/voxtype-relay"
exec 9>"$runtime/voxtype-relay/lock"
if ! flock -n 9; then
  echo "voxtype-relay: another dictation is in flight" >&2
  exit 4
fi

out="$runtime/voxtype-relay/$$.txt"
rm -f "$out"
armed=0
# shellcheck disable=SC2329 # invoked by the EXIT trap
cleanup() {
  if [ "$armed" = 1 ]; then
    "${vt[@]}" record cancel >/dev/null 2>&1 || true
  fi
  rm -f "$out"
}
trap cleanup EXIT
trap 'exit 130' HUP INT TERM PIPE

read_state() { cat "$state_file" 2>/dev/null || true; }

"${vt[@]}" record start --file="$out"
armed=1
# Wait for the capture to open before playing, so the first word is heard.
# The client's audio queues in the ssh pipe meanwhile; nothing is dropped.
for _ in $(seq 1 40); do
  [ "$(read_state)" = recording ] && break
  sleep 0.025
done

pw-cat --playback --raw --target "$sink" --rate 16000 --channels 1 --format s16 - || true
# The loopback adds a few tens of ms; let the tail reach the capture.
sleep 0.2

# Cancelled while the audio flowed (`dictate-hold --cancel` runs `voxtype-relay
# --cancel` over a second ssh session, then hangs this one up)? The daemon is
# already idle and will write nothing: leave now instead of waiting out the
# timeout with the lock held.
if [ "$(read_state)" != recording ]; then
  armed=0
  exit 0
fi

"${vt[@]}" record stop
armed=0

# The daemon writes PATH only for a non-empty transcript; an empty one returns
# it to idle with no file. Either ends the wait.
deadline=$((SECONDS + timeout_s))
seen_busy=0
while [ "$SECONDS" -lt "$deadline" ]; do
  if [ -s "$out" ]; then
    printf '%s' "$(cat "$out")"
    exit 0
  fi
  s="$(read_state)"
  if [ "$s" != idle ]; then
    seen_busy=1
  elif [ "$seen_busy" = 1 ]; then
    # back to idle: give a racing write one more beat
    sleep 0.1
    [ -s "$out" ] && printf '%s' "$(cat "$out")"
    exit 0
  fi
  sleep 0.05
done
echo "voxtype-relay: no transcript within ${timeout_s}s" >&2
exit 5
