#!/usr/bin/env python3
"""Local control; one explicit NAS selection before each remote view.

Herdr's pinned public API cannot target a new client. Never create/focus a
workspace over that API to guess where a later client will attach.
"""
import os
import signal
from pathlib import Path
import subprocess
import sys
import termios
import tomllib

# Resolve siblings beside the invoked link, not its individual Nix store target.
HERE = Path(os.path.abspath(sys.argv[0])).parent
CONTEXT = ("HERDR_ENV", "HERDR_SOCKET_PATH", "HERDR_CLIENT_SOCKET_PATH", "HERDR_SESSION",
           "HERDR_WORKSPACE_ID", "HERDR_TAB_ID", "HERDR_PANE_ID", "HERDR_TERMINAL_ID")


def clean_environment():
    return {k: v for k, v in os.environ.items() if k not in CONTEXT}


def local_shell():
    print("Local rescue shell. This shell does not need NAS. Exit to close it.", flush=True)
    os.execvpe("fish", ["fish", "--no-config"], clean_environment())


def desktop_client_config(env):
    # The trial launcher may supply a trusted store-backed TOML without moving
    # XDG_CONFIG_HOME (which would also move unrelated application profiles).
    if "DOMICILE_DESKTOP_CLIENT_CONFIG" in env:
        selected = env["DOMICILE_DESKTOP_CLIENT_CONFIG"]
        if not selected or not Path(selected).is_absolute():
            raise ValueError("DOMICILE_DESKTOP_CLIENT_CONFIG must be an absolute file path")
        path = Path(selected)
    else:
        path = Path(env.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "herdr/desktop-client.toml"
    try:
        if not path.is_file():
            raise ValueError(f"desktop client config must be a readable regular TOML file: {path}")
        with path.open("rb") as source:
            tomllib.load(source)
    except OSError:
        raise ValueError(f"cannot read desktop client config: {path}") from None
    except (tomllib.TOMLDecodeError, UnicodeError):
        raise ValueError(f"desktop client config is not valid TOML: {path}") from None
    return str(path)


def discard_typeahead():
    termios.tcflush(sys.stdin.fileno(), termios.TCIFLUSH)


def prompt(text):
    print(text, end="", flush=True)
    # Do not buffer additional lines in Python: they must stay in the terminal
    # queue so tcflush can discard them at each local/remote boundary.
    line = bytearray()
    while True:
        byte = os.read(sys.stdin.fileno(), 1)
        if not byte:
            return None
        if byte == b"\n":
            return line.decode("utf-8", errors="replace").rstrip("\r")
        line.extend(byte)


def gate(args):
    # HERDR_BIN child: validate the menu's destination before exec, preserving
    # the projector child's PID for its existing SSH/socket cleanup.
    if args != ["--remote", "nas", "--remote-keybindings", "server"]:
        print("Refusing unexpected Herdr arguments.", file=sys.stderr)
        return 2
    if os.environ.get("DOMICILE_HERDR_ATTACH") != "1":
        print("Open terminal control and select nas before attaching.", file=sys.stderr)
        return 2
    env = clean_environment()
    env.pop("DOMICILE_HERDR_ATTACH", None)
    try:
        env["HERDR_CONFIG_PATH"] = desktop_client_config(env)
    except ValueError as error:
        print(f"domicile-terminal: {error}", file=sys.stderr)
        return 2
    # Also discard anything typed while the SSH unit preflight was in progress.
    discard_typeahead()
    os.execvpe("herdr", ["herdr", *args], env)


def main():
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        print("domicile-terminal: interactive terminal required; refusing attachment", file=sys.stderr)
        return 2
    args = sys.argv[1:]
    if args == ["--local"]:
        local_shell()
    if args[:1] == ["--remote-attempt"]:
        return gate(args[1:])
    if args:
        return 2
    while True:
        print("\nTerminal control — LOCAL\n"
              "local  Open a local rescue shell (works without NAS)\n"
              "nas    Attach to NAS Herdr\n"
              "quit   Close this window\n\n"
              "NAS opens an EXISTING workspace/pane, which may be Claude.\n"
              "After selecting nas, ordinary keys go to that displayed remote pane.\n"
              "Herdr: Ctrl+B then Shift+N creates a fresh shell; Ctrl+B then Q detaches.\n"
              "A lost link returns here for a new selection.\n"
              "Ordinary text here stays in this local menu.", flush=True)
        answer = prompt("local / nas / quit > ")
        if answer in (None, "quit"):
            return 0
        if answer == "local":
            local_shell()
        if answer != "nas":
            print("No action. Enter local, nas or quit.", flush=True)
            continue
        discard_typeahead()
        env = clean_environment()
        try:
            # Fail locally before SSH, then revalidate in the exec adapter.
            env["HERDR_CONFIG_PATH"] = desktop_client_config(env)
        except ValueError as error:
            print(f"domicile-terminal: {error}; staying at LOCAL control.", file=sys.stderr)
            continue
        env["HERDR_PROJECTOR_TARGET"] = "nas"
        env.pop("HERDR_PROJECTOR_UNIT", None)  # retain production unit preflight
        env["HERDR_BIN"] = str(HERE / "herdr-domicile-client")
        env["DOMICILE_HERDR_ATTACH"] = "1"
        env["HERDR_PROJECTOR_RECONNECT"] = "0"
        print("Checking NAS. Ctrl+C returns to this local menu.", flush=True)
        child = subprocess.Popen([str(HERE / "herdr-projector")], env=env)
        try:
            status = child.wait()
        except KeyboardInterrupt:
            child.send_signal(signal.SIGTERM)
            status = child.wait()
        discard_typeahead()
        print(f"Remote view ended (status {status}); back at LOCAL control.", flush=True)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        raise SystemExit(0)
