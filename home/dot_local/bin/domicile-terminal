#!/usr/bin/env python3
"""Local control; explicit consent before each existing remote view.

Herdr's pinned public API cannot target a new client. Never create/focus a
workspace over that API to guess where a later client will attach.
"""
import os
import signal
from pathlib import Path
import subprocess
import sys
import termios

# Resolve siblings beside the invoked link, not its individual Nix store target.
HERE = Path(os.path.abspath(sys.argv[0])).parent
CONTEXT = ("HERDR_ENV", "HERDR_SOCKET_PATH", "HERDR_CLIENT_SOCKET_PATH", "HERDR_SESSION",
           "HERDR_WORKSPACE_ID", "HERDR_TAB_ID", "HERDR_PANE_ID", "HERDR_TERMINAL_ID")


def clean_environment():
    return {k: v for k, v in os.environ.items() if k not in CONTEXT}


def local_shell():
    print("Local rescue shell. This shell does not need NAS. Exit to close it.", flush=True)
    os.execvpe("fish", ["fish", "--no-config"], clean_environment())


def prompt(text):
    print(text, end="", flush=True)
    line = sys.stdin.readline()
    return None if not line else line.rstrip("\r\n")


def gate(args):
    # HERDR_BIN for the unchanged projector; validate its complete argv.
    if args != ["--remote", "nas", "--remote-keybindings", "server"]:
        print("Refusing unexpected Herdr arguments.", file=sys.stderr)
        return 2
    print("\nNAS attachment: opens an EXISTING remote workspace.\n"
          "Ordinary keys after attachment go to its displayed pane, which may run Claude.\n"
          "To make a fresh shell, use Herdr's own Ctrl+B then Shift+N;\n"
          "Ctrl+B then W selects a workspace; Ctrl+B then Q detaches.\n"
          "This launcher cannot safely choose a fresh remote workspace for you.\n"
          "Reconnects ask again. Any other answer returns to local control.", flush=True)
    if prompt("Type ATTACH nas to open that remote view: ") != "ATTACH nas":
        return 0  # deliberate end; projector must not retry a declined view
    # Discard type-ahead. Herdr then reads the terminal directly.
    termios.tcflush(sys.stdin.fileno(), termios.TCIFLUSH)
    env = clean_environment()
    env["HERDR_CONFIG_PATH"] = str(Path(env.get("XDG_CONFIG_HOME", str(Path.home() / ".config")))
                                   / "herdr/desktop-client.toml")
    if not Path(env["HERDR_CONFIG_PATH"]).is_file():
        print("Missing desktop-client.toml; import modules/domicile-apps.nix first.", file=sys.stderr)
        return 2
    os.execvpe("herdr", ["herdr", *args], env)


def main():
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        print("domicile-terminal: interactive terminal required; refusing attachment", file=sys.stderr)
        return 2
    args = sys.argv[1:]
    if args == ["--local"]:
        local_shell()
    if args[:1] == ["--remote-attempt"]:
        return gate(args[1:])
    if args:
        return 2
    while True:
        print("\nTerminal control — LOCAL\n"
              "local  Open a local rescue shell (works without NAS)\n"
              "nas    Request a NAS Herdr view (existing workspace; asks first)\n"
              "quit   Close this window\n"
              "Ordinary text here stays in this local menu.", flush=True)
        answer = prompt("local / nas / quit > ")
        if answer in (None, "quit"):
            return 0
        if answer == "local":
            local_shell()
        if answer != "nas":
            print("No action. Enter local, nas or quit.", flush=True)
            continue
        env = clean_environment()
        env["HERDR_PROJECTOR_TARGET"] = "nas"
        env.pop("HERDR_PROJECTOR_UNIT", None)  # retain production unit preflight
        env["HERDR_BIN"] = str(HERE / "herdr-domicile-client")
        print("Checking NAS. Ctrl+C returns to this local menu if the link is unavailable.", flush=True)
        child = subprocess.Popen([str(HERE / "herdr-projector")], env=env)
        try:
            status = child.wait()
        except KeyboardInterrupt:
            child.send_signal(signal.SIGTERM)
            status = child.wait()
        print(f"Remote view ended (status {status}); back at LOCAL control.", flush=True)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        raise SystemExit(0)
