#!/usr/bin/env bash
# Native Sway workspace operations, with durable Herdr projector parking.
set -euo pipefail
case "${1:-}" in
  new|close|detach|rename|restore) ;;
  *) echo 'usage: sway-workspace <new|close|detach|rename|restore>' >&2; exit 2 ;;
esac
# The sibling sits beside the link, not beside its store target (see herdr-chord).
exec "$(dirname "$0")/herdr-picker" --workspace "$1"
