#!/usr/bin/env bash
# l8-flash-probe — did the one dotfiles switch land? (dotfiles#301)
#
# Run on EACH box after `nixos-rebuild switch`. One line per check: PASS, FAIL,
# SKIP or UNKNOWN, always with the argv that produced it, so the output is its
# own receipt. Exit 0 iff every APPLICABLE check passed; a check that does not
# apply to this host is SKIP and does not fail the run. UNKNOWN is a check this
# box could not take (the worker's systemd out of reach): it is counted in the
# summary, it does not fail the run, and it is not a receipt for that row.
#
# set -u but deliberately NOT set -e: every check must run even after one
# fails. A probe that stops at the first failure tells you one thing; this one
# tells you everything.
set -u

# Which checkout SECTION 3's greps read, and nothing else. Overridable because
# the default tree only carries this branch after it merges.
DOTFILES="${L8_FLASH_DOTFILES:-/home/tom/mecattaf/dotfiles}"
# Where every RAW dotfile actually lives, and it is NOT overridable:
# home/home.nix:15 hardcodes repoDir = "$HOME/mecattaf/dotfiles" and anchors
# every out-of-store symlink there, whatever checkout the switch was taken from
# (dotfiles#313). Any check that RESOLVES a symlink must compare against this.
REPO_DIR="$HOME/mecattaf/dotfiles"
# The host this probe is running on. The override exists for ONE reader: the
# committed test in tests/l8-flash-probe/, which must be able to exercise a
# coordinator-only row on any box and inside the nix sandbox. Nothing on a
# real box sets it, and a probe run with it set is a test run, not evidence.
HOST="${L8_FLASH_HOST:-$(hostname)}"
COORDINATOR="coordinator"
# The box that serves inference: the Halogen Flash server's podman unit lives
# there (modules/halogen.nix), and `worker` resolves from every host.
WORKER="worker"

pass=0
fail=0
skip=0
unknown=0

report() { # $1 = verdict, $2 = name, $3.. = argv
  local verdict="$1" name="$2"
  shift 2
  printf '%-7s  %-48s  %s\n' "$verdict" "$name" "$*"
}

ok() {
  pass=$((pass + 1))
  report PASS "$@"
}
no() {
  fail=$((fail + 1))
  report FAIL "$@"
}
na() {
  skip=$((skip + 1))
  report SKIP "$@"
}
unk() {
  unknown=$((unknown + 1))
  report UNKNOWN "$@"
}

coordinator_only() { [ "$HOST" = "$COORDINATOR" ]; }

# FragmentPath as systemd PRINTS it, resolved to what it POINTS AT. A declared
# unit's fragment is almost never a bare store path: home-manager links its
# fragment into ~/.config/systemd/user and NixOS links system units into
# /etc/systemd/system, and systemd reports the LINK it loaded, not the target.
# Measured on both buses (dotfiles#331):
#   systemctl --user show tally-daemon.service -p FragmentPath
#     -> /home/tom/.config/systemd/user/tally-daemon.service   (a symlink)
#   systemctl show tally-kernel.service -p FragmentPath
#     -> /etc/systemd/system/tally-kernel.service              (a symlink)
#      readlink -f -> /nix/store/...-unit-tally-kernel.service/tally-kernel.service
# So classifying the printed string against /nix/store/* calls every declared
# unit hand-installed. Resolve first, classify second. A HAND-INSTALLED unit is
# a plain file: it resolves to itself, stays outside the store, and still FAILs
# — which is the whole point of the row.
resolve_fragment() { # $1 = FragmentPath as printed; echoes what it resolves to
  local raw="$1" resolved
  [ -n "$raw" ] || return 0
  # -f, and a fallback: readlink -f prints nothing if the target's directory is
  # gone (a stale link into a garbage-collected store), and a stale link must be
  # classified on the string it still has rather than vanish into the empty
  # case, whose message says "the unit does not exist".
  resolved="$(readlink -f "$raw" 2>/dev/null || true)"
  printf '%s' "${resolved:-$raw}"
}

# Whole-token match against `tally query pools` output. NOT `grep -w`: a
# hyphen is a non-word character, so `grep -w codex` matches inside
# "codex-window" and would report the retired mutex as the new seat row. The
# delimiter class here includes the hyphen for exactly that reason.
names_pool() { # $1 = haystack, $2 = pool name
  printf '%s\n' "$1" | grep -qE "(^|[^A-Za-z0-9_-])$2([^A-Za-z0-9_-]|\$)"
}

echo "l8-flash-probe on $HOST (greps read $DOTFILES; symlinks resolve into $REPO_DIR)"
echo
# READ A GREEN RUN CORRECTLY. Not every check can only pass after the switch;
# some are already true on this box before it, and a few land with the TREE
# rather than with the rebuild (home/home.nix:15 anchors every raw dotfile at
# $REPO_DIR — dotfiles#313). Each check says which it is:
#
#   [E] switch-evidence — can only PASS after `nixos-rebuild switch` on THIS
#       box. These are what "the switch landed" means.
#   [P] pre-condition   — already true beforehand, or delivered by updating
#       $REPO_DIR to carry this branch. A PASS here is NOT evidence of a
#       switch; a FAIL here means the tree was not delivered, which is the
#       failure that makes the [E] checks lie.
echo "[E] switch-evidence: passes only after the rebuild on this box"
echo "[P] pre-condition:   true before it, or delivered with the tree at $REPO_DIR"
echo

# ── 1. the pool rows tally actually serves ──────────────────────────────────
# `tally query pools` is the pin's own verb (doc/src/operating/cli.md,
# "Producers, pools, render, and stand-up"). The daemon runs on the
# coordinator only, so this is where the rows can be READ; the file checks
# below run everywhere.
if coordinator_only; then
  if pools_out="$(tally query pools 2>&1)"; then
    for want in cc cc2 cc3 codex pi coordinator-gpu worker-gpu; do
      if names_pool "$pools_out" "$want"; then
        ok "[E] pool present: $want" "tally query pools | names_pool $want"
      else
        no "[E] pool present: $want" "tally query pools | names_pool $want"
      fi
    done
    for gone in codex-window claude-window; do
      if names_pool "$pools_out" "$gone"; then
        no "[E] pool retired: $gone" "tally query pools | names_pool $gone"
      else
        ok "[E] pool retired: $gone" "tally query pools | names_pool $gone"
      fi
    done
  else
    no "[E] tally query pools answers" "tally query pools"
  fi
else
  na "[E] tally pool rows (coordinator only)" "tally query pools"
fi

# ── 2. the meters directory the module now creates ──────────────────────────
# Existence alone stopped being evidence on 2026-09-06, when something else on
# the box created the directory 0755 before this branch ever switched. The
# MODE is what only the declared rule produces: systemd-tmpfiles `d ... 0700`
# both creates the directory and chmods an existing one, so 0700 is the switch,
# and 0755 is somebody's mkdir -p.
if coordinator_only; then
  mode="$(stat -c '%a' "$HOME/.local/state/tally/meters" 2>/dev/null)"
  if [ "$mode" = "700" ]; then
    ok "[E] meters dir 0700" "stat -c %a ~/.local/state/tally/meters"
  else
    no "[E] meters dir 0700 (got '$mode')" "stat -c %a ~/.local/state/tally/meters"
  fi
else
  na "[E] meters dir (coordinator only)" "stat -c %a ~/.local/state/tally/meters"
fi

# ── 3. the retired pin, by absence ──────────────────────────────────────────
# Both greps must find NOTHING. This is the switch's own oracle: the pin is
# gone when its commit id and both retired pool names are absent from the file
# that used to carry them.
tallynix="$DOTFILES/home/tally.nix"
if [ -r "$tallynix" ]; then
  if grep -n c5eb4510 "$tallynix" >/dev/null 2>&1; then
    no "[P] pin absent from tally.nix" "grep -n c5eb4510 $tallynix"
  else
    ok "[P] pin absent from tally.nix" "grep -n c5eb4510 $tallynix"
  fi
  if grep -nE 'codex-window|claude-window' "$tallynix" >/dev/null 2>&1; then
    no "[P] window mutexes absent" "grep -nE 'codex-window|claude-window' $tallynix"
  else
    ok "[P] window mutexes absent" "grep -nE 'codex-window|claude-window' $tallynix"
  fi
else
  no "[P] tally.nix readable" "test -r $tallynix"
fi

# ── 4. the fleet's one inference serve: podman-halogen on the WORKER ────────
# The coordinator serves nothing; the Halogen Flash server is the worker's
# podman-halogen.service (modules/halogen.nix), declared Restart=on-failure so
# the engine's own watchdog exit is recovered. The unit is read on the worker's
# own system bus: directly when this probe runs there, over `ssh worker`
# otherwise. A box that cannot reach that bus reports UNKNOWN with the reason —
# a row nobody measured is not a FAIL, and it is not a PASS either.
HALOGEN_UNIT="podman-halogen.service"
halogen_ctl=()
halogen_via=""
if [ "$HOST" = "$WORKER" ]; then
  halogen_ctl=(systemctl)
  halogen_via="systemctl"
elif command -v ssh >/dev/null 2>&1; then
  halogen_ctl=(ssh -o BatchMode=yes -o ConnectTimeout=5 "$WORKER" systemctl)
  halogen_via="ssh $WORKER systemctl"
fi
if [ -z "$halogen_via" ]; then
  unk "[P] $HALOGEN_UNIT active on $WORKER (no ssh on this box)" "ssh $WORKER systemctl is-active $HALOGEN_UNIT"
  unk "[P] $HALOGEN_UNIT Restart=on-failure (no ssh on this box)" "ssh $WORKER systemctl show $HALOGEN_UNIT -p Restart"
else
  state="$("${halogen_ctl[@]}" is-active "$HALOGEN_UNIT" 2>/dev/null)"
  rc=$?
  if [ "$HOST" != "$WORKER" ] && [ "$rc" -eq 255 ]; then
    # 255 is ssh's own exit for a connection it could not make; systemctl
    # never returns it. The worker is unreachable, so nothing was measured.
    unk "[P] $HALOGEN_UNIT active on $WORKER ($WORKER unreachable over ssh)" "$halogen_via is-active $HALOGEN_UNIT"
    unk "[P] $HALOGEN_UNIT Restart=on-failure ($WORKER unreachable over ssh)" "$halogen_via show $HALOGEN_UNIT -p Restart"
  else
    if [ "$state" = "active" ]; then
      ok "[P] $HALOGEN_UNIT active on $WORKER" "$halogen_via is-active $HALOGEN_UNIT"
    else
      no "[P] $HALOGEN_UNIT active on $WORKER (got '$state')" "$halogen_via is-active $HALOGEN_UNIT"
    fi
    restart="$("${halogen_ctl[@]}" show "$HALOGEN_UNIT" -p Restart 2>/dev/null)"
    if [ "$restart" = "Restart=on-failure" ]; then
      ok "[P] $HALOGEN_UNIT Restart=on-failure" "$halogen_via show $HALOGEN_UNIT -p Restart"
    else
      no "[P] $HALOGEN_UNIT Restart=on-failure (got '$restart')" "$halogen_via show $HALOGEN_UNIT -p Restart"
    fi
  fi
fi

# ── 5. the two user timers, and the DECLARED units behind them ──────────────
# `active` alone is NOT evidence for the mirror: the hand-written timer this PR
# replaces (dotfiles#293) is active on the coordinator today, and it would stay
# active — green here — while the declared service failed on fire. So each
# timer is checked twice. A home-manager unit's fragment lives in /nix/store
# and is linked into ~/.config/systemd/user; a hand-written unit IS the plain
# file there. FragmentPath is therefore the one field that says which of the
# two won the name.
for timer in claude-transcript-mirror.timer nightly-record.timer; do
  # The mirror's timer can be active from the hand-written unit, so `active` is
  # a pre-condition there; nightly-record has no hand-written ancestor, so its
  # timer existing at all is evidence. The fragment check below is evidence for
  # both.
  case "$timer" in
    claude-transcript-mirror.timer) active_tag="[P]" ;;
    *) active_tag="[E]" ;;
  esac
  if coordinator_only; then
    if systemctl --user is-active --quiet "$timer"; then
      ok "$active_tag $timer active" "systemctl --user is-active $timer"
    else
      no "$active_tag $timer active" "systemctl --user is-active $timer"
    fi
    raw="$(systemctl --user show "$timer" -p FragmentPath --value 2>/dev/null)"
    frag="$(resolve_fragment "$raw")"
    case "$frag" in
      /nix/store/*)
        ok "[E] $timer declared (fragment resolves into /nix/store)" "readlink -f \$(systemctl --user show $timer -p FragmentPath --value)"
        ;;
      *)
        no "[E] $timer declared (fragment '$raw' -> '$frag')" "readlink -f \$(systemctl --user show $timer -p FragmentPath --value)"
        ;;
    esac
  else
    na "$active_tag $timer (coordinator only)" "systemctl --user is-active $timer"
    na "[E] $timer declared (coordinator only)" "systemctl --user show $timer -p FragmentPath"
  fi
done

# The declared service's ExecStart is %h/.local/bin/claude-transcript-mirror,
# and ~/.local/bin is an out-of-store symlink into $REPO_DIR — so the PROGRAM
# arrives with the raw tree, not with the switch (dotfiles#313). Unit present,
# program absent is exactly the half-delivery a switch taken from the wrong
# checkout produces, and it is silent: the timer is active, the service fails
# on fire, the mirror stops.
if coordinator_only; then
  if [ -x "$HOME/.local/bin/claude-transcript-mirror" ]; then
    ok "[P] mirror program executable" "test -x ~/.local/bin/claude-transcript-mirror"
  else
    no "[P] mirror program executable" "test -x ~/.local/bin/claude-transcript-mirror"
  fi
else
  na "[P] mirror program (coordinator only)" "test -x ~/.local/bin/claude-transcript-mirror"
fi

# ── 5b. the hand-written pair the declared units replace (#293, #319) ───────
# home-manager will not write over a plain file of the same name, so while
# ~/.config/systemd/user/claude-transcript-mirror.{service,timer} exist as
# ORDINARY FILES they win the name and the declaration in
# home/harness-records.nix:70 never takes effect — the switch reports success
# and the mirror keeps running from the untracked pair, which is Rule 9's exact
# failure. Their removal is P05 walkthrough step 4: Tom's own shell act
# (scopes/clean-dotfiles.md:171 §6), taken AFTER the tree carries the
# replacement and BEFORE the switch, because until the switch the hand-written
# pair is the only working mirror. It is sequenced inside U-D19 and carried as
# DEFERRED.md row DF-U-D16-1.
#
# [E], not [P]: a green row here means the deletion has happened. Before it
# this row is expected to FAIL, and that FAIL is the reminder.
if coordinator_only; then
  left=""
  for suffix in service timer; do
    unit="$HOME/.config/systemd/user/claude-transcript-mirror.$suffix"
    # -f, not -e: home-manager links its own fragment into this directory, and
    # a SYMLINK of that name is the declared unit having won. Only a plain file
    # is the hand-written pair.
    if [ -f "$unit" ] && [ ! -L "$unit" ]; then
      left="$left $suffix"
    fi
  done
  if [ -z "$left" ]; then
    ok "[E] hand-written pair gone" "test ! -f ~/.config/systemd/user/claude-transcript-mirror.{service,timer}"
  else
    no "[E] hand-written pair gone (still plain:$left)" "test ! -f ~/.config/systemd/user/claude-transcript-mirror.{service,timer}"
  fi
else
  na "[E] hand-written pair gone (coordinator only)" "test ! -f ~/.config/systemd/user/claude-transcript-mirror.{service,timer}"
fi

# ── 5c. the UTIL-01 timers, declared not hand-installed (#311, #320) ────────
# The two units home/util-sampler.nix declares. Rule 9 is stricter here than
# for the mirror: these timers have NEVER existed by hand, so there is no
# hand-written ancestor to lose the name to, and the only way either fragment
# can sit anywhere but /nix/store is somebody having hand-installed one. That
# is the failure this row is for.
#
# FragmentPath and nothing else. `is-active` is deliberately NOT checked: the
# sampler's timer carries OnBootSec=1min and the row writer's fires at 00:05,
# so a box rebooted a minute ago and a box that has never switched look the
# same through `is-active`, while FragmentPath separates them the instant the
# unit exists. Two rows, one per timer — the count matters: before the switch
# the probe must exit 1 with exactly these two additional FAIL rows on the
# coordinator and the same PASS rows it had before (#320).
#
# util-sampler.timer is declared on BOTH boxes (the sampler picks its own probe
# list and lease pool by hostname; no Nix conditional selects them), so its row
# runs everywhere. util-row.timer is coordinator-gated — it is the joiner that
# pulls the worker's log — so off the coordinator it is SKIP, never FAIL.
util_fragment_row() { # $1 = timer, $2 = "both" | "coordinator"
  local timer="$1" scope="$2" raw frag
  if [ "$scope" = "coordinator" ] && ! coordinator_only; then
    na "[E] $timer declared (coordinator only)" "systemctl --user show $timer -p FragmentPath"
    return
  fi
  raw="$(systemctl --user show "$timer" -p FragmentPath --value 2>/dev/null)"
  frag="$(resolve_fragment "$raw")"
  case "$frag" in
    /nix/store/*)
      ok "[E] $timer declared (fragment resolves into /nix/store)" "readlink -f \$(systemctl --user show $timer -p FragmentPath --value)"
      ;;
    *)
      no "[E] $timer declared (fragment '$raw' -> '$frag')" "readlink -f \$(systemctl --user show $timer -p FragmentPath --value)"
      ;;
  esac
}
util_fragment_row util-sampler.timer both
util_fragment_row util-row.timer coordinator

# ── 6. the cc3 links, resolved ──────────────────────────────────────────────
# Compared against $REPO_DIR, never $DOTFILES: these links can resolve nowhere
# but the hardcoded anchor in home/home.nix:15 (dotfiles#313), so pointing them
# at an overridden $L8_FLASH_DOTFILES reports two spurious FAILs. The override
# stays scoped to section 3, which is what its comment claims.
for leaf in settings.json skills; do
  target="$(readlink -f "$HOME/.claude-3/$leaf" 2>/dev/null)"
  case "$target" in
    "$REPO_DIR/home/dot_claude"/*)
      ok "[P] cc3 link resolves: $leaf" "readlink -f ~/.claude-3/$leaf"
      ;;
    *)
      no "[P] cc3 link resolves: $leaf (got '$target')" "readlink -f ~/.claude-3/$leaf"
      ;;
  esac
done

# ── 7. herdr: binaries everywhere, one server on the coordinator (ruling B5) ─
for binary in herdr hk; do
  if command -v "$binary" >/dev/null 2>&1; then
    ok "[E] $binary on PATH" "command -v $binary"
  else
    no "[E] $binary on PATH" "command -v $binary"
  fi
done
if coordinator_only; then
  if systemctl --user is-active --quiet herdr; then
    ok "[E] herdr server active" "systemctl --user is-active herdr"
  else
    no "[E] herdr server active" "systemctl --user is-active herdr"
  fi
else
  # NOT a failure on the worker: ruling B5 in home/herdr.nix puts ONE server on
  # the coordinator and the client binaries everywhere. See dotfiles#309.
  na "[E] herdr server (coordinator only, ruling B5)" "systemctl --user is-active herdr"
fi

# ── 8. cleanupPeriodDays, read from the seat that actually uses it ──────────
if cleanup="$(python3 - <<'PY' 2>/dev/null
import json, os, sys
path = os.path.expanduser("~/.claude/settings.json")
with open(path) as handle:
    print(json.load(handle).get("cleanupPeriodDays"))
PY
)"; then
  if [ "$cleanup" = "365" ]; then
    ok "[P] cleanupPeriodDays = 365" "python3 -c 'json ~/.claude/settings.json'"
  else
    no "[P] cleanupPeriodDays = 365 (got '$cleanup')" "python3 -c 'json ~/.claude/settings.json'"
  fi
else
  no "[P] cleanupPeriodDays readable" "python3 -c 'json ~/.claude/settings.json'"
fi

echo
echo "l8-flash-probe: $pass passed, $fail failed, $skip skipped, $unknown unknown on $HOST"
echo "  [E] = switch-evidence, [P] = pre-condition (see the legend above)"
[ "$fail" -eq 0 ]
