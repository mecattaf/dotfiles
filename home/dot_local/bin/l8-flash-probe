#!/usr/bin/env bash
# l8-flash-probe — did the one dotfiles switch land? (dotfiles#301)
#
# Run on EACH box after `nixos-rebuild switch`. One line per check: PASS, FAIL
# or SKIP, always with the argv that produced it, so the output is its own
# receipt. Exit 0 iff every APPLICABLE check passed; a check that does not
# apply to this host is SKIP and does not fail the run.
#
# set -u but deliberately NOT set -e: every check must run even after one
# fails. A probe that stops at the first failure tells you one thing; this one
# tells you everything.
set -u

DOTFILES="${L8_FLASH_DOTFILES:-/home/tom/mecattaf/dotfiles}"
HOST="$(hostname)"
COORDINATOR="coordinator"

pass=0
fail=0
skip=0

report() { # $1 = verdict, $2 = name, $3.. = argv
  local verdict="$1" name="$2"
  shift 2
  printf '%-4s  %-44s  %s\n' "$verdict" "$name" "$*"
}

ok() {
  pass=$((pass + 1))
  report PASS "$@"
}
no() {
  fail=$((fail + 1))
  report FAIL "$@"
}
na() {
  skip=$((skip + 1))
  report SKIP "$@"
}

coordinator_only() { [ "$HOST" = "$COORDINATOR" ]; }

# Whole-token match against `tally query pools` output. NOT `grep -w`: a
# hyphen is a non-word character, so `grep -w codex` matches inside
# "codex-window" and would report the retired mutex as the new seat row. The
# delimiter class here includes the hyphen for exactly that reason.
names_pool() { # $1 = haystack, $2 = pool name
  printf '%s\n' "$1" | grep -qE "(^|[^A-Za-z0-9_-])$2([^A-Za-z0-9_-]|\$)"
}

echo "l8-flash-probe on $HOST (dotfiles at $DOTFILES)"
echo

# ── 1. the pool rows tally actually serves ──────────────────────────────────
# `tally query pools` is the pin's own verb (doc/src/operating/cli.md,
# "Producers, pools, render, and stand-up"). The daemon runs on the
# coordinator only, so this is where the rows can be READ; the file checks
# below run everywhere.
if coordinator_only; then
  if pools_out="$(tally query pools 2>&1)"; then
    for want in cc cc2 cc3 codex pi coordinator-gpu worker-gpu; do
      if names_pool "$pools_out" "$want"; then
        ok "pool present: $want" "tally query pools | names_pool $want"
      else
        no "pool present: $want" "tally query pools | names_pool $want"
      fi
    done
    for gone in codex-window claude-window; do
      if names_pool "$pools_out" "$gone"; then
        no "pool retired: $gone" "tally query pools | names_pool $gone"
      else
        ok "pool retired: $gone" "tally query pools | names_pool $gone"
      fi
    done
  else
    no "tally query pools answers" "tally query pools"
  fi
else
  na "tally pool rows (coordinator only)" "tally query pools"
fi

# ── 2. the meters directory the module now creates ──────────────────────────
if coordinator_only; then
  if [ -d "$HOME/.local/state/tally/meters" ]; then
    ok "meters dir exists" "test -d ~/.local/state/tally/meters"
  else
    no "meters dir exists" "test -d ~/.local/state/tally/meters"
  fi
else
  na "meters dir (coordinator only)" "test -d ~/.local/state/tally/meters"
fi

# ── 3. the retired pin, by absence ──────────────────────────────────────────
# Both greps must find NOTHING. This is the switch's own oracle: the pin is
# gone when its commit id and both retired pool names are absent from the file
# that used to carry them.
tallynix="$DOTFILES/home/tally.nix"
if [ -r "$tallynix" ]; then
  if grep -n c5eb4510 "$tallynix" >/dev/null 2>&1; then
    no "pin absent from tally.nix" "grep -n c5eb4510 $tallynix"
  else
    ok "pin absent from tally.nix" "grep -n c5eb4510 $tallynix"
  fi
  if grep -nE 'codex-window|claude-window' "$tallynix" >/dev/null 2>&1; then
    no "window mutexes absent" "grep -nE 'codex-window|claude-window' $tallynix"
  else
    ok "window mutexes absent" "grep -nE 'codex-window|claude-window' $tallynix"
  fi
else
  no "tally.nix readable" "test -r $tallynix"
fi

# ── 4. llama-swap, running and with its restart policy declared ─────────────
if systemctl is-active --quiet llama-swap; then
  ok "llama-swap active" "systemctl is-active llama-swap"
else
  no "llama-swap active" "systemctl is-active llama-swap"
fi
restart="$(systemctl show llama-swap -p Restart 2>/dev/null)"
if [ "$restart" = "Restart=on-failure" ]; then
  ok "llama-swap Restart=on-failure" "systemctl show llama-swap -p Restart"
else
  no "llama-swap Restart=on-failure (got '$restart')" "systemctl show llama-swap -p Restart"
fi

# ── 5. the two user timers ──────────────────────────────────────────────────
for timer in claude-transcript-mirror.timer nightly-record.timer; do
  if coordinator_only; then
    if systemctl --user is-active --quiet "$timer"; then
      ok "$timer active" "systemctl --user is-active $timer"
    else
      no "$timer active" "systemctl --user is-active $timer"
    fi
  else
    na "$timer (coordinator only)" "systemctl --user is-active $timer"
  fi
done

# ── 6. the cc3 links, resolved ──────────────────────────────────────────────
for leaf in settings.json skills; do
  target="$(readlink -f "$HOME/.claude-3/$leaf" 2>/dev/null)"
  case "$target" in
    "$DOTFILES/home/dot_claude"/*)
      ok "cc3 link resolves: $leaf" "readlink -f ~/.claude-3/$leaf"
      ;;
    *)
      no "cc3 link resolves: $leaf (got '$target')" "readlink -f ~/.claude-3/$leaf"
      ;;
  esac
done

# ── 7. herdr: binaries everywhere, one server on the coordinator (ruling B5) ─
for binary in herdr hk; do
  if command -v "$binary" >/dev/null 2>&1; then
    ok "$binary on PATH" "command -v $binary"
  else
    no "$binary on PATH" "command -v $binary"
  fi
done
if coordinator_only; then
  if systemctl --user is-active --quiet herdr; then
    ok "herdr server active" "systemctl --user is-active herdr"
  else
    no "herdr server active" "systemctl --user is-active herdr"
  fi
else
  # NOT a failure on the worker: ruling B5 in home/herdr.nix puts ONE server on
  # the coordinator and the client binaries everywhere. See dotfiles#309.
  na "herdr server (coordinator only, ruling B5)" "systemctl --user is-active herdr"
fi

# ── 8. cleanupPeriodDays, read from the seat that actually uses it ──────────
if cleanup="$(python3 - <<'PY' 2>/dev/null
import json, os, sys
path = os.path.expanduser("~/.claude/settings.json")
with open(path) as handle:
    print(json.load(handle).get("cleanupPeriodDays"))
PY
)"; then
  if [ "$cleanup" = "365" ]; then
    ok "cleanupPeriodDays = 365" "python3 -c 'json ~/.claude/settings.json'"
  else
    no "cleanupPeriodDays = 365 (got '$cleanup')" "python3 -c 'json ~/.claude/settings.json'"
  fi
else
  no "cleanupPeriodDays readable" "python3 -c 'json ~/.claude/settings.json'"
fi

echo
echo "l8-flash-probe: $pass passed, $fail failed, $skip skipped on $HOST"
[ "$fail" -eq 0 ]
