#!/usr/bin/env bash
# One Sway surface, one Herdr client. Server lifetime belongs to its own unit.
set -euo pipefail
export HERDR_CONFIG_PATH="${XDG_CONFIG_HOME:-$HOME/.config}/herdr/sway-client.toml"
# Also work when launched from an older desktop lacking the new login vars.
local_server=${HERDR_SWAY_LOCAL:-}
if [[ -z $local_server ]]; then
  local_server=0
  [[ $(uname -n) != strix ]] || local_server=1
fi
if [[ $local_server == 1 ]]; then
  if ! systemctl --user --quiet is-active herdr.service; then
    echo 'Herdr server is not active; refusing to start an unmanaged server.' >&2
    exit 1
  fi
  exec herdr client
fi
exec "$(dirname "$(readlink -f "$0")")/herdr-projector"
