#!/usr/bin/env python3
"""Publish one completed call transcript locally, without invoking inference."""

import argparse
from datetime import datetime, timezone
import errno
import hashlib
import json
import os
from pathlib import Path
import shutil
import stat
import subprocess
import tempfile



FILES = ("transcript.md", "review-queue.md", "asr-raw/manifest.json")


def sync_directory(path):
    fd = os.open(path, os.O_DIRECTORY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def read_regular(path):
    """Reject links and concurrent replacement rather than stage a mixed revision."""
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, "rb") as stream:
        before = os.fstat(stream.fileno())
        if not stat.S_ISREG(before.st_mode):
            raise ValueError(f"not a regular finished artifact: {path}")
        data = stream.read()
        after = os.fstat(stream.fileno())
    identity = lambda value: (value.st_dev, value.st_ino, value.st_size, value.st_mtime_ns)
    if identity(before) != identity(after) or len(data) != after.st_size:
        raise ValueError(f"finished artifact changed during read: {path}")
    return data


def publish(source, root=None):
    source = Path(source).resolve(strict=True)
    if (source / "asr-raw").is_symlink():
        raise ValueError("ASR completion directory must not be a symlink")
    contents = {name: read_regular(source / name) for name in FILES}
    if not contents["transcript.md"].strip():
        raise ValueError("finished transcript is empty")
    contents["transcript.md"].decode("utf-8")
    contents["review-queue.md"].decode("utf-8")
    manifest = json.loads(contents["asr-raw/manifest.json"])
    if not isinstance(manifest, dict) or manifest.get("schema") != 1:
        raise ValueError("unsupported or missing ASR completion manifest")
    if manifest.get("all_inference_gpu_backed") is not True:
        raise ValueError("ASR manifest does not establish completed GPU-backed inference")
    hashes = {name: hashlib.sha256(data).hexdigest() for name, data in contents.items()}
    identity = {"source_directory": str(source), "sha256": hashes}
    record_id = hashlib.sha256(json.dumps(identity, sort_keys=True).encode()).hexdigest()
    parent = (Path(root) if root is not None else Path(subprocess.check_output(["utility-path", "recordings"], text=True).strip())) / "transcripts"
    parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    destination = parent / record_id

    def verify_existing():
        if destination.is_symlink() or not destination.is_dir():
            raise ValueError(f"published transcript target is not a directory: {destination}")
        receipt = json.loads(read_regular(destination / "receipt.json"))
        if (not isinstance(receipt, dict) or receipt.get("schema") != 1
                or receipt.get("id") != record_id or receipt.get("source") != identity
                or receipt.get("review_required") is not True):
            raise ValueError(f"published receipt differs from completed source: {destination}")
        for name, data in contents.items():
            target = "manifest.json" if name == "asr-raw/manifest.json" else name
            if read_regular(destination / target) != data:
                raise ValueError(f"published artifact differs from its receipt: {destination / target}")

    if destination.exists() or destination.is_symlink():
        verify_existing()
        return destination
    temporary = Path(tempfile.mkdtemp(prefix=".pending-", dir=parent))
    try:
        for name, data in contents.items():
            target = "manifest.json" if name == "asr-raw/manifest.json" else name
            path = temporary / target
            with path.open("xb") as stream:
                os.fchmod(stream.fileno(), 0o600)
                stream.write(data)
                stream.flush()
                os.fsync(stream.fileno())
        receipt = {
            "schema": 1,
            "id": record_id,
            "source": identity,
            "published_at": datetime.now(timezone.utc).isoformat(),
            "asr_model": manifest.get("asr_model"),
            "cleanup_models": manifest.get("cleanup_models"),
            "review_required": True,
        }
        with (temporary / "receipt.json").open("x", encoding="utf-8") as stream:
            os.fchmod(stream.fileno(), 0o600)
            json.dump(receipt, stream, sort_keys=True, indent=2)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        # A source revision changing during staging must never be acknowledged.
        if any(read_regular(source / name) != data for name, data in contents.items()):
            raise ValueError("finished artifacts changed before publication")
        sync_directory(temporary)
        try:
            temporary.rename(destination)
        except OSError as error:
            if error.errno not in (errno.EEXIST, errno.ENOTEMPTY):
                raise
            verify_existing()
        sync_directory(parent)
        return destination
    finally:
        if temporary.exists():
            shutil.rmtree(temporary)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("call_directory", type=Path)
    args = parser.parse_args()
    try:
        print(publish(args.call_directory))
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        parser.exit(1, f"recording-transcript-stage: {error}\n")


if __name__ == "__main__":
    main()
