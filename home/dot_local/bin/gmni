#!/usr/bin/env bash
# Three Google browser logins; GEMINI_CLI_HOME is a parent of .gemini, not the
# config directory itself. Keep the real HOME and the caller's project cwd.
set -euo pipefail
case ${0##*/} in
  gmni) account_home=$HOME ;;
  gmni2) account_home=$HOME/.gemini-account-2 ;;
  gmni3) account_home=$HOME/.gemini-account-3 ;;
  *) echo 'use gmni, gmni2 or gmni3' >&2; exit 2 ;;
esac

if ! command -v gemini >/dev/null 2>&1; then
  echo 'Gemini CLI is installed on the NAS agent host; run this launcher there.' >&2
  exit 127
fi

umask 077
mkdir -p "$account_home/.gemini"
chmod 700 "$account_home/.gemini"

# File-backed OAuth avoids a shared keychain main-account entry across seats.
# Empty auth overrides also prevent .env loading from importing another API
# key or ADC identity. No secret is read or delivered by these launchers.
exec env -u GEMINI_CLI_AUTH_OVERRIDE \
  GEMINI_CLI_HOME="$account_home" \
  GEMINI_CLI_SYSTEM_SETTINGS_PATH="$HOME/.config/gemini-cli/google-oauth-settings.json" \
  GEMINI_DEFAULT_AUTH_TYPE=oauth-personal \
  GEMINI_FORCE_ENCRYPTED_FILE_STORAGE=false \
  GEMINI_FORCE_FILE_STORAGE=true \
  NO_BROWSER="${NO_BROWSER-true}" \
  GEMINI_API_KEY= GOOGLE_API_KEY= GOOGLE_APPLICATION_CREDENTIALS= \
  GOOGLE_GENAI_USE_VERTEXAI= GOOGLE_GENAI_USE_GCA=true GOOGLE_CLOUD_ACCESS_TOKEN= \
  GOOGLE_GEMINI_BASE_URL= \
  GEMINI_CLI_TRUSTED_FOLDERS_PATH= \
  gemini "$@"
