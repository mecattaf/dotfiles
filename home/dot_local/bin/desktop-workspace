#!/usr/bin/env bash
# Native compositor workspaces; Herdr projectors are parked, never terminated.
set -euo pipefail
case "${1:-}" in
  new|close|detach|rename|restore) ;;
  *) echo 'usage: desktop-workspace <new|close|detach|rename|restore>' >&2; exit 2 ;;
esac
exec "$(dirname "$(readlink -f "$0")")/herdr-picker" --workspace "$1"
