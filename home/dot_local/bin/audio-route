#!/usr/bin/env python3
"""Imagine's paired routes: laptop or connected AirPods, USB camera mic first."""
import json
import re
import subprocess
import sys
import time

# Apple Bluetooth product identifiers, not addresses. Names also cover models
# introduced after this table and renamed devices retain their product identity.
AIRPODS_PRODUCTS = {0x2002, 0x200F, 0x2013, 0x2019, 0x201B, 0x200E,
                    0x2014, 0x2024, 0x2027, 0x200A, 0x201F}


def run(*args, timeout=6):
    return subprocess.run(args, check=True, capture_output=True, text=True, timeout=timeout).stdout


def props(node):
    return node.get("info", {}).get("props", {})


def paired_airpods():
    result = []
    try:
        devices = run("bluetoothctl", "devices", "Paired")
        for line in devices.splitlines():
            found = re.match(r"Device ((?:[0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}) (.*)", line)
            if not found:
                continue
            address, name = found.groups()
            info = run("bluetoothctl", "info", address)
            model = re.search(r"Modalias: bluetooth:v004Cp([0-9a-fA-F]{4})", info)
            product = int(model[1], 16) if model else 0
            if product not in AIRPODS_PRODUCTS and "airpods" not in name.lower():
                continue
            model_id = f"{((product & 255) << 8) | (product >> 8):04X}" if product else None
            result.append({"address": address, "name": name, "modelId": model_id})
    except (OSError, subprocess.SubprocessError):
        pass  # An unavailable radio never hides the laptop route.
    return result


def discover(graph, paired=()):
    nodes = [node for node in graph if node.get("type") == "PipeWire:Interface:Node"]
    devices = {node["id"]: props(node) for node in graph
               if node.get("type") == "PipeWire:Interface:Device"}
    defaults = {item["key"]: item.get("value", {}).get("name")
                for node in graph if node.get("type") == "PipeWire:Interface:Metadata"
                and node.get("props", {}).get("metadata.name") == "default"
                for item in node.get("metadata", []) if isinstance(item.get("value"), dict)}

    def internal(node, media):
        p = props(node)
        card = " ".join(str(p.get(key, "")) for key in
                        ("node.name", "alsa.card_name", "api.alsa.card.name"))
        return (p.get("media.class") == media and
                str(p.get("node.name", "")).startswith("alsa_") and
                ".pci-" in p.get("node.name", "") and
                not re.search("hdmi", p.get("node.name", ""), re.I) and
                re.search(r"sof[-_]?hda[-_]?dsp", card, re.I))

    microphones = sorted([node for node in nodes if internal(node, "Audio/Source")], key=lambda n: n["id"])
    webcam = sorted([node for node in nodes if props(node).get("media.class") == "Audio/Source"
                     and "icontact" in (props(node).get("node.name", "") + " " +
                                        props(node).get("node.description", "")).lower()], key=lambda n: n["id"])
    mic = next(iter(webcam or microphones), None)
    if mic is None:
        return []
    mic_label = "webcam mic" if webcam else "laptop mic"
    routes = []

    def route(identity, label, sink, **extra):
        return {"id": identity, "label": f"{label} + {mic_label}",
                "sink": sink["id"], "source": mic["id"],
                "sinkName": props(sink)["node.name"], "sourceName": props(mic)["node.name"],
                "selected": (defaults.get("default.audio.sink") == props(sink)["node.name"] and
                             defaults.get("default.audio.source") == props(mic)["node.name"]), **extra}

    sinks = sorted([node for node in nodes if internal(node, "Audio/Sink")],
                   key=lambda n: ("speaker" not in props(n).get("node.name", "").lower(), n["id"]))
    if sinks:
        routes.append(route("internal", "Laptop audio", sinks[0]))
    for node in nodes:
        p = props(node)
        device = devices.get(p.get("device.id"), {})
        if p.get("media.class") != "Audio/Sink" or not p.get("node.name", "").startswith("bluez_output."):
            continue
        try:
            product = int(str(device.get("device.product.id", "0")), 0)
        except ValueError:
            product = 0
        name = device.get("device.alias") or p.get("node.description", "AirPods")
        apple = str(device.get("device.vendor.id", "")).lower() == "bluetooth:004c"
        if not ((apple and product in AIRPODS_PRODUCTS) or "airpods" in str(name).lower()):
            continue
        address = device.get("api.bluez5.address") or p.get("api.bluez5.address")
        if not address or not re.fullmatch(r"(?:[0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}", address):
            continue
        model_id = f"{((product & 255) << 8) | (product >> 8):04X}" if product else None
        codec = p.get("api.bluez5.codec")
        profile = p.get("api.bluez5.profile")
        detail = ["Connected"]
        if codec:
            detail.append(str(codec).upper())
        if profile:
            detail.append("Stereo" if profile.startswith("a2dp") else profile)
        entry = route("airpods:" + address, str(name), node, modelId=model_id,
                      connected=True, detail=" · ".join(detail))
        routes.append(entry)
    available = {entry["id"] for entry in routes}
    for device in paired:
        identity = "airpods:" + device["address"]
        if identity not in available:
            routes.append({"id": identity, "label": f"{device['name']} + {mic_label}",
                           "modelId": device["modelId"], "connected": False, "selected": False,
                           "detail": "Disconnected · select to connect"})
    return routes


def select(route):
    # Resolve again on each selection: reconnects may replace every PipeWire ID.
    if route.get("connected") is False:
        run("bluetoothctl", "--timeout", "8", "connect", route["id"].removeprefix("airpods:"), timeout=10)
        deadline = time.monotonic() + 4
        while time.monotonic() < deadline:
            connected = next((entry for entry in discover(json.loads(run("pw-dump")))
                              if entry["id"] == route["id"]), None)
            if connected is not None:
                route = connected
                break
            time.sleep(0.2)
        else:
            raise ValueError("AirPods connected but their audio output is not ready. Reopen F9 to retry.")
    run("wpctl", "set-mute", str(route["sink"]), "0")
    run("wpctl", "set-mute", str(route["source"]), "0")
    run("wpctl", "set-default", str(route["sink"]))
    run("wpctl", "set-default", str(route["source"]))
    return route["label"]


def main():
    try:
        routes = discover(json.loads(run("pw-dump")), paired_airpods())
        if sys.argv[1:] == ["list"]:
            print(json.dumps({"choices": routes}))
            return
        if len(sys.argv) != 2:
            raise ValueError("usage: audio-route list|<route id from list>")
        selected = next((route for route in routes if route["id"] == sys.argv[1]), None)
        if selected is None:
            raise ValueError("That audio pair is no longer available. Reopen F9 to refresh devices.")
        print(select(selected))
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
