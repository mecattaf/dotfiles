#!/usr/bin/env bash
# screenshot -- save a PNG, copy it to the clipboard, then offer Satty
# Bound to Mod+S (screen), Mod+Shift+S (area) and Mod+Alt+S (window) in
# scroll/binds.conf (niri/binds.kdl). Screen and area are grim (+ slurp), superseding niri's
# screenshot UI (2026-09-15), so the area picker is the same slurp crosshair
# Mod+Ctrl+S (bin/screen-ocr-area) uses. Files keep niri's former naming.
#
# Window, on scroll (scroll/transition): grim -T captures the focused window
# alone through ext-image-copy-capture, by the foreign_toplevel_identifier
# scroll reports in get_tree (untested on a live seat: whether a window
# scrolled partly off screen comes out whole). On niri (the rollback) window stays niri's screenshot-window:
# niri's IPC reports no on-screen position for a tiled window.
# The compositor is scroll when SCROLLSOCK is set or NIRI_SOCKET is not.
#
# Area and window then open the capture in Satty for last-minute annotation.
# The plain capture is already saved and on the clipboard, so Esc just closes
# Satty; Enter overwrites the file with the annotated image and copies that.
# Esc in slurp is a clean cancel.
set -euo pipefail

dir="$HOME/Pictures/Screenshots"
file="$dir/Screenshot from $(date '+%Y-%m-%d %H-%M-%S').png"

annotate() {
    satty --filename "$file" --output-filename "$file" \
        --copy-command wl-copy \
        --actions-on-enter save-to-clipboard,save-to-file,exit \
        --actions-on-escape exit \
        --disable-notifications
}

on_scroll() { [ -n "${SCROLLSOCK:-}" ] || [ -z "${NIRI_SOCKET:-}" ]; }

case "${1:-}" in
    screen)
        if on_scroll; then
            output="$(scrollmsg -r -t get_outputs | jq -er 'map(select(.focused))[0].name')"
        else
            output="$(niri msg -j focused-output | jq -er .name)"
        fi
        mkdir -p "$dir"
        grim -o "$output" "$file"
        wl-copy --type image/png < "$file"
        ;;
    area)
        geometry="$(slurp)" || exit 0
        mkdir -p "$dir"
        grim -g "$geometry" "$file"
        wl-copy --type image/png < "$file"
        annotate
        ;;
    window)
        if on_scroll; then
            toplevel="$(scrollmsg -r -t get_tree | jq -er 'first(.. | objects
                | select(.focused? == true and .foreign_toplevel_identifier? != null)
                | .foreign_toplevel_identifier)')"
            mkdir -p "$dir"
            grim -T "$toplevel" "$file"
            wl-copy --type image/png < "$file"
            annotate
            exit 0
        fi
        # niri encodes and writes the file on a thread: wait for its
        # ScreenshotCaptured event for this path, not for the file to appear.
        # The stream's first line (initial state) proves it is subscribed.
        exec {events}< <(timeout 10 niri msg -j event-stream)
        read -r -u "$events" _
        niri msg action screenshot-window --path "$file"
        jq -en --arg path "$file" 'first(inputs | select(.ScreenshotCaptured.path? == $path))' <&"$events" > /dev/null
        annotate
        ;;
    *)
        echo "Usage: $0 {screen|area|window}" >&2
        exit 1
        ;;
esac
