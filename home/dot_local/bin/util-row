#!/usr/bin/env python3
"""util-row — UTIL-01 §row_schema.  One row per box per night.

The row is a pure function of its inputs: the sampler log, the drain ledger, the
lease-events slice and the list of counted receipt files.  Nothing about the
moment of writing enters it (no writer timestamp) so that util-replay can
recompute it byte-for-byte.

Live mode reads those inputs from the estate.  --replay-mode reads them from an
inputs bundle (a directory holding INPUTS.json), which is how util-replay and
the fixture tests drive exactly the same arithmetic.

It writes only <meters>/util-<box>-<date>.json and <meters>/util-<box>-week-*.json,
opens every input 'r', starts nothing, and holds no GPU.
"""

import argparse
import hashlib
import json
import os
import statistics
import subprocess
import sys
from datetime import date as date_cls, datetime, timedelta

SCHEMA = "util-row/1"
EXPECTED_SAMPLES = 1440
GAP_CAP_S = 300.0
LEASE_MATCH_WINDOW_S = 90.0
MIN_SAMPLES_PER_HOUR = 12
FRAC_FLOOR = 0.5
EVIDENCE_MIN_COMPLETION_TOKENS = 128
ROUND = 6

VRAM_POOL_BY_BOX = {"coordinator": "coordinator-gpu", "worker": "worker-gpu"}
LEDGERS = {
    "coordinator": "/home/tom/.local/state/academic-ocr/drain/completed.jsonl",
    "worker": None,
}
LEASE_EVENTS = "/home/tom/.local/state/tally/lease-events.jsonl"
RECEIPT_ROOTS = (
    "/home/tom/research-methods/receipts/",
    "/home/tom/mecattaf/flashnix/results/receipts/",
)
WORKER_SSH_HOST = "worker"
WORKER_SAMPLER_REMOTE = "~/.local/state/tally/meters/util-sampler"

PROMPT_COUNTERS = ("llamacpp:prompt_tokens_total", "vllm:prompt_tokens_total")
OUTPUT_COUNTERS = ("llamacpp:tokens_predicted_total", "vllm:generation_tokens_total")
UNATTRIBUTED = "unattributed"

DISPOSITIONS = ("UTILIZED", "VACUOUS", "CRASH", "IDLE", "UNKNOWN")

# --- small utilities --------------------------------------------------------


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        while True:
            chunk = fh.read(1 << 20)
            if not chunk:
                break
            h.update(chunk)
    return h.hexdigest()


def sha256_bytes(blob):
    return hashlib.sha256(blob).hexdigest()


def self_sha256():
    path = globals().get("__file__")
    if isinstance(path, str) and os.path.isfile(path):
        with open(path, "rb") as fh:
            return hashlib.sha256(fh.read()).hexdigest()
    return None


def meters_default():
    root = os.environ.get("UTIL_METERS") or "~/.local/state/tally/meters"
    return os.path.abspath(os.path.expanduser(root))


def r6(x):
    return None if x is None else round(x, ROUND)


def parse_ts(text):
    return datetime.fromisoformat(text)


def iso_week(date_str):
    y, w, _d = date_cls.fromisoformat(date_str).isocalendar()
    return "%04d-W%02d" % (y, w)


# --- inputs: three ways to build the same bundle ----------------------------


def _ref(declared, actual):
    return {"path": declared, "file": actual}


def sampler_log_path(meters, box, date_str):
    return os.path.join(meters, "util-sampler", "%s-%s.jsonl" % (box, date_str))


def receipt_is_evidence(doc):
    """definition.box_hour_utilized (i): usage.completion_tokens >= 128 AND a
    non-empty fingerprint field."""
    if not isinstance(doc, dict):
        return False
    usage = doc.get("usage")
    if not isinstance(usage, dict):
        return False
    tokens = usage.get("completion_tokens")
    if not isinstance(tokens, (int, float)) or isinstance(tokens, bool):
        return False
    if tokens < EVIDENCE_MIN_COMPLETION_TOKENS:
        return False
    for holder in (doc, usage):
        for field in ("fingerprint", "system_fingerprint"):
            val = holder.get(field)
            if isinstance(val, str) and val.strip():
                return True
    return False


def walk_evidence_receipts(date_str):
    """Every *.json under the declared receipt roots whose mtime falls on the
    date and which satisfies the evidence predicate.  Read-only."""
    counted = []
    for root in RECEIPT_ROOTS:
        if not os.path.isdir(root):
            continue
        for dirpath, _dirnames, filenames in os.walk(root):
            for name in filenames:
                if not name.endswith(".json"):
                    continue
                path = os.path.join(dirpath, name)
                try:
                    st = os.stat(path)
                except OSError:
                    continue
                mt = datetime.fromtimestamp(st.st_mtime).astimezone()
                if mt.strftime("%Y-%m-%d") != date_str:
                    continue
                try:
                    with open(path, "r") as fh:
                        doc = json.load(fh)
                except Exception:
                    continue
                if not receipt_is_evidence(doc):
                    continue
                counted.append({"path": path, "file": path,
                                "sha256": sha256_file(path),
                                "mtime": st.st_mtime})
    counted.sort(key=lambda e: e["path"])
    return counted


def pull_worker_sampler_log(meters, date_str):
    """READ-ONLY scp of the worker's sampler log into the local util-sampler/.
    A missing remote file is not a crash: the row then reports 0 samples."""
    outdir = os.path.join(meters, "util-sampler")
    os.makedirs(outdir, exist_ok=True)
    remote = "%s:%s/worker-%s.jsonl" % (WORKER_SSH_HOST, WORKER_SAMPLER_REMOTE, date_str)
    try:
        proc = subprocess.run(
            ["scp", "-o", "BatchMode=yes", "-p", remote, outdir + os.sep],
            capture_output=True, text=True, timeout=120,
        )
        return {"attempted": True, "returncode": proc.returncode,
                "stderr": (proc.stderr or "").strip()[:300]}
    except Exception as exc:
        return {"attempted": True, "returncode": None,
                "stderr": "%s: %s" % (type(exc).__name__, exc)}


def build_inputs_live(box, date_str, meters):
    if box == "worker":
        pull_worker_sampler_log(meters, date_str)
    ledger_path = LEDGERS.get(box)
    lease_src = None
    if box != "coordinator":
        coord_log = sampler_log_path(meters, "coordinator", date_str)
        lease_src = _ref(coord_log, coord_log)
    log = sampler_log_path(meters, box, date_str)
    return {
        "schema": "util-inputs/1",
        "box": box,
        "date": date_str,
        "sampler_log": _ref(log, log),
        "ledger": _ref(ledger_path, ledger_path),
        "lease_events": _ref(LEASE_EVENTS, LEASE_EVENTS),
        "lease_source_log": lease_src,
        "evidence_files": walk_evidence_receipts(date_str),
    }


def build_inputs_from_row(row):
    """The inputs a written row names.  This is what the oracle re-opens."""
    paths = row.get("inputs_paths") or {}
    ev = []
    for entry in row.get("evidence_files") or []:
        ev.append({"path": entry["path"], "file": entry["path"],
                   "sha256": entry.get("sha256"), "mtime": entry.get("mtime")})
    lease_src = paths.get("lease_source_log")
    return {
        "schema": "util-inputs/1",
        "box": row["box"],
        "date": row["date"],
        "sampler_log": _ref(paths.get("sampler_log"), paths.get("sampler_log")),
        "ledger": _ref(paths.get("ledger"), paths.get("ledger")),
        "lease_events": _ref(paths.get("lease_events"), paths.get("lease_events")),
        "lease_source_log": _ref(lease_src, lease_src) if lease_src else None,
        "evidence_files": ev,
    }


def load_inputs_bundle(bundle_dir):
    """An inputs bundle: a directory holding INPUTS.json whose `file` members are
    absolute, or relative to the bundle directory."""
    bundle_dir = os.path.abspath(bundle_dir)
    with open(os.path.join(bundle_dir, "INPUTS.json"), "r") as fh:
        doc = json.load(fh)

    def resolve(ref):
        if not ref:
            return None
        actual = ref.get("file")
        if actual and not os.path.isabs(actual):
            actual = os.path.join(bundle_dir, actual)
        return {"path": ref.get("path"), "file": actual}

    ev = []
    for entry in doc.get("evidence_files") or []:
        actual = entry.get("file") or entry.get("path")
        if actual and not os.path.isabs(actual):
            actual = os.path.join(bundle_dir, actual)
        ev.append({"path": entry.get("path"), "file": actual,
                   "sha256": entry.get("sha256"), "mtime": entry.get("mtime")})
    return {
        "schema": "util-inputs/1",
        "box": doc["box"],
        "date": doc["date"],
        "sampler_log": resolve(doc.get("sampler_log")),
        "ledger": resolve(doc.get("ledger")),
        "lease_events": resolve(doc.get("lease_events")),
        "lease_source_log": resolve(doc.get("lease_source_log")),
        "evidence_files": ev,
    }


# --- readers ----------------------------------------------------------------


def read_samples(path, date_str):
    """Samples whose local ts falls on the date, sorted by ts_epoch.
    Malformed lines are skipped; the hole they leave shows up as a gap."""
    out = []
    if not path or not os.path.isfile(path):
        return out
    with open(path, "r") as fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            try:
                doc = json.loads(line)
                stamp = parse_ts(doc["ts"])
                float(doc["ts_epoch"])
            except Exception:
                continue
            if stamp.strftime("%Y-%m-%d") != date_str:
                continue
            doc["_dt"] = stamp
            out.append(doc)
    out.sort(key=lambda d: (float(d["ts_epoch"]), d["ts"]))
    return out


def read_ledger_rows(path, date_str):
    """(rows_on_date, pages_on_date, hour_histogram).  None path -> unknown."""
    if not path or not os.path.isfile(path):
        return None
    rows = 0
    pages = 0
    hours = [0] * 24
    with open(path, "r") as fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            try:
                doc = json.loads(line)
                stamp = parse_ts(doc["completed_at"])
            except Exception:
                continue
            if stamp.strftime("%Y-%m-%d") != date_str:
                continue
            rows += 1
            npages = doc.get("pages")
            if isinstance(npages, (int, float)) and not isinstance(npages, bool):
                pages += int(npages)
            hours[stamp.hour] += 1
    return {"rows": rows, "pages": pages, "hours": hours}


def read_lease_slice(path, date_str, pool):
    """The grants of the day, verbatim, for the sha; parsed, for the unit join."""
    if not path or not os.path.isfile(path):
        return {"sha256": None, "grants": []}
    blob = []
    grants = []
    with open(path, "r") as fh:
        for line in fh:
            if not line.strip():
                continue
            try:
                doc = json.loads(line)
            except Exception:
                continue
            event = doc.get("event") or {}
            if event.get("kind") != "granted":
                continue
            grant = event.get("grant") or {}
            granted_at = grant.get("grantedAt")
            if not isinstance(granted_at, str):
                continue
            try:
                stamp = parse_ts(granted_at.replace("Z", "+00:00")).astimezone()
            except Exception:
                continue
            if stamp.strftime("%Y-%m-%d") != date_str:
                continue
            blob.append(line if line.endswith("\n") else line + "\n")
            grants.append({"epoch": stamp.timestamp(),
                           "unit": grant.get("unit"),
                           "pools": grant.get("pools") or []})
    grants.sort(key=lambda g: g["epoch"])
    return {"sha256": sha256_bytes("".join(blob).encode("utf-8")), "grants": grants}


# --- the arithmetic ---------------------------------------------------------


def resolve_held(samples, pool, lease_source):
    """held for each sample.  On the coordinator the pools answer rides in the
    sample itself; for the worker it is joined from the coordinator's log at the
    nearest sample within 90 s.  None means UNKNOWN, never false."""
    def held_of(sample):
        pools = sample.get("pools")
        if not isinstance(pools, dict) or not pools.get("ok"):
            return None
        held = pools.get("held")
        if not isinstance(held, dict) or pool not in held:
            return None
        try:
            return int(held[pool])
        except Exception:
            return None

    if lease_source is None:
        return [held_of(s) for s in samples]

    src = sorted(lease_source, key=lambda d: float(d["ts_epoch"]))
    src_epochs = [float(d["ts_epoch"]) for d in src]
    out = []
    for sample in samples:
        target = float(sample["ts_epoch"])
        best = None
        best_delta = None
        lo, hi = 0, len(src) - 1
        while lo <= hi:
            mid = (lo + hi) // 2
            if src_epochs[mid] < target:
                lo = mid + 1
            else:
                hi = mid - 1
        for idx in (hi, lo):
            if 0 <= idx < len(src):
                delta = abs(src_epochs[idx] - target)
                if best_delta is None or delta < best_delta:
                    best_delta = delta
                    best = src[idx]
        if best is None or best_delta > LEASE_MATCH_WINDOW_S:
            out.append(None)
        else:
            out.append(held_of(best))
    return out


def intervals_for(samples):
    """Gap to the next sample capped at 300 s; the last sample gets the median."""
    n = len(samples)
    if n == 0:
        return [], []
    raw = []
    for i in range(n - 1):
        raw.append(max(0.0, float(samples[i + 1]["ts_epoch"]) - float(samples[i]["ts_epoch"])))
    capped = [min(g, GAP_CAP_S) for g in raw]
    if capped:
        last = float(statistics.median(capped))
    else:
        last = 60.0
    return raw, capped + [last]


def token_ledger(samples):
    """Positive deltas of the declared counters, per arm, per day."""
    acc_in = {}
    acc_out = {}
    seen_metrics = {}
    seen_arms = {}
    seen_alive = {}

    for sample in samples:
        for probe in sample.get("probes") or []:
            name = probe.get("name")
            if probe.get("alive"):
                seen_alive[name] = True
            if isinstance(probe.get("metrics"), dict):
                seen_metrics[name] = True
            arms = probe.get("arms")
            if isinstance(arms, list):
                seen_arms.setdefault(name, set()).update(a for a in arms if isinstance(a, str))

    for i in range(len(samples) - 1):
        left = {p.get("name"): p for p in (samples[i].get("probes") or [])}
        right = {p.get("name"): p for p in (samples[i + 1].get("probes") or [])}
        for name, rp in right.items():
            lp = left.get(name)
            if lp is None:
                continue
            lm, rm = lp.get("metrics"), rp.get("metrics")
            if not isinstance(lm, dict) or not isinstance(rm, dict):
                continue
            arms = rp.get("arms")
            arm = arms[0] if isinstance(arms, list) and len(arms) == 1 else UNATTRIBUTED
            # the counters were read at both ends of this pair: the arm is
            # MEASURED, and a zero delta is a measured zero, never UNKNOWN.
            acc_in.setdefault(arm, 0.0)
            acc_out.setdefault(arm, 0.0)
            for counters, acc in ((PROMPT_COUNTERS, acc_in), (OUTPUT_COUNTERS, acc_out)):
                for counter in counters:
                    if counter in lm and counter in rm:
                        delta = float(rm[counter]) - float(lm[counter])
                        if delta > 0:
                            acc[arm] = acc.get(arm, 0.0) + delta

    tokens_in = {k: int(round(v)) for k, v in acc_in.items()}
    tokens_out = {k: int(round(v)) for k, v in acc_out.items()}

    # a serve that was alive but never showed a counter: its arms are UNKNOWN,
    # never zero (definition.tokens_source).
    for name in sorted(seen_alive):
        if seen_metrics.get(name):
            continue
        arms = sorted(seen_arms.get(name) or [])
        keys = arms if arms else [UNATTRIBUTED]
        for key in keys:
            tokens_in.setdefault(key, None)
            tokens_out.setdefault(key, None)

    grade = "MEASURED" if any(v is not None for v in tokens_out.values()) else "UNKNOWN"
    return tokens_in, tokens_out, grade


def compute_row(inputs):
    box = inputs["box"]
    date_str = inputs["date"]
    pool = VRAM_POOL_BY_BOX.get(box)

    samples = read_samples(inputs["sampler_log"]["file"], date_str)
    n = len(samples)

    lease_src_ref = inputs.get("lease_source_log")
    lease_source = None
    if lease_src_ref and lease_src_ref.get("file"):
        lease_source = read_samples(lease_src_ref["file"], date_str)
        if not lease_source:
            lease_source = []
    held = resolve_held(samples, pool, lease_source)
    lease_grade = "MEASURED" if n > 0 and all(h is not None for h in held) else "UNKNOWN"

    raw_gaps, intervals = intervals_for(samples)

    alive = [bool(any(p.get("alive") for p in (s.get("probes") or []))) for s in samples]
    gpu = [(s.get("sysfs") or {}).get("gpu_busy_percent") for s in samples]
    gtt = [(s.get("sysfs") or {}).get("gtt_used") for s in samples]

    if lease_grade == "MEASURED":
        lease_hours = r6(sum(intervals[i] for i in range(n) if held[i] >= 1) / 3600.0)
        idle_hours = r6(24.0 - lease_hours)
        unleased_alive_hours = r6(
            sum(intervals[i] for i in range(n) if alive[i] and held[i] == 0) / 3600.0)
    else:
        lease_hours = None
        idle_hours = None
        unleased_alive_hours = None

    gpu_vals = [(i, gpu[i]) for i in range(n) if isinstance(gpu[i], (int, float))]
    gpu_busy_hours = (r6(sum(intervals[i] * float(v) / 100.0 for i, v in gpu_vals) / 3600.0)
                      if gpu_vals else None)

    gtt_vals = [v for v in gtt if isinstance(v, (int, float))]
    gtt_block = {
        "min": int(min(gtt_vals)) if gtt_vals else None,
        "max": int(max(gtt_vals)) if gtt_vals else None,
        "mean": int(round(sum(gtt_vals) / len(gtt_vals))) if gtt_vals else None,
    }

    serve_alive_hours = r6(sum(intervals[i] for i in range(n) if alive[i]) / 3600.0)

    tokens_in, tokens_out, tokens_grade = token_ledger(samples)

    ledger_path = (inputs.get("ledger") or {}).get("path")
    ledger_file = (inputs.get("ledger") or {}).get("file")
    ledger_day = read_ledger_rows(ledger_file, date_str) if ledger_path else None
    if ledger_day is None:
        pages_completed = None
        pages_grade = "UNKNOWN"
        ledger_rows = None
        ledger_hours = [0] * 24
    else:
        pages_completed = ledger_day["pages"]
        pages_grade = "MEASURED"
        ledger_rows = ledger_day["rows"]
        ledger_hours = ledger_day["hours"]

    receipt_hours = [0] * 24
    receipts_counted = 0
    for entry in inputs["evidence_files"]:
        mtime = entry.get("mtime")
        if mtime is None:
            continue
        stamp = datetime.fromtimestamp(float(mtime)).astimezone()
        if stamp.strftime("%Y-%m-%d") != date_str:
            continue
        receipt_hours[stamp.hour] += 1
        receipts_counted += 1

    # hour buckets
    by_hour = {}
    for i, sample in enumerate(samples):
        by_hour.setdefault(sample["_dt"].hour, []).append(i)

    hours = []
    counts = {d: 0 for d in DISPOSITIONS}
    for h in range(24):
        idx = by_hour.get(h, [])
        count = len(idx)
        if count:
            first = samples[idx[0]]["_dt"]
            hour_start = float(samples[idx[0]]["ts_epoch"]) - (
                first.minute * 60 + first.second + first.microsecond / 1e6)
            hour_end = hour_start + 3600.0
            gaps = [raw_gaps[i] for i in range(len(raw_gaps))
                    if float(samples[i]["ts_epoch"]) < hour_end
                    and float(samples[i + 1]["ts_epoch"]) > hour_start]
            max_gap = int(round(max(gaps))) if gaps else None
        else:
            max_gap = None

        if count == 0:
            held_frac = None
        elif any(held[i] is None for i in idx):
            held_frac = None
        else:
            held_frac = r6(sum(1 for i in idx if held[i] >= 1) / count)
        alive_frac = r6(sum(1 for i in idx if alive[i]) / count) if count else None
        evidence = receipt_hours[h] + ledger_hours[h]

        if count < MIN_SAMPLES_PER_HOUR or (max_gap is not None and max_gap > GAP_CAP_S) \
                or held_frac is None or alive_frac is None:
            disposition = "UNKNOWN"
        elif held_frac >= FRAC_FLOOR and alive_frac >= FRAC_FLOOR and evidence >= 1:
            disposition = "UTILIZED"
        elif held_frac >= FRAC_FLOOR and alive_frac >= FRAC_FLOOR:
            disposition = "VACUOUS"
        elif held_frac >= FRAC_FLOOR:
            disposition = "CRASH"
        else:
            disposition = "IDLE"
        counts[disposition] += 1
        hours.append({"hour": h, "samples": count, "max_gap_s": max_gap,
                      "held_frac": held_frac, "alive_frac": alive_frac,
                      "evidence": evidence, "disposition": disposition})

    lease = read_lease_slice((inputs.get("lease_events") or {}).get("file"), date_str, pool)

    if lease_grade == "MEASURED":
        timeline = []
        start = 0
        for i in range(1, n + 1):
            if i == n or held[i] != held[start]:
                seg_from = samples[start]["ts"]
                seg_to = samples[i - 1]["ts"]
                unit = None
                if held[start] >= 1:
                    lo = float(samples[start]["ts_epoch"])
                    hi = float(samples[i - 1]["ts_epoch"])
                    for grant in lease["grants"]:
                        if lo <= grant["epoch"] <= hi and pool in (grant["pools"] or []):
                            unit = grant["unit"]
                            break
                timeline.append({"from": seg_from, "to": seg_to, "pool": pool,
                                 "held": held[start], "unit": unit})
                start = i
    else:
        timeline = None

    ledger_block = {
        "path": ledger_path,
        "rows_first_sample": ((samples[0].get("ledger") or {}).get("lines") if n else None),
        "rows_last_sample": ((samples[-1].get("ledger") or {}).get("lines") if n else None),
        "sha256_first_sample": ((samples[0].get("ledger") or {}).get("sha256") if n else None),
        "sha256_last_sample": ((samples[-1].get("ledger") or {}).get("sha256") if n else None),
    }

    sampler_log_file = inputs["sampler_log"]["file"]
    inputs_sha = {
        "sampler_log": (sha256_file(sampler_log_file)
                        if sampler_log_file and os.path.isfile(sampler_log_file) else None),
        "ledger": (sha256_file(ledger_file)
                   if ledger_file and os.path.isfile(ledger_file) else None),
        "lease_events_slice": lease["sha256"],
        "lease_source_log": (sha256_file(lease_src_ref["file"])
                             if lease_src_ref and lease_src_ref.get("file")
                             and os.path.isfile(lease_src_ref["file"]) else None),
    }

    row = {
        "schema": SCHEMA,
        "box": box,
        "date": date_str,
        "lease_pool": pool,
        "lease_grade": lease_grade,
        "lease_unresolved_samples": sum(1 for h in held if h is None),
        "lease_hours": lease_hours,
        "idle_hours": idle_hours,
        "gpu_busy_hours": gpu_busy_hours,
        "gtt_used_bytes": gtt_block,
        "serve_alive_hours": serve_alive_hours,
        "unleased_alive_hours": unleased_alive_hours,
        "tokens_in": tokens_in,
        "tokens_out": tokens_out,
        "tokens_grade": tokens_grade,
        "pages_completed": pages_completed,
        "pages_grade": pages_grade,
        "ledger": ledger_block,
        "items": receipts_counted + (ledger_rows or 0),
        "evidence_events": {"receipts": receipts_counted, "ledger_rows": ledger_rows},
        "evidence_files": [{"path": e["path"], "sha256": e.get("sha256"),
                            "mtime": e.get("mtime")}
                           for e in inputs["evidence_files"]],
        "hours": hours,
        "dispositions": counts,
        "holder_timeline": timeline,
        "samples": {
            "expected": EXPECTED_SAMPLES,
            "actual": n,
            "max_gap_s": int(round(max(raw_gaps))) if raw_gaps else 0,
            "hour_buckets_sampled": len(by_hour),
        },
        "inputs_paths": {
            "sampler_log": inputs["sampler_log"]["path"],
            "ledger": ledger_path,
            "lease_events": (inputs.get("lease_events") or {}).get("path"),
            "lease_source_log": (lease_src_ref or {}).get("path") if lease_src_ref else None,
        },
        "inputs_sha256": inputs_sha,
        "writer_version": self_sha256(),
    }
    return row


def canonical(row):
    return (json.dumps(row, sort_keys=True, indent=1) + "\n").encode("utf-8")


# --- weekly rollup ----------------------------------------------------------


def _sum_strict(values):
    """None if any night is None — a week is not measured while a night is not."""
    if any(v is None for v in values):
        return None
    return r6(sum(values))


def rebuild_week(meters, box, week):
    rows = []
    directory = meters
    if os.path.isdir(directory):
        for name in sorted(os.listdir(directory)):
            if not name.startswith("util-%s-" % box) or not name.endswith(".json"):
                continue
            if "-week-" in name:
                continue
            stem = name[len("util-%s-" % box):-len(".json")]
            try:
                if iso_week(stem) != week:
                    continue
            except Exception:
                continue
            with open(os.path.join(directory, name), "rb") as fh:
                rows.append(json.loads(fh.read().decode("utf-8")))
    rows.sort(key=lambda r: r["date"])

    counts = {d: 0 for d in DISPOSITIONS}
    for row in rows:
        for key in DISPOSITIONS:
            counts[key] += int((row.get("dispositions") or {}).get(key, 0))

    tokens_out_total = None
    if any(row.get("tokens_grade") == "MEASURED" for row in rows):
        tokens_out_total = 0
        for row in rows:
            for value in (row.get("tokens_out") or {}).values():
                if isinstance(value, int):
                    tokens_out_total += value

    red = []
    for row in rows:
        unleased = row.get("unleased_alive_hours")
        if (unleased is not None and unleased > 0) \
                or (row.get("dispositions") or {}).get("CRASH", 0) > 0 \
                or (row.get("dispositions") or {}).get("UNKNOWN", 0) == 24:
            red.append(row["date"])

    doc = {
        "schema": "util-week/1",
        "box": box,
        "iso_week": week,
        "nights": len(rows),
        "dates": [row["date"] for row in rows],
        "lease_hours": _sum_strict([row.get("lease_hours") for row in rows]),
        "gpu_busy_hours": _sum_strict([row.get("gpu_busy_hours") for row in rows]),
        "tokens_out_total": tokens_out_total,
        "pages_completed": _sum_strict([row.get("pages_completed") for row in rows]),
        "dispositions": counts,
        "red_nights": red,
    }
    path = os.path.join(meters, "util-%s-week-%s.json" % (box, week))
    with open(path, "wb") as fh:
        fh.write(canonical(doc))
    return path


# --- cli --------------------------------------------------------------------


def default_boxes(explicit):
    if explicit:
        return [explicit]
    import socket
    host = socket.gethostname().split(".")[0]
    if host == "coordinator":
        return ["coordinator", "worker"]
    return [host]


def main(argv=None):
    ap = argparse.ArgumentParser(description="UTIL-01 row writer: one row per box per night.")
    ap.add_argument("--date", default=None, help="YYYY-MM-DD (default: yesterday, local)")
    ap.add_argument("--box", default=None, help="coordinator | worker")
    ap.add_argument("--meters", default=None, help="meters root (default: $UTIL_METERS)")
    ap.add_argument("--replay-mode", default=None, metavar="DIR",
                    help="read inputs from an inputs bundle (DIR/INPUTS.json)")
    ap.add_argument("--weekly", action="store_true",
                    help="also regenerate the weekly rollup in --replay-mode")
    args = ap.parse_args(argv)

    if args.replay_mode:
        inputs = load_inputs_bundle(args.replay_mode)
        meters = os.path.abspath(os.path.expanduser(args.meters)) if args.meters \
            else os.path.abspath(args.replay_mode)
        os.makedirs(meters, exist_ok=True)
        row = compute_row(inputs)
        path = os.path.join(meters, "util-%s-%s.json" % (row["box"], row["date"]))
        with open(path, "wb") as fh:
            fh.write(canonical(row))
        print(path)
        if args.weekly:
            print(rebuild_week(meters, row["box"], iso_week(row["date"])))
        return 0

    date_str = args.date or (datetime.now().astimezone().date() - timedelta(days=1)).isoformat()
    date_cls.fromisoformat(date_str)
    meters = os.path.abspath(os.path.expanduser(args.meters)) if args.meters else meters_default()
    os.makedirs(meters, exist_ok=True)

    for box in default_boxes(args.box):
        inputs = build_inputs_live(box, date_str, meters)
        row = compute_row(inputs)
        path = os.path.join(meters, "util-%s-%s.json" % (box, date_str))
        with open(path, "wb") as fh:
            fh.write(canonical(row))
        print(path)
        print(rebuild_week(meters, box, iso_week(date_str)))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
