#!/usr/bin/env bash
# herdr-chord <new|sidebar|rename> -- the seat's herdr chords (#385), bound in
# sway/binds.conf:
#
#   new      Mod+Return             a new workspace in a NEW projector window
#   sidebar  Mod+Ctrl+Shift+Return  a new projector with herdr's agents sidebar
#   rename   (not bound on Sway)    rename the focused workspace
#
# Sway uses one projector per numbered workspace, and herdr-picker owns those
# windows, so every chord is handed to `herdr-picker --chord <verb>`. The
# keystroke-injection path this script used to carry existed only for niri,
# retired on 2026-10-13 together with scroll.
set -euo pipefail

verb="${1:-}"
case "$verb" in
  new | sidebar | rename) ;;
  *)
    echo "usage: herdr-chord <new|sidebar|rename>" >&2
    exit 2
    ;;
esac

# Home Manager may link each bin entry to its own store path (pkgs.linkFarm),
# so find the sibling beside the link, never through it.
exec "$(dirname "$0")/herdr-picker" --chord "$verb"
