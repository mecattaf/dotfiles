#!/usr/bin/env python3
"""Use Chrome for the web, and the managed XDG defaults for files and schemes."""
import os
from pathlib import Path
import sys
from urllib.parse import urlsplit

def command(args):
    if args[:1]==['--']:args=args[1:]
    if len(args)!=1 or not args[0] or any(c in args[0] for c in ('\0','\n','\r')):
        raise ValueError('takes one file, folder or address')
    target=args[0]
    if urlsplit(target).scheme.lower() in ('http','https'):
        return [str(Path.home()/'.local/bin/desktop-web'),target]
    # GIO consults the user MIME defaults; it does not enter Domicile's xdg shim.
    return ['gio','open','--',target]

if __name__=='__main__':
    try:
        argv=command(sys.argv[1:]);os.execvp(argv[0],argv)
    except (OSError,ValueError) as error:
        print(f'desktop-open: {error}',file=sys.stderr);raise SystemExit(1)
