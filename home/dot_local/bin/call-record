#!/usr/bin/env bash
# call-record — capture both sides of a call (INZONE Buds) into per-speaker
# WAVs plus a mixed track for diarization testing.
#
#   call-record start <slug>   begin capturing far (call audio) + near (mic)
#   call-record stop           finish, mix, print file paths
#   call-record status         show current session, levels sanity
#   call-record handoff <dir>  thin client: retry a failed hand-off by hand
#
# Far side  = monitor of the INZONE Buds sink (what you hear).
# Near side = INZONE Buds mono mic (what you say).
# Both mono s16 48 kHz; mix.wav is the diarization test input, the split
# tracks are per-speaker ground truth. Evidence files, keep all three.
#
# Capture stays on the audio seat. Closed recordings are handed to the NAS,
# verified there before removing the client spool, and processed on compute.
# The stop event starts diarization directly; there is no polling timer.
set -euo pipefail
umask 077

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/call-record"
CURRENT="$STATE_DIR/current"
# Only the storage owner keeps completed captures, even if another host has a GPU.
if [[ "$(hostname 2>/dev/null)" == nas ]]; then
    HANDS_OFF=false
    OUT_ROOT="$(utility-path recordings)/calls"
else
    HANDS_OFF=true
    OUT_ROOT="$STATE_DIR/spool"
fi
RATE=48000
HOLD_MARKER="$STATE_DIR/active"

# Presence of the hold marker tells speech-play (pkgs/speech-session/play.py)
# to keep speech playback off the seat for the whole call, including the
# moments before CURRENT is published and after it is removed. It is written
# before capture starts and retained (fail closed) when shutdown is uncertain.
hold_playback() {
    mkdir -p "$STATE_DIR"
    printf '%s\n' "${dir:-unknown}" > "$HOLD_MARKER"
}

release_playback() {
    rm -f -- "$HOLD_MARKER"
}

process_start() {
    local value
    local -a fields
    [[ -r "/proc/$1/stat" ]] || return 1
    IFS= read -r value < "/proc/$1/stat" || return 1
    read -r -a fields <<< "${value##*) }"
    [[ "${fields[0]}" != Z && "${fields[0]}" != X ]] || return 1
    printf '%s\n' "${fields[19]}"
}

capture_running() {
    local actual
    actual=$(process_start "$1") || return 1
    [[ -z "${2:-}" || "$actual" == "$2" ]]
}

legacy_capture_matches() {
    local item recorder=false output=false
    local -a argv
    [[ -r "/proc/$1/cmdline" ]] || return 1
    mapfile -d '' -t argv < "/proc/$1/cmdline"
    for item in "${argv[@]}"; do
        [[ "${item##*/}" == pw-record ]] && recorder=true
        [[ "$item" == "$2" ]] && output=true
    done
    [[ "$recorder" == true && "$output" == true ]]
}

finish_failed_start() {
    local status=$? i pending=false
    trap - EXIT
    if [[ "${published:-0}" != 1 && "${hold_owned:-0}" == 1 ]]; then
        for i in far near; do
            local pid_variable="${i}_pid" stamp_variable="${i}_start"
            local pid="${!pid_variable:-}" stamp="${!stamp_variable:-}"
            if [[ -n "$pid" ]] && capture_running "$pid" "$stamp"; then
                kill -INT "$pid" 2>/dev/null || true
            fi
        done
        for _ in {1..50}; do
            pending=false
            for i in far near; do
                local pid_variable="${i}_pid" stamp_variable="${i}_start"
                local pid="${!pid_variable:-}" stamp="${!stamp_variable:-}"
                if [[ -n "$pid" ]] && capture_running "$pid" "$stamp"; then pending=true; fi
            done
            [[ "$pending" == false ]] && break
            sleep 0.1
        done
        if [[ "$pending" == false && "${launching:-0}" != 1 ]]; then
            release_playback || true
        else
            echo "capture shutdown is uncertain; speech playback remains held" >&2
        fi
    fi
    exit "$status"
}

# Serialize start, stop and explicit stale-marker recovery. In particular a
# second start cannot replace CURRENT while stop is closing its recorders.
case "${1:-}" in
start|stop|recover|handoff)
    mkdir -p "$STATE_DIR"
    exec 9>"$STATE_DIR/control.lock"
    flock -x 9
    ;;
esac

# A failed upload or verification leaves the client spool available for retry.
hand_off() { # $1 = closed session dir
    local session="$1" base remote root quoted manifest started=true
    base=$(basename "$session")
    [[ "$base" =~ ^[A-Za-z0-9._-]+$ && "$base" != .* ]] || return 1
    root=$(ssh -o BatchMode=yes nas utility-path recordings) || {
        echo "storage lookup failed; the local copy is kept at $session" >&2
        echo "re-run: call-record handoff $session" >&2
        return 1
    }
    [[ "$root" == /* && "$root" != *$'\n'* ]] || return 1
    remote="$root/calls/$base"
    printf -v quoted '%q' "$root/calls"
    if ! tar -C "$(dirname "$session")" -cf - "$base" \
        | ssh -o BatchMode=yes nas "mkdir -p -- $quoted && tar -C $quoted -xf -"; then
        echo "upload failed; local recording kept at $session" >&2
        return 1
    fi
    printf -v quoted '%q' "$remote"
    if [[ -z "$(find "$session" -mindepth 1 ! -type f -print -quit)" ]] \
        && manifest=$(cd "$session" && shopt -s dotglob nullglob && files=(*) \
            && ((${#files[@]})) && sha256sum -- "${files[@]}") \
        && printf '%s\n' "$manifest" | ssh -o BatchMode=yes nas "cd -- $quoted && sha256sum --check --status -"; then
        ssh -o BatchMode=yes nas "call-diarize-start $quoted" || started=false
        if [[ "$started" != true ]]; then
            echo "recording verified; retry diarization on NAS with call-diarize-start $quoted" >&2
        fi
        echo "handed to nas: $remote (every file verified by sha256)"
        return 0
    fi
    echo "verification failed; the local copy is kept at $session" >&2
    return 1
}

# Print the closed session's tracks; $1 = where they are now, as shown.
summary() {
    local f
    echo "session closed:"
    for f in far near mix; do
        [[ -f "$dir/$f.wav" ]] && printf '  %-8s %s  (%s)\n' "$f.wav" "$1/$f.wav" "$(soxi -d "$dir/$f.wav" 2>/dev/null || echo '?')"
    done
}

find_node() { # $1 = media.class, $2 = case-insensitive description/name pattern
    pw-dump | jq -r --arg class "$1" --arg pat "$2" '
        .[] | select(.info.props["media.class"] == $class)
            | select((.info.props["node.name"] + " " + (.info.props["node.description"] // "")) | test($pat; "i"))
            | .info.props["node.name"]' | head -n1
}

case "${1:-}" in
start)
    slug="${2:?usage: call-record start <slug>}"
    [[ "$slug" =~ ^[A-Za-z0-9._-]+$ ]] || { echo "slug: letters/digits/._- only" >&2; exit 1; }
    if [[ -e "$CURRENT" ]]; then
        echo "a session is already running ($(cat "$CURRENT")); run 'call-record stop' first" >&2
        exit 1
    fi
    if [[ -e "$HOLD_MARKER" ]]; then
        echo "stale playback hold exists; inspect captures and run 'call-record recover'" >&2
        exit 1
    fi

    sink="$(find_node Audio/Sink 'INZONE')"
    source="$(find_node Audio/Source 'INZONE')"
    [[ -n "$sink" ]] || { echo "INZONE Buds sink not found — dongle plugged in?" >&2; exit 1; }
    [[ -n "$source" ]] || { echo "INZONE Buds mic source not found" >&2; exit 1; }

    dir="$OUT_ROOT/$(date +%F)-$slug"
    mkdir -p "$dir" "$STATE_DIR"
    published=0 hold_owned=0 launching=0
    far_pid='' near_pid='' far_start='' near_start=''
    trap finish_failed_start EXIT
    trap 'exit 130' HUP INT TERM
    # Set ownership before the write so a partial hook failure is cleaned up
    # only when this invocation has launched no surviving captures.
    hold_owned=1
    hold_playback

    # The Shift+F9 controller runs in a short-lived kitty popup. Start each
    # capture in its own session with no terminal file descriptors so closing
    # that popup cannot send the recorders SIGHUP or hold the window open.
    : > "$dir/capture.log"
    # A signal between fork and storing $! must retain the hold: the new
    # child might exist even though its PID is not yet available to cleanup.
    launching=1
    setsid pw-record --target "$sink" -P '{ stream.capture.sink = true }' \
        --format s16 --rate "$RATE" --channels 1 "$dir/far.wav" \
        9>&- </dev/null >> "$dir/capture.log" 2>&1 &
    far_pid=$!
    far_start=$(process_start "$far_pid") || far_start=
    launching=0
    launching=1
    setsid pw-record --target "$source" \
        --format s16 --rate "$RATE" --channels 1 "$dir/near.wav" \
        9>&- </dev/null >> "$dir/capture.log" 2>&1 &
    near_pid=$!
    near_start=$(process_start "$near_pid") || near_start=
    launching=0

    # Do not publish an active session if either PipeWire stream rejected its
    # node or format immediately. The log remains beside the partial tracks for
    # diagnosis.
    sleep 0.2
    if ! capture_running "$far_pid" "$far_start" || ! capture_running "$near_pid" "$near_start"; then
        echo "capture failed to start; see $dir/capture.log" >&2
        exit 1
    fi

    temporary=$(mktemp "$STATE_DIR/.current.XXXXXX")
    printf '%s\n%s\n%s\n%s\n%s\n' "$dir" "$far_pid" "$near_pid" "$far_start" "$near_start" > "$temporary"
    mv -f -- "$temporary" "$CURRENT"
    published=1
    echo "recording -> $dir"
    echo "  far  (call audio): $sink"
    echo "  near (your mic):   $source"
    echo "stop with: call-record stop"
    ;;

stop)
    [[ -e "$CURRENT" ]] || { echo "no session running" >&2; exit 1; }
    { read -r dir; read -r far_pid; read -r near_pid;
      read -r far_start || far_start=; read -r near_start || near_start=; } < "$CURRENT"
    hold_playback

    for side in far near; do
        pid_variable="${side}_pid" stamp_variable="${side}_start"
        pid="${!pid_variable}" stamp="${!stamp_variable}"
        [[ "$pid" =~ ^[0-9]+$ && "$pid" -gt 1 ]] || { echo "invalid recorder PID; speech playback remains held" >&2; exit 1; }
        if capture_running "$pid" "$stamp" && [[ -z "$stamp" ]] && ! legacy_capture_matches "$pid" "$dir/$side.wav"; then
            echo "cannot identify legacy recorder PID $pid; speech playback remains held" >&2
            exit 1
        fi
    done

    for side in far near; do
        pid_variable="${side}_pid" stamp_variable="${side}_start"
        pid="${!pid_variable}" stamp="${!stamp_variable}"
        if capture_running "$pid" "$stamp"; then kill -INT "$pid" 2>/dev/null || true; fi
    done
    for _ in {1..50}; do
        if ! capture_running "$far_pid" "$far_start" && ! capture_running "$near_pid" "$near_start"; then break; fi
        sleep 0.1
    done
    if capture_running "$far_pid" "$far_start" || capture_running "$near_pid" "$near_start"; then
        echo "recorders did not stop; speech playback remains held" >&2
        exit 1
    fi
    rm -f "$CURRENT"
    release_playback

    mix_written=false
    handed_off=false
    if [[ -s "$dir/far.wav" && -s "$dir/near.wav" ]]; then
        sox -m "$dir/far.wav" "$dir/near.wav" "$dir/mix.wav" gain -n -1
        mix_written=true
    else
        echo "warning: one track is empty; skipping mix" >&2
    fi

    # call-diarize-start launches call-diarize as a detached transient user
    # unit and returns at once (Tally, the former queue, was removed on
    # 2026-09-30; see call-diarize-start's header). Start only after mix.wav is
    # finalized. A missing diarizer or a refused launch must never turn a
    # successfully closed recording into a failed `stop`.
    if [[ "$mix_written" == true ]]; then
        if [[ "$HANDS_OFF" == false ]]; then
            if ! call-diarize-start "$dir"; then
                echo "warning: diarization was not started; run call-diarize-start $dir later" >&2
            fi
        elif [[ "$HANDS_OFF" == true ]]; then
            # Thin client: the recording exists here, the diarizer lives there
            # (hand_off above). Same doctrine as the local branch: a failed
            # hand-off is a warning, never a failed `stop`; the session then
            # stays in the spool and the printed command retries it.
            if hand_off "$dir"; then
                handed_off=true
            fi
        else
            echo "warning: call-diarize is unavailable on this host; diarization was not started" >&2
        fi
    else
        echo "warning: diarization was not started because mix.wav was not produced" >&2
        if [[ "$HANDS_OFF" == true ]]; then
            echo "         the recording is kept at $dir; hand it to the NAS with: call-record handoff $dir" >&2
        fi
    fi

    # The summary reads the local files, so a handed-off copy goes after it.
    if [[ "$handed_off" == true ]]; then
        summary "nas:configured-recordings/calls/$(basename "$dir")" || true
        rm -rf -- "$dir"
        echo "local copy removed: $dir"
    else
        summary "$dir"
    fi
    ;;

handoff)
    session="${2:?usage: call-record handoff <session dir>}"
    [[ "$HANDS_OFF" == true ]] || { echo "this host keeps its recordings in $OUT_ROOT; nothing to hand off" >&2; exit 1; }
    [[ -d "$session" ]] || { echo "no such session dir: $session" >&2; exit 1; }
    session=$(realpath -- "$session")
    if [[ -e "$CURRENT" ]] && [[ "$(head -n 1 "$CURRENT")" == "$session" ]]; then
        echo "$session is still recording; run 'call-record stop'" >&2
        exit 1
    fi
    hand_off "$session" || exit 1
    rm -rf -- "$session"
    echo "local copy removed: $session"
    ;;

recover)
    [[ ! -e "$CURRENT" ]] || { echo "a session exists; use 'call-record stop'" >&2; exit 1; }
    [[ -e "$HOLD_MARKER" ]] || { echo "no stale playback hold"; exit 0; }
    # Explicit recovery never kills unknown processes. Refuse while any call
    # capture remains, including one orphaned before CURRENT was published.
    for process in /proc/[0-9]*; do
        [[ -r "$process/cmdline" ]] || continue
        mapfile -d '' -t argv < "$process/cmdline" || continue
        for argument in "${argv[@]}"; do
            case "$argument" in
            "$OUT_ROOT"/*/far.wav|"$OUT_ROOT"/*/near.wav)
                if legacy_capture_matches "${process##*/}" "$argument"; then
                    echo "call capture still exists; speech playback remains held" >&2
                    exit 1
                fi
                ;;
            esac
        done
    done
    release_playback
    echo "stale playback hold cleared"
    ;;

status)
    if [[ -e "$CURRENT" ]]; then
        { read -r dir; read -r far_pid; read -r near_pid; } < "$CURRENT"
        echo "recording in progress -> $dir (far pid $far_pid, near pid $near_pid)"
        du -h "$dir"/*.wav 2>/dev/null || true
    else
        echo "idle"
    fi
    ;;

*)
    echo "usage: call-record start <slug> | stop | status | recover | handoff <dir>" >&2
    exit 1
    ;;
esac
