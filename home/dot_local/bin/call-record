#!/usr/bin/env bash
# call-record — capture both sides of a call (INZONE Buds) into per-speaker
# WAVs plus a mixed track for diarization testing.
#
#   call-record start <slug>   begin capturing far (call audio) + near (mic)
#   call-record stop           finish, mix, print file paths
#   call-record status         show current session, levels sanity
#
# Far side  = monitor of the INZONE Buds sink (what you hear).
# Near side = INZONE Buds mono mic (what you say).
# Both mono s16 48 kHz; mix.wav is the diarization test input, the split
# tracks are per-speaker ground truth. Evidence files, keep all three.
#
# WHERE RECORDINGS END UP, on a thin client (2026-09-11). Capture happens where
# the dongle is — the seat, i.e. the laptop — so ~/Recordings/calls on the
# CLIENT is always the first and permanent copy. Diarization happens where the
# GPUs and the tally daemon are, on the coordinator, and the client does not
# carry call-diarize-backfill. So `stop` copies the closed session dir across
# and enqueues it there, keeping the local copy. On the coordinator itself
# nothing is copied: the local backfill command is found and used directly.
set -euo pipefail
umask 077

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/call-record"
CURRENT="$STATE_DIR/current"
OUT_ROOT="$HOME/Recordings/calls"
RATE=48000
WAKE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/speech-wake"
WAKE_MARKER="$WAKE_DIR/call-record"

# Presence inhibits waking. An atomic new epoch on entry AND exit invalidates
# buffered PCM/detector state even if a listener misses a short marker lifetime.
# The listener also checks CURRENT for recordings begun by older versions.
bump_wake_epoch() {
    local temporary
    temporary=$(mktemp "$WAKE_DIR/.epoch.XXXXXX")
    printf '%s-%s\n' "$(date +%s%N)" "$BASHPID" > "$temporary"
    mv -f -- "$temporary" "$WAKE_DIR/epoch"
}

inhibit_wake() {
    mkdir -p "$WAKE_DIR"
    printf '%s\n' "${dir:-unknown}" > "$WAKE_MARKER"
    bump_wake_epoch
}

release_wake() {
    # If updating the epoch fails, retain the marker (fail closed).
    bump_wake_epoch
    rm -f -- "$WAKE_MARKER"
}

wait_for_listener_ack() {
    local dictation_lock="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/speech-dictation.lock"
    local dictation_fd
    if [[ -e "$dictation_lock" ]]; then
        exec {dictation_fd}>>"$dictation_lock"
        if ! flock -w 2 "$dictation_fd"; then
            exec {dictation_fd}>&-
            retain_inhibit=1
            echo "held dictation did not release microphone; no call capture started" >&2
            return 1
        fi
        exec {dictation_fd}>&-
    fi
    local runtime_lock="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/speech-wake/lock"
    local probe_fd
    [[ -e "$runtime_lock" ]] || return 0
    exec {probe_fd}>>"$runtime_lock"
    for _ in {1..40}; do
        if flock -n "$probe_fd"; then
            exec {probe_fd}>&-
            return 0
        fi
        if cmp -s "$WAKE_DIR/epoch" "$WAKE_DIR/ack"; then
            exec {probe_fd}>&-
            return 0
        fi
        sleep 0.05
    done
    exec {probe_fd}>&-
    retain_inhibit=1
    echo "wake listener did not acknowledge call inhibition; no capture started, marker retained" >&2
    return 1
}

process_start() {
    local value
    local -a fields
    [[ -r "/proc/$1/stat" ]] || return 1
    IFS= read -r value < "/proc/$1/stat" || return 1
    read -r -a fields <<< "${value##*) }"
    [[ "${fields[0]}" != Z && "${fields[0]}" != X ]] || return 1
    printf '%s\n' "${fields[19]}"
}

capture_running() {
    local actual
    actual=$(process_start "$1") || return 1
    [[ -z "${2:-}" || "$actual" == "$2" ]]
}

legacy_capture_matches() {
    local item recorder=false output=false
    local -a argv
    [[ -r "/proc/$1/cmdline" ]] || return 1
    mapfile -d '' -t argv < "/proc/$1/cmdline"
    for item in "${argv[@]}"; do
        [[ "${item##*/}" == pw-record ]] && recorder=true
        [[ "$item" == "$2" ]] && output=true
    done
    [[ "$recorder" == true && "$output" == true ]]
}

finish_failed_start() {
    local status=$? i pending=false
    trap - EXIT
    if [[ "${published:-0}" != 1 && "${wake_owned:-0}" == 1 ]]; then
        for i in far near; do
            local pid_variable="${i}_pid" stamp_variable="${i}_start"
            local pid="${!pid_variable:-}" stamp="${!stamp_variable:-}"
            if [[ -n "$pid" ]] && capture_running "$pid" "$stamp"; then
                kill -INT "$pid" 2>/dev/null || true
            fi
        done
        for _ in {1..50}; do
            pending=false
            for i in far near; do
                local pid_variable="${i}_pid" stamp_variable="${i}_start"
                local pid="${!pid_variable:-}" stamp="${!stamp_variable:-}"
                if [[ -n "$pid" ]] && capture_running "$pid" "$stamp"; then pending=true; fi
            done
            [[ "$pending" == false ]] && break
            sleep 0.1
        done
        if [[ "$pending" == false && "${retain_inhibit:-0}" != 1 && "${launching:-0}" != 1 ]]; then
            release_wake || true
        elif [[ "$pending" == true || "${launching:-0}" == 1 ]]; then
            echo "capture shutdown is uncertain; wake remains inhibited" >&2
        fi
    fi
    exit "$status"
}

# Serialize start, stop and explicit stale-marker recovery. In particular a
# second start cannot replace CURRENT while stop is closing its recorders.
case "${1:-}" in
start|stop|recover)
    mkdir -p "$STATE_DIR"
    exec 9>"$STATE_DIR/control.lock"
    flock -x 9
    ;;
esac

find_node() { # $1 = media.class, $2 = case-insensitive description/name pattern
    pw-dump | jq -r --arg class "$1" --arg pat "$2" '
        .[] | select(.info.props["media.class"] == $class)
            | select((.info.props["node.name"] + " " + (.info.props["node.description"] // "")) | test($pat; "i"))
            | .info.props["node.name"]' | head -n1
}

case "${1:-}" in
start)
    slug="${2:?usage: call-record start <slug>}"
    [[ "$slug" =~ ^[A-Za-z0-9._-]+$ ]] || { echo "slug: letters/digits/._- only" >&2; exit 1; }
    if [[ -e "$CURRENT" ]]; then
        echo "a session is already running ($(cat "$CURRENT")); run 'call-record stop' first" >&2
        exit 1
    fi
    if [[ -e "$WAKE_MARKER" ]]; then
        echo "stale wake inhibition exists; inspect captures and run 'call-record recover'" >&2
        exit 1
    fi

    sink="$(find_node Audio/Sink 'INZONE')"
    source="$(find_node Audio/Source 'INZONE')"
    [[ -n "$sink" ]] || { echo "INZONE Buds sink not found — dongle plugged in?" >&2; exit 1; }
    [[ -n "$source" ]] || { echo "INZONE Buds mic source not found" >&2; exit 1; }

    dir="$OUT_ROOT/$(date +%F)-$slug"
    mkdir -p "$dir" "$STATE_DIR"
    published=0 wake_owned=0 launching=0
    far_pid='' near_pid='' far_start='' near_start=''
    trap finish_failed_start EXIT
    trap 'exit 130' HUP INT TERM
    # Set ownership before the write so a partial hook failure is cleaned up
    # only when this invocation has launched no surviving captures.
    wake_owned=1
    inhibit_wake
    wait_for_listener_ack

    # The Shift+F9 controller runs in a short-lived kitty popup. Start each
    # capture in its own session with no terminal file descriptors so closing
    # that popup cannot send the recorders SIGHUP or hold the window open.
    : > "$dir/capture.log"
    # A signal between fork and storing $! must retain inhibition: the new
    # child might exist even though its PID is not yet available to cleanup.
    launching=1
    setsid pw-record --target "$sink" -P '{ stream.capture.sink = true }' \
        --format s16 --rate "$RATE" --channels 1 "$dir/far.wav" \
        9>&- </dev/null >> "$dir/capture.log" 2>&1 &
    far_pid=$!
    far_start=$(process_start "$far_pid") || far_start=
    launching=0
    launching=1
    setsid pw-record --target "$source" \
        --format s16 --rate "$RATE" --channels 1 "$dir/near.wav" \
        9>&- </dev/null >> "$dir/capture.log" 2>&1 &
    near_pid=$!
    near_start=$(process_start "$near_pid") || near_start=
    launching=0

    # Do not publish an active session if either PipeWire stream rejected its
    # node or format immediately. The log remains beside the partial tracks for
    # diagnosis.
    sleep 0.2
    if ! capture_running "$far_pid" "$far_start" || ! capture_running "$near_pid" "$near_start"; then
        echo "capture failed to start; see $dir/capture.log" >&2
        exit 1
    fi

    temporary=$(mktemp "$STATE_DIR/.current.XXXXXX")
    printf '%s\n%s\n%s\n%s\n%s\n' "$dir" "$far_pid" "$near_pid" "$far_start" "$near_start" > "$temporary"
    mv -f -- "$temporary" "$CURRENT"
    published=1
    echo "recording -> $dir"
    echo "  far  (call audio): $sink"
    echo "  near (your mic):   $source"
    echo "stop with: call-record stop"
    ;;

stop)
    [[ -e "$CURRENT" ]] || { echo "no session running" >&2; exit 1; }
    { read -r dir; read -r far_pid; read -r near_pid;
      read -r far_start || far_start=; read -r near_start || near_start=; } < "$CURRENT"
    inhibit_wake

    for side in far near; do
        pid_variable="${side}_pid" stamp_variable="${side}_start"
        pid="${!pid_variable}" stamp="${!stamp_variable}"
        [[ "$pid" =~ ^[0-9]+$ && "$pid" -gt 1 ]] || { echo "invalid recorder PID; wake remains inhibited" >&2; exit 1; }
        if capture_running "$pid" "$stamp" && [[ -z "$stamp" ]] && ! legacy_capture_matches "$pid" "$dir/$side.wav"; then
            echo "cannot identify legacy recorder PID $pid; wake remains inhibited" >&2
            exit 1
        fi
    done

    for side in far near; do
        pid_variable="${side}_pid" stamp_variable="${side}_start"
        pid="${!pid_variable}" stamp="${!stamp_variable}"
        if capture_running "$pid" "$stamp"; then kill -INT "$pid" 2>/dev/null || true; fi
    done
    for _ in {1..50}; do
        if ! capture_running "$far_pid" "$far_start" && ! capture_running "$near_pid" "$near_start"; then break; fi
        sleep 0.1
    done
    if capture_running "$far_pid" "$far_start" || capture_running "$near_pid" "$near_start"; then
        echo "recorders did not stop; wake remains inhibited" >&2
        exit 1
    fi
    rm -f "$CURRENT"
    release_wake

    mix_written=false
    if [[ -s "$dir/far.wav" && -s "$dir/near.wav" ]]; then
        sox -m "$dir/far.wav" "$dir/near.wav" "$dir/mix.wav" gain -n -1
        mix_written=true
    else
        echo "warning: one track is empty; skipping mix" >&2
    fi

    # The shared helper writes the same atomic, full-submission event as the
    # historical backfill command. Queue only after mix.wav is finalized. An
    # unavailable package, events directory, or tally daemon must never turn a
    # successfully closed recording into a failed `stop`.
    if [[ "$mix_written" == true ]]; then
        if command -v call-diarize-backfill >/dev/null 2>&1; then
            if ! call-diarize-backfill --enqueue "$dir"; then
                echo "warning: diarization was not queued; run call-diarize-backfill later" >&2
            fi
        elif [[ "$(hostname)" != "coordinator" ]]; then
            # Thin client: the recording exists here, the diarizer lives there.
            # Stream the whole session dir over the fleet ssh block (home/ssh.nix
            # gives `coordinator` its key, user and StrictHostKeyChecking; the
            # client holds ~/.ssh/id_ed25519 via agenix) and enqueue on arrival.
            # On the LAN this is a direct 10.42.0.16 -> 10.42.0.2 copy; off-LAN it
            # rides the NAS's subnet route, which is slow but correct.
            # Same doctrine as the local branch: a failed hand-off is a warning,
            # never a failed `stop`. The local copy is kept either way, so the
            # printed command line is always re-runnable by hand.
            base=$(basename "$dir")
            # The tilde is deliberate and deliberately unexpanded HERE: this
            # path is interpreted by the coordinator's shell, whose $HOME is the
            # one that matters, not this box's.
            # shellcheck disable=SC2088
            remote="~/Recordings/calls/$base"
            handoff="tar -C \"$(dirname "$dir")\" -cf - \"$base\" | ssh coordinator \"mkdir -p ~/Recordings/calls && tar -C ~/Recordings/calls -xf - && call-diarize-backfill --enqueue $remote\""
            # Deliberate local expansion: slug was validated on start.
            # shellcheck disable=SC2029
            if ! tar -C "$(dirname "$dir")" -cf - "$base" \
                | ssh coordinator "mkdir -p ~/Recordings/calls && tar -C ~/Recordings/calls -xf - && call-diarize-backfill --enqueue $remote"; then
                echo "warning: hand-off to the coordinator failed; the local copy is intact." >&2
                echo "         re-run: $handoff" >&2
            else
                echo "handed to coordinator: $remote (local copy kept at $dir)"
            fi
        else
            echo "warning: call-diarize-backfill is unavailable; diarization was not queued" >&2
        fi
    else
        echo "warning: diarization was not queued because mix.wav was not produced" >&2
    fi

    echo "session closed:"
    for f in far near mix; do
        [[ -f "$dir/$f.wav" ]] && printf '  %-8s %s  (%s)\n' "$f.wav" "$dir/$f.wav" "$(soxi -d "$dir/$f.wav" 2>/dev/null || echo '?')"
    done
    ;;

recover)
    [[ ! -e "$CURRENT" ]] || { echo "a session exists; use 'call-record stop'" >&2; exit 1; }
    [[ -e "$WAKE_MARKER" ]] || { echo "no stale wake inhibition"; exit 0; }
    # Explicit recovery never kills unknown processes. Refuse while any call
    # capture remains, including one orphaned before CURRENT was published.
    for process in /proc/[0-9]*; do
        [[ -r "$process/cmdline" ]] || continue
        mapfile -d '' -t argv < "$process/cmdline" || continue
        for argument in "${argv[@]}"; do
            case "$argument" in
            "$OUT_ROOT"/*/far.wav|"$OUT_ROOT"/*/near.wav)
                if legacy_capture_matches "${process##*/}" "$argument"; then
                    echo "call capture still exists; wake remains inhibited" >&2
                    exit 1
                fi
                ;;
            esac
        done
    done
    release_wake
    echo "stale wake inhibition cleared; fresh listener state required"
    ;;

status)
    if [[ -e "$CURRENT" ]]; then
        { read -r dir; read -r far_pid; read -r near_pid; } < "$CURRENT"
        echo "recording in progress -> $dir (far pid $far_pid, near pid $near_pid)"
        du -h "$dir"/*.wav 2>/dev/null || true
    else
        echo "idle"
    fi
    ;;

*)
    echo "usage: call-record start <slug> | stop | status | recover" >&2
    exit 1
    ;;
esac
