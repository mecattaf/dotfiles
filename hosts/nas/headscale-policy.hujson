// Fleet isolation (2026-09-10). Headscale 0.28 uses acls, not grants.
// Explicit deny-by-default: lent laptops cannot reach each other, the house
// subnet, NAS SSH, or unrelated NAS services. They accept no routes or DNS.
//
// NAS is the only current tag:mesh node; pin its IPv4 identity as well so
// adding infrastructure cannot silently grant laptop access. Coordinator
// connects via NAS SSH forwarding with its own end-to-end admin key; its
// independent SaaS Tailscale identity is never migrated here.
//
// Reply traffic is stateful. TCP-only update exception: cache 8080 and signed
// offers 8091, inside the encrypted rail, with independent content signatures.
// No autoApprovers, friend-to-friend rule, wildcard port, or Tailscale SSH.
{
  "tagOwners": {
    "tag:mesh": ["tom@"],
    "tag:fleet": ["tom@"]
  },
  "acls": [
    {
      "action": "accept",
      "src": ["100.64.0.1/32"],
      "proto": "tcp",
      "dst": ["tag:fleet:22"]
    },
    {
      "action": "accept",
      "src": ["tag:fleet"],
      "proto": "tcp",
      "dst": ["100.64.0.1:8080", "100.64.0.1:8091"]
    }
  ]
}
