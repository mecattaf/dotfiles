+
+// Optional model filter is supplied from the currently connected PipeWire card,
+// never a configured MAC. The BLE address can rotate independently of pairing.
+fn expected_model() -> Result<Option<u16>, Box<dyn std::error::Error>> {
+    let args: Vec<String> = std::env::args().skip(1).collect();
+    if args.len() % 2 != 0 { return Err("usage: podpower [--address <connected device>] [--model-id <hex>]".into()); }
+    let mut model = None;
+    for pair in args.chunks_exact(2) {
+        match pair[0].as_str() {
+            "--model-id" => model = Some(u16::from_str_radix(&pair[1], 16)?),
+            "--address" => (),
+            _ => return Err("unknown podpower option".into()),
+        }
+    }
+    Ok(model)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn packet(model: u16, flip: u8, battery: u8, charging: u8) -> Vec<u8> {
+        let mut data = vec![0; 27];
+        data[..8].copy_from_slice(&[7, 0x19, 1, (model >> 8) as u8, model as u8, flip, battery, charging]);
+        data
+    }
+    fn value(data: &[u8]) -> serde_json::Value {
+        serde_json::to_value(parse_airpods_data(data).unwrap()).unwrap()
+    }
+    #[test]
+    fn validates_plaintext_status_header() {
+        assert!(parse_airpods_data(&[0; 27]).is_none());
+        let mut data = packet(0x1420, 0, 0x89, 0x4a);
+        data[2] = 7;
+        assert!(parse_airpods_data(&data).is_none());
+        assert!(parse_airpods_data(&[7, 0x19, 1]).is_none());
+    }
+    #[test]
+    fn sides_and_charging_follow_the_same_orientation() {
+        let flip = value(&packet(0x1420, 0, 0x89, 0x1a));
+        assert_eq!(flip["components"][0]["battery"], 85);
+        assert_eq!(flip["components"][1]["battery"], 95);
+        assert_eq!(flip["components"][0]["charging"], false);
+        assert_eq!(flip["components"][1]["charging"], true);
+        let normal = value(&packet(0x1420, 0x20, 0x89, 0x1a));
+        assert_eq!(normal["components"][0]["battery"], 95);
+        assert_eq!(normal["components"][0]["charging"], true);
+    }
+    #[test]
+    fn missing_components_remain_unknown_and_case_is_separate() {
+        let data = value(&packet(0x1420, 0, 0xff, 0x4a));
+        assert!(data.get("battery").is_none());
+        assert_eq!(data["components"].as_array().unwrap().len(), 1);
+        assert_eq!(data["components"][0]["name"], "case");
+        assert_eq!(data["components"][0]["battery"], 100);
+        assert_eq!(data["components"][0]["charging"], true);
+    }
+    #[test]
+    fn recognises_anc_and_usb_c_max_models() {
+        assert_eq!(value(&packet(0x1b20, 0, 0x89, 0xff))["model"], "AirPods 4 with ANC");
+        assert_eq!(value(&packet(0x1f20, 0, 0x89, 0xff))["type"], "over_ear");
+    }
+    #[test]
+    fn percentages_are_coarse_and_unknown_is_not_zero() {
+        assert_eq!(battery_level(0), Some(5));
+        assert_eq!(battery_level(10), Some(100));
+        for raw in 11..=15 { assert_eq!(battery_level(raw), None); }
+    }
+}
+
+fn model_name(model: u16) -> &'static str {
+    match model {
+        0x0220 => "AirPods 1",
+        0x0F20 => "AirPods 2",
+        0x1320 => "AirPods 3",
+        0x1920 => "AirPods 4",
+        0x1B20 => "AirPods 4 with ANC",
+        0x0E20 => "AirPods Pro",
+        0x1420 | 0x2420 => "AirPods Pro 2",
+        0x2720 => "AirPods Pro 3",
+        0x0A20 | 0x1F20 => "AirPods Max",
+        _ => "AirPods",
+    }
+}
