-    def _prompt(self, state: str, q: Question, media: Sequence[str]) -> str:
+    @staticmethod
+    def normalize_spec(spec):
+        """Keep System One's JSON descriptions, including false/zero values."""
+        def describe(value):
+            return value if isinstance(value, str) else json.dumps(value, ensure_ascii=False, allow_nan=False)
+
+        try:
+            instructions = describe(spec.instructions) if spec.instructions else ""
+            criteria = spec.criteria
+            if spec.type == "choice" and isinstance(criteria, dict):
+                criteria = {key: None if value is None else describe(value) for key, value in criteria.items()}
+            elif spec.type == "noul" and isinstance(criteria, dict):
+                criteria = {key: describe(value) if value else None for key, value in criteria.items()}
+            elif spec.type == "score" and isinstance(criteria, list):
+                criteria = [describe(value) for value in criteria]
+        except (ValueError, TypeError, RecursionError) as error:
+            raise StructuredDecisionError(f"not representable as JSON: {error}") from error
+        return spec.model_copy(update={"instructions": instructions, "criteria": criteria})
+
+    def _temperature_for(self, count: int) -> float:
+        if self.temperature_by_questions is None:
+            return self.temperature
+        table = self.temperature_by_questions
+        for bound, temperature in zip(table["max_questions"], table["temperature"]):
+            if count <= bound:
+                return float(temperature)
+        return float(table["temperature"][-1])
+
