From: dotfiles D3 investigation
Subject: [PATCH] Preserve D3 System One answer confidence and Noul contract

Reference: vllm-sr/d3-ultra 52ba9e7a00402f9560c7fba8c039608e7ddee7fb
Reference-files: d3_runtime.py product_answer, d3_format.py to_answer

Generic vLLM label answers expose maximum-label-probability confidence and
additional Noul probability keys. D3 uses normalized entropy confidence for
Choice/Score, canonical Score legends, and a scalar-only Noul answer.
Keep this specific to D3 on its native-compatible /v1/systemone surface.

--- a/vllm/entrypoints/openai/decisions/strategies.py
+++ b/vllm/entrypoints/openai/decisions/strategies.py
@@ -1309,6 +1309,25 @@
             raise StructuredDecisionError(f"not representable as JSON: {error}") from error
         return spec.model_copy(update={"instructions": instructions, "criteria": criteria})
 
+    @staticmethod
+    def systemone_answer(question, probabilities, original_criteria):
+        """The released D3 answer object, rather than generic label confidence."""
+        if question.type.name == "noul":
+            return {"type": "noul", "noul": probabilities[0]}
+        answer = question.type.answer(question, probabilities, 1.0)
+        count = len(probabilities)
+        answer["confidence"] = (
+            1.0 if count < 2 else max(0.0, min(1.0,
+                1.0 + sum(p * math.log(p) for p in probabilities if p > 0) / math.log(count)
+            ))
+        )
+        if question.type.name == "score":
+            answer["legend"] = {
+                str(i): value if isinstance(value, str) else json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
+                for i, value in enumerate(original_criteria)
+            }
+        return answer
+
     def _temperature_for(self, count: int) -> float:
         if self.temperature_by_questions is None:
             return self.temperature
--- a/vllm/entrypoints/generate/structured_decisions/serving.py
+++ b/vllm/entrypoints/generate/structured_decisions/serving.py
@@ -116,7 +116,11 @@
         diagnostics: dict[str, QuestionDiagnostics] = {}
         canvases: list[JointCanvas] = []
         for q, read in zip(questions, reads):
-            answers[q.id] = q.type.answer(q, read.probs, read.label_mass)
+            answers[q.id] = (
+                self.strategy.systemone_answer(q, read.probs, request.questions[q.id].criteria)
+                if isinstance(self.strategy, D3Strategy)
+                else q.type.answer(q, read.probs, read.label_mass)
+            )
             diagnostics[q.id] = QuestionDiagnostics(
                 label_mass=read.label_mass, argmax_is_label=read.argmax_is_label
             )
