+// outputPath resolves a command output file: the first of envVars that is set,
+// else def; a relative path is taken relative to the workspace.
+func outputPath(wsPath, def string, envVars ...string) string {
+	p := def
+	for _, v := range envVars {
+		if val := os.Getenv(v); val != "" {
+			p = val
+			break
+		}
+	}
+	if !filepath.IsAbs(p) {
+		p = filepath.Join(wsPath, p)
+	}
+	return p
+}
