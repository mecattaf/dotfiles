# Deliberate derivative of the source-pinned Linux psX configurations.
# Preserve all PS4 device code. Enable the normal NixOS nftables firewall
# and a real TUN interface for Tailscale. These changes require boot tests.
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_NETLINK=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_EVENTS=y
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NF_NAT=y
CONFIG_NF_LOG_SYSLOG=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y
CONFIG_NFT_REJECT_IPV4=y
CONFIG_NFT_REJECT_IPV6=y
CONFIG_NFT_FIB=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_NAT=y
CONFIG_NFT_COMPAT=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
# xt_tcpudp.o is built with NETFILTER_XTABLES; no separate Kconfig symbol.
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP6_NF_IPTABLES=y
# Legacy filter/mangle/NAT tables require NETFILTER_XTABLES_LEGACY. The
# fleet firewall and Tailscale use nftables, including nft counters/meta
# expressions built into NF_TABLES itself, so legacy tables stay disabled.
CONFIG_TUN=y

# Actual USB-root VM boot exposed journald ACL failures without this.
# Match normal NixOS Btrfs ownership/access semantics on the chosen rootfs.
CONFIG_BTRFS_FS_POSIX_ACL=y

# NixOS enables DefaultIPAccounting and its stock systemd units use
# IPAddressDeny. These require cgroup eBPF, independently of nftables.
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_JIT=y
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y
