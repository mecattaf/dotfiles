+test "static Kitty graphics snapshot follows replacement and deletion" {
+    const alloc = testing.allocator;
+    var source = try ghostty_vt.Terminal.init(testing.io, alloc, .{ .cols = 80, .rows = 24 });
+    defer source.deinit(alloc);
+    var input = source.vtStream();
+    defer input.deinit();
+    input.nextSlice("\x1b_Ga=T,f=24,s=1,v=1,i=7,q=2;/wAA\x1b\\");
+    input.nextSlice("\x1b_Ga=T,f=24,s=1,v=1,i=7,q=2;AP8A\x1b\\");
+    var replaced = try serializeRoundtrip(alloc, testing.io, &source);
+    defer replaced.deinit(alloc);
+    try testing.expectEqual(@as(usize, 1), replaced.screens.active.kitty_images.images.count());
+    const image = replaced.screens.active.kitty_images.images.get(7).?;
+    try testing.expectEqualSlices(u8, &.{ 0, 255, 0 }, image.data.bytes().?);
+    input.nextSlice("\x1b_Ga=d,d=I,i=7,q=2\x1b\\");
+    const snapshot = serializeTerminalState(alloc, &source) orelse return error.SerializationFailed;
+    defer alloc.free(snapshot);
+    var restored = replaced.vtStream();
+    defer restored.deinit();
+    restored.nextSlice(snapshot);
+    try testing.expectEqual(@as(usize, 0), replaced.screens.active.kitty_images.images.count());
+    try testing.expectEqual(@as(usize, 0), replaced.screens.active.kitty_images.placements.count());
+}
