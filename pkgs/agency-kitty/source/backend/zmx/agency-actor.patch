diff --git a/src/shadow_actor.zig b/src/shadow_actor.zig
new file mode 100644
index 0000000..8a8d507
--- /dev/null
+++ b/src/shadow_actor.zig
@@ -0,0 +1,132 @@
+//! Experimental 205 actor: only this worker feeds VT. The owner may borrow the
+//! terminal only after an exact FIFO barrier has completed, and holds the pause
+//! through any graphics iterator lifetime. No worker ever touches the PTY.
+const std = @import("std");
+const terminal = @import("terminal.zig");
+const posix = @import("posix.zig");
+
+pub const Actor = struct {
+    const MAX_CHUNKS = 8192;
+    const Chunk = struct { bytes: [4096]u8, len: usize, next: ?*Chunk = null };
+    allocator: std.mem.Allocator,
+    io: std.Io,
+    term: *terminal.ghostty_vt.Terminal,
+    mutex: std.Io.Mutex = .init,
+    changed: std.Io.Condition = .init,
+    head: ?*Chunk = null,
+    tail: ?*Chunk = null,
+    count: usize = 0, // Includes the currently decoding chunk.
+    enqueued_offset: u64 = 0,
+    parsed_offset: u64 = 0,
+    pause_requested: bool = false,
+    paused: bool = false,
+    stopping: bool = false,
+    thread: ?std.Thread = null,
+    wake: [2]posix.fd_t,
+
+    pub fn init(allocator: std.mem.Allocator, io: std.Io, term: *terminal.ghostty_vt.Terminal) !Actor {
+        return .{ .allocator = allocator, .io = io, .term = term, .wake = try posix.pipe2(.{ .CLOEXEC = true, .NONBLOCK = true }) };
+    }
+    pub fn start(self: *Actor) !void {
+        self.thread = try std.Thread.spawn(.{}, run, .{self});
+    }
+    pub fn deinit(self: *Actor) void {
+        self.mutex.lockUncancelable(self.io);
+        self.stopping = true;
+        self.changed.signal(self.io);
+        self.mutex.unlock(self.io);
+        if (self.thread) |thread| thread.join();
+        while (self.head) |chunk| {
+            self.head = chunk.next;
+            self.allocator.destroy(chunk);
+        }
+        posix.close(self.wake[0]);
+        posix.close(self.wake[1]);
+    }
+    fn notify(self: *Actor) void {
+        _ = posix.write(self.wake[1], "x") catch |err| {
+            if (err != error.WouldBlock) @panic("shadow actor wake pipe write failed");
+        };
+    }
+    pub fn drainWake(self: *Actor) void {
+        var buf: [256]u8 = undefined;
+        while (true) {
+            const n = posix.read(self.wake[0], &buf) catch |err| {
+                if (err == error.WouldBlock) return;
+                @panic("shadow actor wake pipe read failed");
+            };
+            if (n == 0) @panic("shadow actor wake pipe closed unexpectedly");
+        }
+    }
+    pub fn canFeed(self: *Actor) bool {
+        self.mutex.lockUncancelable(self.io);
+        defer self.mutex.unlock(self.io);
+        return !self.pause_requested and self.count < MAX_CHUNKS;
+    }
+    pub fn feed(self: *Actor, bytes: []const u8) !void {
+        std.debug.assert(bytes.len <= 4096);
+        // Owner-only admission precedes its PTY read; worker only frees slots.
+        const chunk = try self.allocator.create(Chunk);
+        errdefer self.allocator.destroy(chunk);
+        chunk.* = .{ .bytes = undefined, .len = bytes.len };
+        @memcpy(chunk.bytes[0..bytes.len], bytes);
+        self.mutex.lockUncancelable(self.io);
+        defer self.mutex.unlock(self.io);
+        std.debug.assert(!self.pause_requested and self.count < MAX_CHUNKS);
+        if (self.tail) |tail| tail.next = chunk else self.head = chunk;
+        self.tail = chunk;
+        self.count += 1;
+        self.enqueued_offset += bytes.len;
+        self.changed.signal(self.io);
+    }
+    pub fn requestPause(self: *Actor) void {
+        self.mutex.lockUncancelable(self.io);
+        defer self.mutex.unlock(self.io);
+        self.pause_requested = true;
+        self.changed.signal(self.io);
+    }
+    pub fn isPaused(self: *Actor) bool {
+        self.mutex.lockUncancelable(self.io);
+        defer self.mutex.unlock(self.io);
+        if (self.paused) std.debug.assert(self.parsed_offset == self.enqueued_offset);
+        return self.paused;
+    }
+    pub fn resumeParsing(self: *Actor) void {
+        self.mutex.lockUncancelable(self.io);
+        defer self.mutex.unlock(self.io);
+        self.pause_requested = false;
+        self.paused = false;
+        self.changed.signal(self.io);
+    }
+    fn run(self: *Actor) void {
+        var stream = self.term.vtStream();
+        defer stream.deinit();
+        self.mutex.lockUncancelable(self.io);
+        while (!self.stopping) {
+            if (self.pause_requested and self.head == null) {
+                if (!self.paused) {
+                    self.paused = true;
+                    self.notify();
+                }
+                self.changed.waitUncancelable(self.io, &self.mutex);
+                continue;
+            }
+            const chunk = self.head orelse {
+                self.changed.waitUncancelable(self.io, &self.mutex);
+                continue;
+            };
+            self.head = chunk.next;
+            if (self.head == null) self.tail = null;
+            self.mutex.unlock(self.io);
+            stream.nextSlice(chunk.bytes[0..chunk.len]);
+            const parsed = chunk.len;
+            self.allocator.destroy(chunk);
+            self.mutex.lockUncancelable(self.io);
+            const was_full = self.count == MAX_CHUNKS;
+            self.count -= 1;
+            self.parsed_offset += parsed;
+            if (was_full) self.notify();
+        }
+        self.mutex.unlock(self.io);
+    }
+};
