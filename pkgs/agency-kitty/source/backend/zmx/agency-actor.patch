new file mode 100644
index 0000000..b697eb0
--- /dev/null
+++ b/src/snapshot_guard.zig
@@ -0,0 +1,48 @@
+//! Conservative detection of a native Kitty extension the shadow drops.
+//! This is not another terminal parser: matching inside an enclosed string can
+//! produce a conservative false positive. Never clear the marker on a guessed
+//! reset; explicit text-only recovery remains available for the retained PTY.
+const std = @import("std");
+
+pub const Osc66 = struct {
+    prefix: u8 = 0,
+
+    pub fn feed(self: *Osc66, data: []const u8) bool {
+        var index: usize = 0;
+        while (index < data.len) {
+            if (self.prefix == 0) {
+                index += std.mem.indexOfAny(u8, data[index..], "\x1b\x9d") orelse return false;
+            }
+            const byte = data[index];
+            index += 1;
+            const restart: u8 = if (byte == 0x1b) 1 else if (byte == 0x9d) 2 else 0;
+            self.prefix = switch (self.prefix) {
+                0 => restart,
+                1 => if (byte == ']') 2 else restart,
+                2 => if (byte == '6') 3 else restart,
+                3 => if (byte == '6') 4 else restart,
+                4 => if (byte == ';') return true else restart,
+                else => unreachable,
+            };
+        }
+        return false;
+    }
+};
+
+test "OSC66 detector covers every split boundary and C1 prefix" {
+    for ([_][]const u8{ "\x1b]66;s=2;native\x1b\\", "\x9d66;s=2;native\x9c" }) |sequence| {
+        for (0..sequence.len + 1) |split| {
+            var detector: Osc66 = .{};
+            const first = detector.feed(sequence[0..split]);
+            const second = detector.feed(sequence[split..]);
+            try std.testing.expect(first or second);
+        }
+    }
+}
+
+test "OSC66 detector distinguishes ordinary OSC and resumes partial prefix" {
+    var detector: Osc66 = .{};
+    try std.testing.expect(!detector.feed("text\x1b]7;file://nas/x\x1b\\\x1b]660;other\x07"));
+    try std.testing.expect(!detector.feed("\x1b]6"));
+    try std.testing.expect(detector.feed("6;s=2;native\x07"));
+}
