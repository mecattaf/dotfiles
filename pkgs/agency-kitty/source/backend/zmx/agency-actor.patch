+    try testing.expectEqual(@as(usize, 1), source.screens.active.kitty_images.images.count());
+    var dest = try serializeRoundtrip(alloc, testing.io, &source);
+    defer dest.deinit(alloc);
+    const image = dest.screens.active.kitty_images.images.get(49408) orelse return error.ImageMissing;
+    try testing.expectEqualSlices(u8, &.{ 255, 0, 0, 255, 0, 255, 0, 255 }, image.data.bytes().?);
+    try testing.expectEqual(@as(u32, 2), image.width);
+    try testing.expectEqual(@as(u32, 1), image.height);
+    try testing.expectEqual(@as(usize, 1), dest.screens.active.kitty_images.placements.count());
+    var placements = dest.screens.active.kitty_images.placements.valueIterator();
+    const placement = placements.next().?;
+    const location = dest.screens.active.pages.pointFromPin(.active, placement.location.pin.*).?.active;
+    try testing.expectEqual(@as(u32, 4), location.y);
+    try testing.expectEqual(@as(u16, 6), location.x);
+    try testing.expectEqual(@as(u32, 6), placement.columns);
