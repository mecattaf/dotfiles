diff --git a/src/graphics_restore.zig b/src/graphics_restore.zig
new file mode 100644
index 0000000..28eb79d
--- /dev/null
+++ b/src/graphics_restore.zig
@@ -0,0 +1,156 @@
+//! Reconstruct static Kitty graphics from the existing VT shadow on attach.
+//! This adds no attached-mode renderer, application input, or raw output log.
+const std = @import("std");
+const vt = @import("ghostty-vt");
+const Graphics = vt.kitty.graphics;
+const Storage = Graphics.ImageStorage;
+
+/// libghostty leaves PNG support disabled for embedders. Reuse its already
+/// linked Wuffs dependency through the documented decoder callback. The caller
+/// wraps this allocator in libghostty's bounded decoder allocator.
+pub fn init() void {
+    vt.sys.decode_png = &decodePng;
+}
+
+fn decodePng(alloc: std.mem.Allocator, data: []const u8) vt.sys.DecodeError!vt.sys.Image {
+    const result = @import("wuffs").png.decode(alloc, data) catch |err| switch (err) {
+        error.WuffsError, error.Overflow => return error.InvalidData,
+        error.OutOfMemory => return error.OutOfMemory,
+    };
+    return .{ .width = result.width, .height = result.height, .data = result.data };
+}
+
+/// Unknown state refuses restoration rather than claiming visual parity.
+pub fn validate(term: *vt.Terminal) !void {
+    var screens = term.screens.all.iterator();
+    while (screens.next()) |entry| {
+        const screen = entry.value.*;
+        if (screen != term.screens.active and
+            (screen.kitty_images.images.count() != 0 or screen.kitty_images.loading != null))
+            return error.GraphicsInactiveScreenUnsupported;
+    }
+    const storage = &term.screens.active.kitty_images;
+    if (storage.loading != null) return error.GraphicsTransmissionInProgress;
+    var images = storage.images.valueIterator();
+    while (images.next()) |image| {
+        if (image.animation != null) return error.GraphicsAnimationUnsupported;
+        if (image.number != 0) return error.GraphicsImageNumberUnsupported;
+        if (image.metadata.transient) return error.GraphicsTransientImageUnsupported;
+        if (image.metadata.implicit_id) return error.GraphicsImplicitIdUnsupported;
+        if (image.data.bytes() == null) return error.GraphicsPendingData;
+        switch (image.format) {
+            .rgb, .rgba => {},
+            else => return error.GraphicsFormatUnsupported,
+        }
+    }
+    var placements = storage.placements.valueIterator();
+    while (placements.next()) |placement| {
+        switch (placement.location) {
+            .pin => |pin| {
+                if (term.screens.active.pages.pointFromPin(.active, pin.*) == null)
+                    return error.GraphicsHistoryPlacementUnsupported;
+            },
+            .virtual, .relative => return error.GraphicsPlacementUnsupported,
+        }
+    }
+}
+
+/// An incremental snapshot iterator holds references to the existing image
+/// state, not another decoded/base64 copy. Its owner MUST pause PTY parsing
+/// and terminal mutations until done. One next() emits at most 4352 bytes.
+pub const State = struct {
+    term: *vt.Terminal,
+    phase: enum { clear, images, placements, finish, done } = .clear,
+    images: std.AutoHashMapUnmanaged(u32, Graphics.Image).ValueIterator,
+    placements: std.AutoHashMapUnmanaged(Storage.PlacementKey, Storage.Placement).Iterator,
+    image: ?*Graphics.Image = null,
+    offset: usize = 0,
+
+    pub fn create(term: *vt.Terminal) !State {
+        try validate(term);
+        return .{
+            .term = term,
+            .images = term.screens.active.kitty_images.images.valueIterator(),
+            .placements = term.screens.active.kitty_images.placements.iterator(),
+        };
+    }
+
+    pub fn next(self: *State, writer: *std.Io.Writer) !bool {
+        switch (self.phase) {
+            .clear => {
+                // The active screen is being replaced by its authoritative
+                // snapshot. Remove data left by a previous client attachment.
+                try writer.writeAll("\x1b_Ga=d,d=A,q=2\x1b\\");
+                if (self.term.screens.active.kitty_images.images.count() == 0) {
+                    self.phase = .done;
+                } else {
+                    try writer.writeAll("\x1b7\x1b[?6l");
+                    self.phase = .images;
+                }
+                return true;
+            },
+            .images => {
+                const image = self.image orelse self.images.next() orelse {
+                    self.phase = .placements;
+                    return self.next(writer);
+                };
+                self.image = image;
+                const data = image.data.bytes().?;
+                const end = @min(self.offset + 3072, data.len);
+                var encoded: [4096]u8 = undefined;
+                const chunk = std.base64.standard.Encoder.encode(&encoded, data[self.offset..end]);
+                if (self.offset == 0) {
+                    try writer.print("\x1b_Ga=t,f={d},s={d},v={d},i={d},I={d},q=2,m={d};", .{
+                        @as(u8, if (image.format == .rgb) 24 else 32),
+                        image.width,
+                        image.height,
+                        image.id,
+                        image.number,
+                        @as(u8, if (end < data.len) 1 else 0),
+                    });
+                } else {
+                    try writer.print("\x1b_Gm={d};", .{@as(u8, if (end < data.len) 1 else 0)});
+                }
+                try writer.writeAll(chunk);
+                try writer.writeAll("\x1b\\");
+                self.offset = end;
+                if (end == data.len) {
+                    self.image = null;
+                    self.offset = 0;
+                }
+                return true;
+            },
+            .placements => {
+                const entry = self.placements.next() orelse {
+                    self.phase = .finish;
+                    return self.next(writer);
+                };
+                const key = entry.key_ptr.*;
+                const placement = entry.value_ptr.*;
+                const point = self.term.screens.active.pages.pointFromPin(.active, placement.location.pin.*).?.active;
+                // p=0 preserves anonymous-placement behavior; private shadow
+                // placement IDs must not become application-controlled IDs.
+                const placement_id = if (key.placement_id.tag == .external) key.placement_id.id else 0;
+                try writer.print("\x1b[{d};{d}H\x1b_Ga=p,i={d},p={d},q=2,C=1,x={d},y={d},w={d},h={d},X={d},Y={d},c={d},r={d},z={d}\x1b\\", .{
+                    point.y + 1,        point.x + 1,        key.image_id,           placement_id,
+                    placement.source_x, placement.source_y, placement.source_width, placement.source_height,
+                    placement.x_offset, placement.y_offset, placement.columns,      placement.rows,
+                    placement.z,
+                });
+                return true;
+            },
+            .finish => {
+                if (self.term.modes.get(.origin)) try writer.writeAll("\x1b[?6h");
+                try writer.writeAll("\x1b8");
+                self.phase = .done;
+                return true;
+            },
+            .done => return false,
+        }
+    }
+};
+
+pub fn write(writer: *std.Io.Writer, term: *vt.Terminal) !void {
+    var state = try State.create(term);
+    while (try state.next(writer)) {}
+}
