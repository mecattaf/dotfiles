@@ -0,0 +1,81 @@
+//! Streams validated native drag lifecycle events for the desktop shell.
+
+use std::io::{BufRead, BufReader, Read, Write};
+use std::os::unix::net::UnixStream;
+use std::path::Path;
+use std::time::Duration;
+
+use domicile_protocol::{ChromeMessage, HostMessage, SystemEvent, SystemReply, SystemRequest};
+
+/// The compositor socket of the desktop that spawned this process.
+pub const SOCKET: &str = "DOMICILE_NATIVE_DRAG_SOCKET";
+
+/// Connects to one desktop and writes its native drag events as JSON lines.
+pub fn watch(socket: &Path, output: &mut impl Write) -> Result<(), String> {
+    if !socket.is_absolute() {
+        return Err(format!("{SOCKET} must be an absolute socket path"));
+    }
+    let mut connection = UnixStream::connect(socket)
+        .map_err(|why| format!("cannot connect to {}: {why}", socket.display()))?;
+    connection
+        .set_read_timeout(Some(Duration::from_secs(5)))
+        .map_err(|why| format!("cannot set native drag startup timeout: {why}"))?;
+    serde_json::to_writer(
+        &mut connection,
+        &ChromeMessage::SystemRequest {
+            id: 1,
+            request: SystemRequest::NativeDragEvents,
+        },
+    )
+    .map_err(|why| format!("cannot send native drag subscription: {why}"))?;
+    connection
+        .write_all(b"\n")
+        .map_err(|why| format!("cannot send native drag subscription: {why}"))?;
+    let mut reader = BufReader::new(connection);
+    match next(&mut reader)? {
+        HostMessage::SystemReply {
+            id: 1,
+            reply: SystemReply::Started,
+        } => {}
+        other => return Err(format!("native drag subscription was refused: {other:?}")),
+    }
+    reader
+        .get_ref()
+        .set_read_timeout(None)
+        .map_err(|why| format!("cannot wait for native drag events: {why}"))?;
+    output
+        .write_all(b"{\"kind\":\"ready\"}\n")
+        .and_then(|()| output.flush())
+        .map_err(|why| format!("cannot report native drag readiness: {why}"))?;
+    loop {
+        match next(&mut reader)? {
+            HostMessage::SystemEvent {
+                id: 1,
+                event: event @ SystemEvent::NativeDrag { .. },
+            } => {
+                serde_json::to_writer(&mut *output, &event)
+                    .map_err(|why| format!("cannot write native drag event: {why}"))?;
+                output
+                    .write_all(b"\n")
+                    .and_then(|()| output.flush())
+                    .map_err(|why| format!("cannot write native drag event: {why}"))?;
+            }
+            other => return Err(format!("unexpected native drag message: {other:?}")),
+        }
+    }
+}
+
+fn next(reader: &mut BufReader<UnixStream>) -> Result<HostMessage, String> {
+    let mut wire = Vec::new();
+    reader
+        .take(4097)
+        .read_until(b'\n', &mut wire)
+        .map_err(|why| format!("cannot read native drag event: {why}"))?;
+    if wire.is_empty() {
+        return Err("the native drag compositor connection closed".into());
+    }
+    if wire.len() > 4096 || wire.last() != Some(&b'\n') {
+        return Err("a native drag event exceeds 4096 bytes".into());
+    }
+    serde_json::from_slice(&wire).map_err(|why| format!("invalid native drag event: {why}"))
+}
