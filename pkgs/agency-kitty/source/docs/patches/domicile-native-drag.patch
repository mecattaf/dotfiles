+//! Reports this desktop's validated native drag lifecycle as JSON lines.
+
+use std::path::PathBuf;
+use std::process::ExitCode;
+
+use domicile_launch::native_drag::{watch, SOCKET};
+
+fn main() -> ExitCode {
+    let socket = match std::env::var_os(SOCKET) {
+        Some(socket) => PathBuf::from(socket),
+        None => {
+            eprintln!(
+                "domicile-native-drag-events: {SOCKET} is not set; run inside the intended desktop"
+            );
+            return ExitCode::FAILURE;
+        }
+    };
+    match watch(&socket, &mut std::io::stdout().lock()) {
+        Ok(()) => ExitCode::SUCCESS,
+        Err(why) => {
+            eprintln!("domicile-native-drag-events: {why}");
+            ExitCode::FAILURE
+        }
+    }
+}
