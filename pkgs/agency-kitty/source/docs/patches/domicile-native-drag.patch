+impl ClientDndGrabHandler for DomicileCompositor {
+    fn started(
+        &mut self,
+        _source: Option<WlDataSource>,
+        _icon: Option<WlSurface>,
+        seat: Seat<Self>,
+    ) {
+        // Smithay calls this only after validating the implicit grab serial.
+        let origin = seat
+            .get_pointer()
+            .and_then(|pointer| pointer.grab_start_data())
+            .and_then(|grab| grab.focus.map(|(surface, _)| surface));
+        if let Some(app_id) = origin.and_then(|surface| self.window_of(&surface)) {
+            self.hub.outbound.native_drag(Some(app_id));
+        }
+    }
+
+    fn dropped(&mut self, _target: Option<WlSurface>, _validated: bool, _seat: Seat<Self>) {
+        self.hub.outbound.native_drag(None);
+    }
+}
 
 impl ServerDndGrabHandler for DomicileCompositor {}
 
