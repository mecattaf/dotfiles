@@ -0,0 +1,60 @@
+use std::io::{BufRead, BufReader, Write};
+use std::os::unix::net::UnixListener;
+use std::thread;
+
+use domicile_launch::native_drag::watch;
+
+#[test]
+fn the_cli_stream_reports_readiness_then_native_events_and_connection_loss() {
+    let directory = tempfile::tempdir().unwrap();
+    let socket = directory.path().join("chrome.sock");
+    let listener = UnixListener::bind(&socket).unwrap();
+    let server = thread::spawn(move || {
+        let (mut stream, _) = listener.accept().unwrap();
+        let mut request = String::new();
+        BufReader::new(stream.try_clone().unwrap())
+            .read_line(&mut request)
+            .unwrap();
+        assert_eq!(
+            serde_json::from_str::<serde_json::Value>(&request).unwrap(),
+            serde_json::json!({"type":"system_request", "id":1, "request":{"call":"native_drag_events"}})
+        );
+        stream.write_all(b"{\"type\":\"system_reply\",\"id\":1,\"reply\":{\"kind\":\"started\"}}\n{\"type\":\"system_event\",\"id\":1,\"event\":{\"kind\":\"native_drag\",\"app_id\":\"app-7\"}}\n{\"type\":\"system_event\",\"id\":1,\"event\":{\"kind\":\"native_drag\",\"app_id\":null}}\n").unwrap();
+    });
+    let mut output = Vec::new();
+    let error = watch(&socket, &mut output).unwrap_err();
+    server.join().unwrap();
+    assert!(error.contains("connection closed"));
+    let events: Vec<serde_json::Value> = String::from_utf8(output)
+        .unwrap()
+        .lines()
+        .map(|line| serde_json::from_str(line).unwrap())
+        .collect();
+    assert_eq!(
+        events,
+        vec![
+            serde_json::json!({"kind":"ready"}),
+            serde_json::json!({"kind":"native_drag", "app_id":"app-7"}),
+            serde_json::json!({"kind":"native_drag", "app_id":null})
+        ]
+    );
+}
+
+#[test]
+fn an_unterminated_large_native_drag_message_is_bounded() {
+    let directory = tempfile::tempdir().unwrap();
+    let socket = directory.path().join("chrome.sock");
+    let listener = UnixListener::bind(&socket).unwrap();
+    let server = thread::spawn(move || {
+        let (mut stream, _) = listener.accept().unwrap();
+        let mut request = String::new();
+        BufReader::new(stream.try_clone().unwrap())
+            .read_line(&mut request)
+            .unwrap();
+        stream.write_all(&[b'x'; 4097]).unwrap();
+    });
+    assert!(watch(&socket, &mut Vec::new())
+        .unwrap_err()
+        .contains("4096 bytes"));
+    server.join().unwrap();
+}
