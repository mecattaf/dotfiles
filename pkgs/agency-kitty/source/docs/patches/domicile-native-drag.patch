+use domicile_protocol::{HostMessage, SystemRequest};
+
+#[test]
+fn native_drag_events_is_a_typed_subscription() {
+    let request: SystemRequest = serde_json::from_str(r#"{"call":"native_drag_events"}"#)
+        .expect("the desktop can subscribe to native drag lifecycle events");
+    assert_eq!(
+        serde_json::to_value(request).unwrap(),
+        serde_json::json!({"call": "native_drag_events"})
+    );
+}
+
+#[test]
+fn native_drag_start_and_end_are_typed_events() {
+    for event in [
+        serde_json::json!({"kind": "native_drag", "app_id": "app-7"}),
+        serde_json::json!({"kind": "native_drag", "app_id": null}),
+    ] {
+        let message = serde_json::json!({"type": "system_event", "id": 7, "event": event});
+        let parsed: HostMessage = serde_json::from_value(message.clone())
+            .expect("the desktop receives native drag lifecycle events");
+        assert_eq!(serde_json::to_value(parsed).unwrap(), message);
+    }
+}
