--- a/src/imagine/SessionCatalogue.test.ts
+++ b/src/imagine/SessionCatalogue.test.ts
@@ -48,3 +48,34 @@ test("relay exit cancels open readers and promptly marks cached metadata unavail
   expect(frames.some(f => f.type === "unavailable")).toBeTrue();
   expect(cancelled).toBe(2);
 });
+
+const nativeRoute = (changes: Record<string, unknown> = {}) => ({version:1,provider:"agency-kitty",server:"agency-web",host:"nas",session:"session-test",terminal:"11111111-1111-4111-8111-111111111111",windowClass:"agencykitty-11111111111141118111111111111111",mode:"persistent",resumable:true,...changes});
+const withNative = (route = nativeRoute()) => receive(baseline(),{type:"native-terminals",available:true,terminals:[{title:"Native agent",route}]},"agency-web");
+test("native provider joins by chat id while keeping its terminal UUID and existing DSH provider distinct",()=>{
+  let cat=withNative();
+  cat=receive(cat,{type:"terminals",available:true,terminals:[{title:"DSH PTY",route:{version:1,server:"agency-web",epoch:"epoch",session:"session-test",terminal:"dsh-owned",windowClass:"dsh-terminal-"+"a".repeat(20)}}]},"agency-web");
+  const terminals=projectCatalogue(cat,initialAgencyState())[0]!.terminals;
+  expect(terminals).toHaveLength(2);expect(terminals[1]!.route.terminal).toBe(nativeRoute().terminal);
+  expect(terminals[1]!.canOpen).toBeTrue();
+  expect(()=>withNative(nativeRoute({windowClass:"dsh-terminal-"+"a".repeat(20)}))).toThrow();
+  expect(()=>withNative(nativeRoute({host:"client"}))).toThrow();
+});
+test("live direct windows can focus but absent or ambiguous windows never trigger a replacement",()=>{
+  const route=nativeRoute({mode:"direct",resumable:false});
+  const cat=withNative(route);
+  expect(projectCatalogue(cat,initialAgencyState())[0]!.terminals[0]!.canOpen).toBeFalse();
+  let state=reduce(initialAgencyState(),A.AppAppeared("app-one","Kitty"));
+  state=reduce(state,A.AppDesktopIdChanged("app-one",route.windowClass));
+  expect(projectCatalogue(cat,state)[0]!.terminals[0]!.id).toBe("app:app-one");
+  expect(projectCatalogue(cat,state)[0]!.terminals[0]!.canOpen).toBeTrue();
+  state=reduce(state,A.AppAppeared("app-two","Kitty"));
+  state=reduce(state,A.AppDesktopIdChanged("app-two",route.windowClass));
+  expect(projectCatalogue(cat,state)[0]!.terminals[0]!.ambiguous).toBeTrue();
+  expect(projectCatalogue(cat,state)[0]!.terminals[0]!.canOpen).toBeFalse();
+  expect(()=>withNative(nativeRoute({mode:"direct",resumable:true}))).toThrow();
+});
+test("metadata transport loss clears native launch availability and malformed duplicates are refused",()=>{
+  const cat=receive(withNative(),{type:"native-terminals",available:false},"agency-web");
+  expect(cat.nativeTerminals).toHaveLength(0);
+  expect(()=>receive(baseline(),{type:"native-terminals",available:true,terminals:[{title:"one",route:nativeRoute()},{title:"two",route:nativeRoute()}]},"agency-web")).toThrow();
+});
