+// The only names the herdr CLI needs. dsh's own environment carries the model
+// key, which the herdr child has no use for.
+const CHILD_ENV = ['PATH', 'HOME', 'XDG_CONFIG_HOME', 'HERDR_SOCKET_PATH', 'HERDR_SESSION', 'HERDR_ENV', 'HERDR_PANE_ID', 'LANG']
+
+export function childEnv(env: NodeJS.ProcessEnv = process.env): NodeJS.ProcessEnv {
+  const out: NodeJS.ProcessEnv = {}
+  for (const key of CHILD_ENV) if (env[key] !== undefined) out[key] = env[key]
+  return out
+}
