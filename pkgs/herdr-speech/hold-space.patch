+/// Launch the configured thin-client dictation adapter with private control pipes.
+pub(crate) fn spawn_dictation_helper(program: &str, pane: &str) -> std::io::Result<std::process::Child> {
+    let mut command = std::process::Command::new(program);
+    configure_background_command(&mut command);
+    command.env("HERDR_DICTATION_PANE", pane).stdin(std::process::Stdio::piped()).stdout(std::process::Stdio::piped()).stderr(std::process::Stdio::null()).spawn()
+}
