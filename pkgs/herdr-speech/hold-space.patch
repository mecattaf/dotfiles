+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn state() -> ClientShellState {
+        let mut state = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+        state.set_snapshot(Box::new(super::super::tests::snapshot()));
+        state.overlay = None;
+        state.dictation.command = Some("/nonexistent/dictation-test".into());
+        state
+    }
+    fn space(kind: KeyEventKind) -> crate::input::TerminalKey {
+        crate::input::TerminalKey::new(KeyCode::Char(' '), KeyModifiers::empty()).with_kind(kind)
+    }
+    fn text(out: &ClientShellInput) -> String {
+        out.requests
+            .iter()
+            .flat_map(|message| match message {
+                ClientMessage::ClientShellPaneInput { events, .. } => events
+                    .iter()
+                    .filter_map(|e| match e {
+                        ClientPaneInputEvent::TextCommit(t) => Some(t.clone()),
+                        _ => None,
+                    })
+                    .collect::<Vec<_>>(),
+                _ => vec![],
+            })
+            .collect()
+    }
+    #[test]
+    fn dictation_initial_pane_focus_is_client_scoped_and_once() {
+        let mut s = state();
+        let mut out = ClientShellInput::default();
+        s.dictation.initial_pane = Some("w1:p1".into());
+        s.tick_dictation(Instant::now(), &mut out);
+        assert!(!out.actions.is_empty());
+        assert!(s.dictation.initial_pane.is_none());
+        let mut second = ClientShellInput::default();
+        s.tick_dictation(Instant::now(), &mut second);
+        assert!(second.actions.is_empty());
+    }
+    #[test]
+    fn dictation_media_keys_do_not_flush_or_cancel_a_hold() {
+        let mut s = state();
+        let mut out = ClientShellInput::default();
+        s.handle_dictation_key(&space(KeyEventKind::Press), &mut out);
+        let key = crate::input::TerminalKey::new(
+            KeyCode::Media(crossterm::event::MediaKeyCode::MuteVolume),
+            KeyModifiers::empty(),
+        );
+        assert!(!s.handle_dictation_key(&key, &mut out));
+        assert!(s.dictation.pending.is_some());
+        assert!(out.requests.is_empty());
+    }
+    #[test]
+    fn dictation_tap_preserves_one_space() {
+        let mut s = state();
+        let mut out = ClientShellInput::default();
+        assert!(s.handle_dictation_key(&space(KeyEventKind::Press), &mut out));
+        assert!(out.requests.is_empty());
+        assert!(s.handle_dictation_key(&space(KeyEventKind::Release), &mut out));
+        assert_eq!(text(&out), " ");
+        assert!(!s.dictation.active());
+    }
+    #[test]
+    fn dictation_space_leader_flushes_before_next_key() {
+        let mut s = state();
+        let mut out = ClientShellInput::default();
+        s.handle_dictation_key(&space(KeyEventKind::Press), &mut out);
+        let key = crate::input::TerminalKey::new(KeyCode::Char('f'), KeyModifiers::empty());
+        assert!(!s.handle_dictation_key(&key, &mut out));
+        assert_eq!(text(&out), " ");
+        s.handle_dictation_key(&space(KeyEventKind::Release), &mut out);
+        assert_eq!(text(&out), " ");
+    }
+    #[test]
+    fn dictation_focus_loss_discards_pending_space() {
+        let mut s = state();
+        let mut out = ClientShellInput::default();
+        s.handle_dictation_key(&space(KeyEventKind::Press), &mut out);
+        s.outer_focused = Some(false);
+        s.tick_dictation(Instant::now(), &mut out);
+        s.handle_dictation_key(&space(KeyEventKind::Release), &mut out);
+        assert!(out.requests.is_empty());
+        assert!(!s.dictation.active());
+    }
+    #[test]
+    fn dictation_repeat_does_not_type_spaces() {
+        let mut s = state();
+        let mut out = ClientShellInput::default();
+        s.handle_dictation_key(&space(KeyEventKind::Press), &mut out);
+        for _ in 0..5 {
+            assert!(s.handle_dictation_key(&space(KeyEventKind::Repeat), &mut out));
+        }
+        assert!(out.requests.is_empty());
+    }
+    #[test]
+    fn dictation_disabled_and_prefix_leave_keys_alone() {
+        let mut s = state();
+        let mut out = ClientShellInput::default();
+        s.mode = ClientShellMode::Prefix;
+        assert!(!s.handle_dictation_key(&space(KeyEventKind::Press), &mut out));
+        s.mode = ClientShellMode::Terminal;
+        s.dictation.command = None;
+        assert!(!s.handle_dictation_key(&space(KeyEventKind::Press), &mut out));
+    }
+}
