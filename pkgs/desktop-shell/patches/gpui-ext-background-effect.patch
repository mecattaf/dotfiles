+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum BackgroundBlurProtocol {
+    None,
+    Ext,
+    Kde,
+}
+
+fn background_blur_protocol(blurred: bool, ext: bool, kde: bool) -> BackgroundBlurProtocol {
+    if !blurred {
+        BackgroundBlurProtocol::None
+    } else if ext {
+        BackgroundBlurProtocol::Ext
+    } else if kde {
+        BackgroundBlurProtocol::Kde
+    } else {
+        BackgroundBlurProtocol::None
+    }
+}
+
+fn update_background_effect(state: &mut WaylandWindowState) {
+    let protocol = background_blur_protocol(
+        state.background_appearance == WindowBackgroundAppearance::Blurred,
+        state.globals.background_effect_manager.is_some()
+            && state.globals.background_blur_supported.get(),
+        state.globals.blur_manager.is_some(),
+    );
+
+    if protocol != BackgroundBlurProtocol::Ext {
+        if let Some(effect) = state.background_effect.take() {
+            // NULL removes blur; unlike KDE, NULL never means the whole surface.
+            effect.set_blur_region(None);
+            effect.destroy();
+        }
+    }
+    if protocol != BackgroundBlurProtocol::Kde {
+        if let Some(blur) = state.blur.take() {
+            if let Some(manager) = &state.globals.blur_manager {
