+                assert_eq!(background_blur_protocol(false, ext, kde), BackgroundBlurProtocol::None);
+            }
+        }
+        assert_eq!(background_blur_protocol(true, true, true), BackgroundBlurProtocol::Ext);
+        assert_eq!(background_blur_protocol(true, true, false), BackgroundBlurProtocol::Ext);
+        assert_eq!(background_blur_protocol(true, false, true), BackgroundBlurProtocol::Kde);
+        assert_eq!(background_blur_protocol(true, false, false), BackgroundBlurProtocol::None);
