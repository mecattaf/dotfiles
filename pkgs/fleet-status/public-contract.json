  "hosts": [
    "nas",
    "strix-coordinator",
    "client",
    "strix-worker"
  ],
  "subjectPatterns": {
    "fleet": {
      "id": "fleet",
      "label": "Fleet"
    },
    "host": {
      "id": "host-(nas|strix-coordinator|client|strix-worker)",
      "label": "NAS|Strix coordinator|Zenbook|Strix worker"
    },
    "provider": {
      "id": "provider-[a-z]+",
      "label": "Use the providers lookup only"
    },
    "account": {
      "id": "account-[a-z]+-[1-9][0-9]?",
      "label": "Provider label plus account N"
    },
    "quota-bucket": {
      "id": "quota-[a-z]+-[1-9][0-9]?-[a-z0-9-]+",
      "label": "Provider quota"
    },
    "instance": {
      "id": "instance-[a-f0-9]{24}",
      "label": "DSH instance"
    },
    "session": {
      "id": "session-[a-f0-9]{24}",
      "label": "DSH session"
    },
    "invocation": {
      "id": "invocation-[a-f0-9]{24}",
      "label": "Supervised run"
    }
  },
  "eventSummaries": {
    "run.started": "Supervised run started",
    "run.ended": "Supervised run ended",
    "session.status": "DSH session state changed",
    "model.span": "DSH model step completed",
    "collector.error": "Observation source failed",
    "collector.gap": "Observation coverage has a gap"
  },
  "stringDomains": {
    "host.reachability": [
      "reachable",
      "unreachable",
      "timeout",
      "error"
    ],
    "instance.state": [
      "running",
      "stopped",
      "starting",
      "failed",
      "idle",
      "unknown",
      "masked",
      "inconsistent",
      "orphaned",
      "interrupted",
      "exited",
      "draining"
