  "valuePolicy": "Only null, finite numbers, booleans and bounded strings; no arbitrary objects/arrays in initial producer. Keys ending At are RFC3339 UTC or null. Public source keys must belong to this reviewed source whitelist.",
  "errorCodes": [
    "source-timeout",
    "source-failed",
    "source-unavailable",
    "stale",
    "not-instrumented",
    "cursor-gap",
    "unsupported",
    "budget-truncated",
    "initial-enrollment",
    "unauthenticated",
    "missing-credential"
  ],
  "scopes": [
    "host-total",
    "this-instance",
    "this-publisher-only",
    "provider-reported",
    "shared-quota-bucket",
    "this-observer-only"
  ],
  "providers": {
    "claude": "Claude",
    "codex": "Codex",
    "openrouter": "OpenRouter",
    "google": "Google API",
    "groq": "Groq",
    "cohere": "Cohere",
    "mistral": "Mistral",
    "nvidia": "NVIDIA NIM",
