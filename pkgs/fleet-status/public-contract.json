    "instance.transport": [
      "web",
      "acp",
      "headless",
      "unknown"
    ],
    "session.state": [
      "active",
      "idle",
      "completed",
      "failed",
      "cancelled",
      "unknown"
    ],
    "span.kind": [
      "model"
    ],
    "span.status": [
      "completed",
      "failed",
      "cancelled"
    ],
    "quota.metric": [
      "requests",
      "tokens",
      "neurons",
      "usd",
      "percent"
    ],
    "quota.scope": [
      "shared-quota-bucket",
      "provider-reported"
    ],
    "subscription.windowKind": [
      "weekly",
      "five-hour",
      "daily",
      "monthly",
      "other"
    ],
    "subscription.providerSeverity": [
      "normal",
      "warning",
      "critical",
      "unknown"
    ],
    "device.powerAccountingKind": [
      "soc"
    ],
    "gpu.memoryAccountingKind": [
      "shared-apu"
    ]
