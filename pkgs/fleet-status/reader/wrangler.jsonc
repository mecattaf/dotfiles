{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fleet-status-reader",
  "main": "src/reader.ts",
  "compatibility_date": "2026-11-15",
  "workers_dev": false,
  "routes": [{ "pattern": "status.mecattaf.dev", "custom_domain": true }],
  "r2_buckets": [{ "binding": "PUBLIC_STATUS", "bucket_name": "fleet-status-public" }],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "observability": { "enabled": true, "logs": { "enabled": true }, "traces": { "enabled": true, "head_sampling_rate": 0.01 } }
}
