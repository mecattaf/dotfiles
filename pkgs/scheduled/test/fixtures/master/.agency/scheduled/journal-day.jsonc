// Copied 12 Nov 2026 from ~/.agency/workflows/journal-day.jsonc (kept there).
// Rewritten to the scheduled-item schema: outcome.check and context moved into the prompt.
{
  "name": "Journal day: midnight nudge",
  // Off (Tom, 11 Nov: "make sure there are no scheduled work in the morning").
  "enabled": false,
  "on": { "schedule": [ { "cron": "0 0 * * *", "timezone": "Europe/Paris" } ] },
  "job": {
    "prompt": [
      "Take the local date (Europe/Paris) of the Due or Requested time in the header above.",
      "If ~/today already resolves to ~/notes/journal/YYYY/MM/DD for that date, do nothing and say so.",
      "Otherwise run ~/.local/bin/journal-day once, with no arguments. It is idempotent and takes its own lock.",
      "It rotates only the ~/today link; it never moves, copies or deletes day contents and never touches running sessions.",
      "Report the path it prints. If it exits non-zero, report its stderr word for word and stop.",
      "Change nothing else: no other file, no notes, no Projects item."
    ]
  }
}
