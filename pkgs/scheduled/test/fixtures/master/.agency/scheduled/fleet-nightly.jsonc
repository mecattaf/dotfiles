// Copied 12 Nov 2026 from ~/.agency/workflows/fleet-nightly.jsonc (kept there), then rewritten the same night
// into the start nudge of Tom's midnight sequence (2026-09-20 R6/R7): "a midnight sequence full archival
// followed by a dedicated dotfiles operation: check if open gh issues that were filed today are closed otherwise
// cc opus works on them (culminating in a clean tree); then does the atomic fleet update so that the morning is
// fresh". The order lives in the workflow script .agency/workflows/fleet-nightly.js; this item only asks the
// superagent to start it (a jsonc item is a nudge; there is no workflow key). The old fleet-update steps are the
// script's last node. 01:00 follows journal-day's 00:00 nudge and stays out of the 02:00 DST gap.
{
  "name": "Midnight sequence: archival, today's dotfiles issues, fleet update",
  // Off (Tom, 11 Nov: "make sure there are no scheduled work in the morning"). Only Tom arms it.
  "enabled": false,
  "on": { "schedule": [ { "cron": "0 1 * * *", "timezone": "Europe/Paris" } ] },
  "job": {
    "prompt": [
      "This is a request to you, the superagent, not work for a worker. Do not accept it as a ticket.",
      "The night key is the date of the Due time in the header minus 12 hours, as YYYY-MM-DD.",
      "If orchestrator_workflow_status shows a fleet-nightly run for that night key still running, start nothing and ignore this trigger with the reason: already running <that run id>.",
      "Otherwise call orchestrator_workflow_start with script .agency/workflows/fleet-nightly.js, cwd the agency folder (the record's cwd), args {\"night\": \"<night key>\"} and trigger_id this trigger's id.",
      "Then ignore this trigger with the reason: started workflow <the run id you got>."
    ]
  }
}
