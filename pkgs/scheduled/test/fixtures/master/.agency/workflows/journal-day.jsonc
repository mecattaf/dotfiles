// ~/.agency/workflows/journal-day.jsonc
// Midnight nudge (Tom, 10 Nov): "journal day is scheduled to nudge
// at midnight, moving the symlink".
{
  "name": "Journal day: midnight nudge",
  // Off at install (Tom, 11 Nov: "make sure there are no scheduled work
  // in the morning"). Arm with: scheduled set <id> enabled true
  "enabled": false,
  "on": {
    "schedule": [
      { "cron": "0 0 * * *", "timezone": "Europe/Paris" }
    ]
  },
  // No window: a nudge missed during a power cut still runs at the
  // first pass after boot, whatever the hour (latest only).
  "outcome": {
    "goal": "~/today points at today's journal folder",
    // Exit 0 means the link is already right: no run at all.
    "check": { "sh": [
      "d=$(printf %s \"$SCHED_LOCAL_DATE\" | tr - /)",
      "test ~/today -ef ~/notes/journal/\"$d\""
    ] }
  },
  "context": { "previous": 1, "diff": false },
  "job": {
    "timeout": "10m",
    "prompt": [
      "Run ~/.local/bin/journal-day once, with no arguments. It is",
      "idempotent and takes its own lock. It rotates only the",
      "~/today link; it never moves, copies or deletes day contents",
      "and never touches running sessions.",
      "Report the path it prints. If it exits non-zero, report its",
      "stderr word for word and stop. Change nothing else: no other",
      "file, no notes, no Projects item."
    ]
  }
}
