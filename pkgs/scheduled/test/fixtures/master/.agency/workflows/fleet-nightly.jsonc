// ~/.agency/workflows/fleet-nightly.jsonc
// Baseline case (Tom, 10 Nov): "the dotfiles nightly update and nixos
// flash on the fleet". fleet-update (dotfiles PR #642) owns the input
// bump, builds, adoption, per-target idle checks and activation. This
// run launches it and reports; the check reads its verified receipt.
// Armed by Tom: scheduled set master:fleet-nightly enabled true
{
  "name": "Dotfiles nightly update and fleet flash",
  // Off at install (Tom, 11 Nov: "make sure there are no scheduled work
  // in the morning").
  "enabled": false,
  "on": {
    "schedule": [
      // 01:00, never 02:xx: Paris skips 02:00-02:59 once a year.
      { "cron": "0 1 * * *", "timezone": "Europe/Paris" }
    ]
  },
  // Soft nightly: launch, relaunch and accept the outcome until noon.
  // The next night's occurrence replaces whatever still waits. Keep
  // the window at or under 11h so SCHED_NIGHT matches fleet-update's
  // night key (both are the date of a time minus 12 hours).
  "window": "11h",
  "if": {
    // Defers, never fails, until the launcher is installed.
    "command": ["test", "-x",
      "/run/current-system/sw/bin/fleet-update-start"]
  },
  "outcome": {
    "goal": "Tonight's fleet-update completion receipt says ok",
    "check": { "sh": [
      "r=~/.local/state/fleet-update/completions/$SCHED_NIGHT.json",
      "test -f \"$r\" || exit 1",
      "jq -e '.ok == true' \"$r\" >/dev/null"
    ] },
    // Up to three launches, about an hour apart. fleet-update folds
    // a relaunch into the job it is already running.
    "attempts": 3
  },
  "context": { "previous": 2 },
  "job": {
    "timeout": "30m",
    "prompt": [
      "Launch tonight's fleet update and report on it.",
      "1. Run: fleet-update-start --json. Quote the receipt. A",
      "   launch receipt has ok: false and proves launch only.",
      "2. Run: fleet-update --status --json. Say which stage the",
      "   job is in and which targets are pending, and why.",
      "3. If ~/.local/state/fleet-update/completions/ holds a",
      "   receipt for the previous night, list what it installed",
      "   and what stayed pending.",
      "Do not run nixos-rebuild, switch, reboot, start, stop or",
      "restart a unit, merge a PR, or edit ~/mecattaf/dotfiles:",
      "fleet-update owns those steps. End with one line:",
      "launched, already running, or the error, quoted."
    ]
  }
}
