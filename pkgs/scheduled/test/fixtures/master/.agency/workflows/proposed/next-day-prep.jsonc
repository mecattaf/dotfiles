// ~/.agency/workflows/proposed/next-day-prep.jsonc
// Drafted for Tom's T23 item 8, 10 Nov: "potentially also an
// llm-driven "next day prep" run that reads md files and jsonl chats.
// to be seen later." Never scheduled from proposed/.
// Accept: scheduled accept master:next-day-prep (or the panel).
{
  "name": "Next-day prep (assistant draft for Tom)",
  "enabled": false,
  "x-proposal": {
    "by": "spec wave 2",
    "at": "2026-11-10T23:30:00.000Z",
    "why": [
      "Tom, 10 Nov, T05: start-of-day prep is a master routine.",
      "Tom, 10 Nov, T23 item 8: 'to be seen later'."
    ]
  },
  "on": {
    "schedule": [
      { "cron": "0 5 * * *", "timezone": "Europe/Paris" }
    ]
  },
  // A prep note read after Tom's day has started is noise.
  "window": "3h",
  "outcome": {
    "goal": "Today's day-prep.md exists, headed 'Assistant draft'",
    "check": { "sh": [
      "d=$(printf %s \"$SCHED_LOCAL_DATE\" | tr - /)",
      "f=~/notes/journal/\"$d\"/day-prep.md",
      "test -s \"$f\" || exit 1",
      "head -n 1 \"$f\" | grep -q 'Assistant draft'"
    ] }
  },
  "job": {
    "timeout": "45m",
    "prompt-file": "prompts/next-day-prep.md"
  }
}
