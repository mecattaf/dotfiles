home/dot_config/DankMaterialShell/

# Python bytecode cache (kitty kittens under home/dot_config/kitty)
__pycache__/

# Claude Code writes host-local permission grants beside whichever directory it
# is operating in. They are mutable machine state, not shared configuration.
**/.claude/settings.local.json

# Never commit secret key material / plaintext
*.age.key
*_ed25519
admin-age.key
secrets-staging/
install-files/
plaintext/

# Nix build output symlink
/result
.wrangler/

# cliamp writes its log, control socket and pidfile beside its config, and
# ~/.config/cliamp is an out-of-store symlink straight into this repo — so
# these runtime files land in the working tree on every run.
home/dot_config/cliamp/cliamp.log
home/dot_config/cliamp/cliamp.sock
home/dot_config/cliamp/cliamp.sock.pid
