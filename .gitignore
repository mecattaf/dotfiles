# Claude Code writes host-local permission grants beside whichever directory it
# is operating in. They are mutable machine state, not shared configuration.
**/.claude/settings.local.json

# Claude Code syncs claude.ai skills into ~/.claude/skills/synced/, which is a
# link into this checkout. They are per-account downloads, not dotfiles.
home/dot_claude/skills/synced/

# Never commit secret key material / plaintext
*.age.key
*_ed25519
admin-age.key
secrets-staging/
install-files/
plaintext/

# Nix build output symlink
/result
.wrangler/

